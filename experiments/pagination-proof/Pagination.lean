          ((alloyOrphan inp p && alloyWidow inp p) ==
            !(alloyKeepFirst inp ⟨[],[]⟩ p && alloyKeepLast inp ⟨[],[]⟩ p))) = false := by
        cases e : alloySome inp (fun p => alloyBase inp p &&
            ((alloyOrphan inp p && alloyWidow inp p) ==

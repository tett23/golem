theorem I3_canonical_two_figure_need_break_iff
    (capacity used blank first second firstSize secondSize b : Nat) (items : List SourceItem)
    (ordered : sourceOrdered items) (space : Nat → Bool) (needs : List (Nat × Nat)) :

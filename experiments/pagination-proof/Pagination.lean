            by simp [pos,z]⟩
        · simp [keptAt, keptAtTwoPositions, a, z] at yes)
    load p1
  exact I3_two_figure_need_successor_is_legal capacity used blank first second firstSize secondSize
    b items ordered figOrder space needs valid next.1 next.2

theorem I3_reached_figure_counts_every_earlier_text
    (items : List SourceItem) (b pos : Nat) (space : Nat → Bool)
    (reached : textBeforeCount items pos ≤ b) :
    ((sourceTextPositions items).filter (fun p => decide (p < pos) && textHereAtBreak items b p)).length =
      textBeforeCount items pos ∧
    (sourceTextPositions items).filter (fun p => decide (p < pos) && !space p && textHereAtBreak items b p) =
      (sourceTextPositions items).filter (fun p => decide (p < pos) && !space p) := by
  have allEarlier (p : Nat) (pm : p ∈ sourceTextPositions items) (lt : p < pos) :
      textHereAtBreak items b p = true :=
    decide_eq_true (Nat.lt_of_lt_of_le (I3_source_text_rank_strict_at_member items p pos
      ((I3_source_text_position_member items p).mp pm) lt) reached)
  have text : (sourceTextPositions items).filter (fun p => decide (p < pos) && textHereAtBreak items b p) =
      (sourceTextPositions items).filter (fun p => decide (p < pos)) := by
    apply filter_eq_on_members
    intro p pm
    by_cases lt : p < pos <;> simp [lt, allEarlier, pm]
  constructor
  · rw [text, I3_source_text_before_count]
    rfl
  · apply filter_eq_on_members
    intro p pm
    by_cases lt : p < pos <;> simp [lt, allEarlier, pm]

theorem I3_two_figure_rows_before_member
    (first second f : Nat) (size : Nat → Nat) (kept : Nat → Bool) (order : first < second)
    (bound : f < 2) :
    let pos := fun i : Nat => if i = 0 then first else second
    keptRowsThrough (fun i => kept i && decide (pos i < pos f)) size 2 =
      priorFigureLines (fun i => if kept i then size i else 0) f := by
  intro pos
  by_cases zero : f = 0
  · subst f
    simp [pos, keptRowsThrough, priorFigureLines, show List.range 0 = [] from rfl, Nat.not_lt_of_ge (Nat.le_of_lt order)]
  · have one : f = 1 := by omega
    subst f
    simp [pos, keptRowsThrough, priorFigureLines, show List.range 1 = [0] from rfl, order]

theorem I3_maximal_two_figure_need_keeps_figure
    (capacity used blank first second firstSize secondSize b n f : Nat)
    (items : List SourceItem) (ordered : sourceOrdered items) (figOrder : first < second)
    (diffFirst : blank ≠ first) (diffSecond : blank ≠ second)
    (firstIn : .figure first ∈ items) (secondIn : .figure second ∈ items)
    (positiveFirst : 0 < firstSize) (positiveSecond : 0 < secondSize)
    (space : Nat → Bool) (needs : List (Nat × Nat)) (bound : f < 2)
    (reached : ∀ p, .text p ∈ items → p < n → textHereAtBreak items b p = true)
    (reqIn : ∀ m ∈ needs, .need m.1 ∈ items)
    (written : .need n ∈ items)
    (valid : twoFigureNeedBreak capacity used blank first second firstSize secondSize items space needs b)
    (maximal : b < (sourceTextPositions items).length →
      ¬ twoFigureNeedBreak capacity used blank first second firstSize secondSize items space needs (b+1)) :
    let pos := fun i : Nat => if i = 0 then first else second
    let size := fun i : Nat => if i = 0 then firstSize else secondSize
    let rank := fun i => textBeforeCount items (pos i)
    let plain := fun i => ((sourceTextPositions items).filter
      (fun p => decide (p < pos i) && !space p)).length
    let block := fun p => .text p ∈ items ∧ space p = false
    let top := blankAtTopSource used blank items (fun _ => true) (fun _ => true)
    let charge := fun i => !beforeBlankMask first second blank i && !top
    let room := fun i => @decide (needFigureStatic capacity used rank plain size pos charge block needs i)
      (Classical.propDecidable _)
    let kept := fun c => greedyFigure (fun i => decide (rank i ≤ c)) room
    let group := needs.filter (fun m => @decide (needTargetsFigure m.1 pos block f (figureWaits (kept b)))
      (Classical.propDecidable _))
    needTargetsFigure n pos block f (figureWaits (kept b)) →
    used + ((sourceTextPositions items).filter
      (fun p => decide (p < pos f) && textHereAtBreak items b p)).length +
      keptRowsThrough (fun i => kept b i && decide (pos i < pos f)) size 2 +
      (if blank < pos f ∧ top = false then 1 else 0) + size f ≤ capacity →
    (∀ i, i < 2 → pos i < n → ¬ figureWaits (kept b) i → kept b i = true) →
    writtenGroupFits capacity 0 (placedBeforeNeedSource used 2 b items pos size space (kept b)) group →
    kept b f = true := by
  intro pos size rank plain block top charge room kept group target load prior writtenFit
  have rankReached := I3_maximal_two_figure_need_reaches_figure capacity used blank first second
    firstSize secondSize b n f items ordered figOrder diffFirst diffSecond positiveFirst positiveSecond
    space needs bound reached written valid maximal target load
  have posOrder : ∀ i j, i ≤ j → pos i ≤ pos j := by
    intro i j le
    dsimp [pos]
    split <;> split <;> omega
  have figMember (i : Nat) : .figure (pos i) ∈ items := by
    by_cases z : i = 0 <;> simp [pos,z,firstIn,secondIn]
  have diff (i q : Nat) (node : .need q ∈ items) : pos i ≠ q := by
    intro eq
    cases I3_sourceOrdered_unique_position items ordered _ _ (figMember i) node (by simpa [sourcePos] using eq)
  have roomAt (i : Nat) : room i = true ↔ needFigureStatic capacity used rank plain size pos charge block needs i :=
    @decide_eq_true_iff _ (Classical.propDecidable _)
  have rule : figures27Model 2 capacity used (fun i => decide (rank i ≤ b)) rank plain size pos charge block needs (kept b) := by
    apply figures27_of_static
    intro i hi
    exact (I3_greedyFigures_rule 2 (fun i => decide (rank i ≤ b)) room i hi).trans
      (and_congr_right fun _ => and_congr_right fun _ => roomAt i)
  have allPrior : ∀ i, i < f → ¬ figureWaits (kept b) i → kept b i = true := by
    intro i lt awake
    by_cases early : pos i < n
    · exact prior i (by omega) early awake
    · have distinct := diff i n written
      exact (awake (target.2.2.2 i lt (by omega))).elim
  obtain ⟨allText, plainText⟩ := I3_reached_figure_counts_every_earlier_text items b (pos f) space rankReached
  have figs := I3_two_figure_rows_before_member first second f size (kept b) figOrder bound
  have chargeEq : (if charge f then 1 else 0) = (if blank < pos f ∧ top = false then 1 else 0) := by
    have distinct : blank ≠ pos f := by by_cases z : f = 0 <;> simp [pos,z,diffFirst,diffSecond]
    have maskEq : beforeBlankMask first second blank f = decide (pos f < blank) := by
      by_cases z : f = 0 <;> simp [beforeBlankMask,pos,z] <;> omega
    dsimp only [charge]
    rw [maskEq]
    by_cases earlier : blank < pos f
    · have other : ¬ pos f < blank := by omega
      cases top <;> simp [earlier,other]
    · have other : pos f < blank := by omega
      cases top <;> simp [earlier,other]
  apply I3_target_figure_stays_when_group_fits 2 capacity used f _ rank plain size pos charge block needs
    (kept b) rule bound (decide_eq_true rankReached) allPrior
  · rw [allText, figs] at load
    rwa [chargeEq]
  · apply (I3_written_group_iff_target_max capacity 0 _ _ group ?_).mp writtenFit
    intro m mem
    obtain ⟨original, selected⟩ := List.mem_filter.mp mem
    rw [I3_load_at_figure_need_agrees_with_target used 2 b m.1 f items pos size space (kept b)
      posOrder (by
        intro p mText eq
        cases I3_sourceOrdered_unique_position items ordered _ _ mText (reqIn m original) (by simpa [sourcePos] using eq))
      (fun i => diff i m.1 (reqIn m original)) (@of_decide_eq_true _ (Classical.propDecidable _) selected)]
    unfold placedBeforeNeedSource
    rw [plainText, figs]

theorem I3_append_figure_preserves_earlier_blank
    (items suffix : List SourceItem) (blank : Nat) (waiting here kept : Nat → Bool)
    (top : Bool) :
    blankPlacedFromSource blank waiting items here kept top = true →
      blankPlacedFromSource blank waiting (items ++ suffix) here kept top = true := by
  have next (c : SourceCandidate) (found : nextOfSource blank waiting items = some c) :
      nextOfSource blank waiting (items ++ suffix) = some c := by
    induction items with
    | nil => simp [nextOfSource] at found
    | cons head rest ih =>
      cases cand : candidateAfterBlank blank head with
      | none =>
        simp [nextOfSource, cand] at found ⊢
        exact ih found
      | some v =>
        by_cases sent : candidateWaits waiting v = true
        · simp [nextOfSource, cand, sent] at found ⊢
          exact ih found
        · simpa [nextOfSource, cand, sent] using found
  intro placed
  cases found : nextOfSource blank waiting items with
  | none => simp [blankPlacedFromSource, found] at placed
  | some c =>
    simp only [blankPlacedFromSource, found] at placed
    simpa only [blankPlacedFromSource, next c found] using placed

theorem I3_padding_preserves_text_prefix (items suffix : List SourceItem)
    (onlyFigure : ∀ x ∈ suffix, ∃ p, x = .figure p) :
    sourceTextPositions (items ++ suffix) = sourceTextPositions items ∧
    ∀ p, textBeforeCount (items ++ suffix) p = textBeforeCount items p := by
  have none : sourceTextPositions suffix = [] := by
    induction suffix with
    | nil => rfl
    | cons x xs ih =>
      obtain ⟨p, rfl⟩ := onlyFigure x (by simp)
      exact ih (fun v h => onlyFigure v (by simp [h]))
  have eq : sourceTextPositions (items ++ suffix) = sourceTextPositions items := by
    induction items with
    | nil => exact none
    | cons x xs ih => cases x <;> simp_all [sourceTextPositions]
  exact ⟨eq, fun p => by simp only [I3_source_text_before_count, eq]⟩

def sourceEnd : List SourceItem → Nat
  | [] => 0
  | x :: xs => max (sourcePos x + 1) (sourceEnd xs)

theorem I3_original_positions_before_padding (items : List SourceItem) :
    ∀ x ∈ items, sourcePos x < sourceEnd items := by
  induction items with
  | nil => simp
  | cons h tail ih =>
    intro x mem
    rcases List.mem_cons.mp mem with rfl | old
    · simp [sourceEnd]; omega
    · exact Nat.lt_of_lt_of_le (ih x old) (Nat.le_max_right _ _)

def padNeedFigures (endPos : Nat) : FigureConfig → List SourceItem
  | .zero => [.figure endPos, .figure (endPos+1)]
  | .one _ _ => [.figure endPos]
  | .two _ _ _ _ => []

def paddedNeedConfig (endPos : Nat) : FigureConfig → FigureConfig
  | .zero => .two endPos 1 (endPos+1) 1
  | .one p size => .two p size endPos 1
  | .two p size q other => .two p size q other

private theorem member_of_source_append (xs ys : List SourceItem) (x : SourceItem) :
    x ∈ xs ++ ys ↔ x ∈ xs ∨ x ∈ ys := by
  induction xs with
  | nil => simp
  | cons h rest ih => simp only [List.cons_append, List.mem_cons, ih, or_assoc]

theorem I3_padded_need_input_has_two_figures (items : List SourceItem)
    (config : FigureConfig) (valid : figureDomain items config) :
    figureDomain (items ++ padNeedFigures (sourceEnd items) config)
      (paddedNeedConfig (sourceEnd items) config) := by
  cases config with
  | zero =>
    refine ⟨by omega, by simp [padNeedFigures,member_of_source_append], by simp [padNeedFigures,member_of_source_append], ?_⟩
    intro p member
    simp only [padNeedFigures,member_of_source_append,List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with old | h | h
    · exact (valid p old).elim
    · cases h; exact Or.inl rfl
    · cases h; exact Or.inr rfl
  | one pos size =>
    refine ⟨I3_original_positions_before_padding items (.figure pos) valid.1,
      by simp [padNeedFigures,member_of_source_append,valid.1], by simp [padNeedFigures,member_of_source_append], ?_⟩
    intro p member
    simp only [padNeedFigures,member_of_source_append,List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with old | added
    · exact Or.inl (valid.2 p old)
    · cases added; exact Or.inr rfl
  | two p size q other => simpa [padNeedFigures,paddedNeedConfig] using valid

theorem I3_padding_preserves_source_order (items : List SourceItem) (config : FigureConfig)
    (ordered : sourceOrdered items) :
    sourceOrdered (items ++ padNeedFigures (sourceEnd items) config) := by
  have appendOrdered (xs ys : List SourceItem) (xOrder : sourceOrdered xs) (yOrder : sourceOrdered ys)
      (earlier : ∀ x ∈ xs, ∀ y ∈ ys, sourcePos x < sourcePos y) : sourceOrdered (xs ++ ys) := by
    induction xs with
    | nil => exact yOrder
    | cons head tail ih =>
      refine ⟨?_, ih xOrder.2 (fun x m => earlier x (List.mem_cons_of_mem _ m))⟩
      intro y member
      rcases (member_of_source_append tail ys y).mp member with left | right
      · exact xOrder.1 y left
      · exact earlier head (by simp) y right
  apply appendOrdered _ _ ordered
  · cases config <;> simp [padNeedFigures,sourceOrdered,sourcePos]
  · intro x member y padded
    have bound := I3_original_positions_before_padding items x member
    cases config <;> simp [padNeedFigures] at padded
    · rcases padded with rfl | rfl
      · exact bound
      · exact Nat.lt_trans bound (Nat.lt_succ_self _)
    · subst y; exact bound

theorem I3_padding_keeps_original_figure_data (config : FigureConfig) (endPos i : Nat)
    (actual : i < figureCount config) :
    figurePosAt (paddedNeedConfig endPos config) i = figurePosAt config i ∧
      figureSizeAt (paddedNeedConfig endPos config) i = figureSizeAt config i := by
  cases config with
  | zero => exact (Nat.not_lt_zero _ actual).elim
  | one pos size =>
    have zero : i = 0 := by change i < 1 at actual; omega
    simp [zero,paddedNeedConfig,figurePosAt,figureSizeAt]
  | two _ _ _ _ => exact ⟨rfl,rfl⟩

/-- With no manuscript blank, use a position after all padded items. It
    neither consumes a grid line nor precedes any genuine target. -/
theorem I3_end_blank_has_no_successor (items : List SourceItem) (blank : Nat)
    (pastEnd : sourceEnd items ≤ blank) (waiting : Nat → Bool) :
    nextOfSource blank waiting items = none := by
  induction items with
  | nil => rfl
  | cons x xs ih =>
    have after : sourcePos x ≤ blank :=
      Nat.le_trans (Nat.le_of_lt (I3_original_positions_before_padding _ x (List.mem_cons_self x xs))) pastEnd
    have tail : sourceEnd xs ≤ blank := Nat.le_trans (Nat.le_max_right _ _) pastEnd
    have skip : candidateAfterBlank blank x = none := by
      cases x <;> simp [sourcePos] at after <;> simp [candidateAfterBlank] <;> omega
    simpa only [nextOfSource, skip] using ih tail

theorem I3_missing_blank_never_charged (used : Nat) (items : List SourceItem)
    (waiting here kept : Nat → Bool) :
    blankPlacedFromSourceFull used (sourceEnd items) waiting items here kept = false := by
  simp [blankPlacedFromSourceFull,blankPlacedFromSource,
    I3_end_blank_has_no_successor items _ (Nat.le_refl _) waiting]

theorem I3_padding_never_adds_figure_rows_before_an_original_target
    (items : List SourceItem) (config : FigureConfig) (kept : Nat → Bool) (target : SourceItem)
    (member : target ∈ items) :
    let padded := paddedNeedConfig (sourceEnd items) config
    keptRowsThrough (fun i => kept i && decide (figurePosAt padded i < sourcePos target))
      (figureSizeAt padded) 2 =
    keptRowsThrough (fun i => kept i && decide (figurePosAt config i < sourcePos target))
      (figureSizeAt config) (figureCount config) := by
  intro padded
  have before := I3_original_positions_before_padding items target member
  have outside : ¬ sourceEnd items < sourcePos target := by omega
  have lastOutside : ¬ sourceEnd items + 1 < sourcePos target := by omega
  cases config <;> simp [padded,paddedNeedConfig,figurePosAt,figureSizeAt,figureCount,keptRowsThrough,outside,lastOutside]

theorem I3_padding_bounds_original_figure_load (items : List SourceItem)
    (config : FigureConfig) (kept : Nat → Bool) :
    keptRowsThrough kept (figureSizeAt config) (figureCount config) ≤
      keptRowsThrough kept (figureSizeAt (paddedNeedConfig (sourceEnd items) config)) 2 := by
  cases config <;> simp [paddedNeedConfig,figureSizeAt,figureCount,keptRowsThrough] <;> omega

theorem I3_padding_preserves_placed_load_before_need
    (used b : Nat) (items : List SourceItem) (config : FigureConfig)
    (space kept : Nat → Bool) (target : SourceItem) (member : target ∈ items) :
    let augmented := items ++ padNeedFigures (sourceEnd items) config
    let padded := paddedNeedConfig (sourceEnd items) config
    placedBeforeNeedSource used 2 b augmented (figurePosAt padded) (figureSizeAt padded) space kept
      (sourcePos target) =
    placedBeforeNeedSource used (figureCount config) b items (figurePosAt config) (figureSizeAt config)
      space kept (sourcePos target) := by
  intro augmented padded
  have onlyFigure : ∀ x ∈ padNeedFigures (sourceEnd items) config, ∃ p, x = .figure p := by
    intro x mem
    cases config <;> simp [padNeedFigures] at mem
    · rcases mem with rfl | rfl <;> exact ⟨_,rfl⟩
    · subst x; exact ⟨_,rfl⟩
  obtain ⟨sameText, sameRank⟩ := I3_padding_preserves_text_prefix items _ onlyFigure
  have sameHere : textHereAtBreak augmented b = textHereAtBreak items b := by
    funext p
    simp only [textHereAtBreak, augmented, sameRank]
  unfold placedBeforeNeedSource
  rw [sameHere]
  change sourceTextPositions augmented = sourceTextPositions items at sameText
  rw [sameText, I3_padding_never_adds_figure_rows_before_an_original_target items config kept target member]

private theorem text_mem_padded_source (items : List SourceItem) (config : FigureConfig) (p : Nat) :
    SourceItem.text p ∈ items ++ padNeedFigures (sourceEnd items) config ↔ .text p ∈ items := by
  rw [member_of_source_append]
  cases config <;> simp [padNeedFigures]

theorem I3_padding_preserves_text_target (items : List SourceItem) (config : FigureConfig)
    (n t : Nat) (member : .text t ∈ items) (space kept : Nat → Bool) :
    let augmented := items ++ padNeedFigures (sourceEnd items) config
    let padded := paddedNeedConfig (sourceEnd items) config
    sourceNeedAtTarget n t 2 augmented (figurePosAt padded) space kept ↔
      sourceNeedAtTarget n t (figureCount config) items (figurePosAt config) space kept := by
  intro augmented padded
  have same (p : Nat) : .text p ∈ augmented ↔ .text p ∈ items := text_mem_padded_source items config p
  have noExtra (i : Nat) (bound : i < 2) (earlier : figurePosAt padded i < t) : i < figureCount config := by
    have endAfter : t < sourceEnd items := I3_original_positions_before_padding items (.text t) member
    cases config with
    | zero =>
        by_cases iz : i = 0 <;> simp [padded,paddedNeedConfig,figurePosAt,iz] at earlier <;> omega
    | one _ _ =>
        by_cases iz : i = 0
        · simp [figureCount,iz]
        · simp [padded,paddedNeedConfig,figurePosAt,iz] at earlier; omega
    | two _ _ _ _ => exact bound
  unfold sourceNeedAtTarget needTargetsText
  simp only [same]
  constructor
  · rintro ⟨nt,target,blocks,figures⟩
    refine ⟨nt,target,blocks,?_⟩
    intro i original after before
    have lt : i < 2 := by cases config <;> simp_all [figureCount] <;> omega
    have pos := (I3_padding_keeps_original_figure_data config (sourceEnd items) i original).1
    exact figures i lt (pos.symm ▸ after) (pos.symm ▸ before)
  · rintro ⟨nt,target,blocks,figures⟩
    refine ⟨nt,target,blocks,?_⟩
    intro i bound after before
    have original := noExtra i bound before
    have pos := (I3_padding_keeps_original_figure_data config (sourceEnd items) i original).1
    exact figures i original (pos ▸ after) (pos ▸ before)

theorem I3_padding_preserves_figure_target (items : List SourceItem) (config : FigureConfig)
    (n f : Nat) (bound : f < figureCount config) (space kept : Nat → Bool) :
    let augmented := items ++ padNeedFigures (sourceEnd items) config
    let padded := paddedNeedConfig (sourceEnd items) config
    needTargetsFigure n (figurePosAt padded) (fun p => .text p ∈ augmented ∧ space p = false) f (figureWaits kept) ↔
      needTargetsFigure n (figurePosAt config) (fun p => .text p ∈ items ∧ space p = false) f (figureWaits kept) := by
  intro augmented padded
  have posEq (i : Nat) (hi : i < figureCount config) :
      figurePosAt padded i = figurePosAt config i :=
    (I3_padding_keeps_original_figure_data config (sourceEnd items) i hi).1
  unfold needTargetsFigure
  simp only [augmented,text_mem_padded_source,posEq f bound]
  constructor
  · rintro ⟨before,awake,block,prior⟩
    refine ⟨before,awake,block,?_⟩
    intro g lt after
    apply prior g lt
    simpa only [posEq g (Nat.lt_trans lt bound)] using after
  · rintro ⟨before,awake,block,prior⟩
    refine ⟨before,awake,block,?_⟩
    intro g lt after
    apply prior g lt
    simpa only [posEq g (Nat.lt_trans lt bound)] using after

theorem I3_padding_preserves_text_P1 (used capacity b t : Nat) (items : List SourceItem)
    (config : FigureConfig) (space kept : Nat → Bool) (needs : List (Nat × Nat))
    (member : .text t ∈ items) :
    let padded := paddedNeedConfig (sourceEnd items) config
    needAtPlacedText used capacity 2 (items ++ padNeedFigures (sourceEnd items) config)
      (figurePosAt padded) (figureSizeAt padded) space needs b kept t ↔
    needAtPlacedText used capacity (figureCount config) items (figurePosAt config) (figureSizeAt config)
      space needs b kept t := by
  intro padded
  unfold needAtPlacedText
  have rows := I3_padding_preserves_placed_load_before_need used b items config space kept (.text t) member
  change placedBeforeNeedSource _ _ _ _ _ _ _ _ t = _ at rows
  dsimp only
  rw [rows]
  constructor
  · intro test n m target
    exact test n m ((I3_padding_preserves_text_target items config n.1 t member space kept).mpr target)
  · intro test n m target
    exact test n m ((I3_padding_preserves_text_target items config n.1 t member space kept).mp target)

theorem I3_padding_preserves_figures_at_original_positions (items : List SourceItem)
    (config : FigureConfig) (valid : figureDomain items config) (p : Nat) (member : .figure p ∈ items)
    (kept : Nat → Bool) :
    let padded := paddedNeedConfig (sourceEnd items) config
    figureKeptAtPos padded kept p = figureKeptAtPos config kept p ∧
      figureWaitingAtPos padded kept p = figureWaitingAtPos config kept p := by
  cases config with
  | zero => exact (valid p member).elim
  | one pos size =>
    have eq := valid.2 p member
    subst p
    simp [paddedNeedConfig,figureKeptAtPos,keptAtTwoPositions,figureWaitingAtPos,waitingAtTwoPositions,
      waitingFigureBool,earlierFigureSent]
  | two _ _ _ _ => exact ⟨rfl,rfl⟩

theorem I3_padding_preserves_real_blank_top
    (items : List SourceItem) (config : FigureConfig) (valid : figureDomain items config)
    (used b blank : Nat) (member : .blank blank ∈ items) (kept : Nat → Bool) :
    let augmented := items ++ padNeedFigures (sourceEnd items) config
    let padded := paddedNeedConfig (sourceEnd items) config
    blankAtTopSource used blank augmented (textHereAtBreak augmented b) (figureKeptAtPos padded kept) =
      blankAtTopSource used blank items (textHereAtBreak items b) (figureKeptAtPos config kept) := by
  intro augmented padded
  have onlyFig : ∀ x ∈ padNeedFigures (sourceEnd items) config, ∃ p, x = .figure p := by
    intro x hi
    cases config <;> simp [padNeedFigures] at hi
    · rcases hi with rfl | rfl <;> exact ⟨_,rfl⟩
    · subst x; exact ⟨_,rfl⟩
  have textEq (p : Nat) : textHereAtBreak augmented b p = textHereAtBreak items b p := by
    simp only [textHereAtBreak,augmented,(I3_padding_preserves_text_prefix items _ onlyFig).2]
  have original (x : SourceItem) (xm : x ∈ items) :
      keptBeforeBlank blank (textHereAtBreak augmented b) (figureKeptAtPos padded kept) x =
        keptBeforeBlank blank (textHereAtBreak items b) (figureKeptAtPos config kept) x := by
    cases x with
    | text p => simp [keptBeforeBlank,textEq]
    | figure p => simp [keptBeforeBlank,(I3_padding_preserves_figures_at_original_positions items config valid p xm kept).1,padded]
    | blank p => rfl
    | need p => rfl
  have earlier : blank < sourceEnd items := I3_original_positions_before_padding items _ member
  have added (x : SourceItem) (xm : x ∈ padNeedFigures (sourceEnd items) config) :
      keptBeforeBlank blank (textHereAtBreak augmented b) (figureKeptAtPos padded kept) x = false := by
    cases config <;> simp [padNeedFigures] at xm
    · rcases xm with rfl | rfl <;> simp [keptBeforeBlank,show ¬ sourceEnd items < blank by omega,
        show ¬ sourceEnd items + 1 < blank by omega]
    · subst x; simp [keptBeforeBlank,show ¬ sourceEnd items < blank by omega]
  apply Bool.eq_iff_iff.mpr
  rw [I3_blankAtTopSource_iff_empty_before, I3_blankAtTopSource_iff_empty_before]
  constructor
  · rintro ⟨empty,all⟩
    exact ⟨empty,fun x xm => (original x xm) ▸ all x (List.mem_append_of_mem_left _ xm)⟩
  · rintro ⟨empty,all⟩
    refine ⟨empty,?_⟩
    intro x xm
    rcases (member_of_source_append _ _ _).mp xm with old | new
    · rw [original x old]; exact all x old
    · exact added x new

private theorem blank_placement_congr_on_source (items : List SourceItem) (blank : Nat)
    (w v h t k l : Nat → Bool) (top : Bool)
    (text : ∀ p, .text p ∈ items → h p = t p)
    (fig : ∀ p, .figure p ∈ items → w p = v p ∧ k p = l p) :
    blankPlacedFromSource blank w items h k top = blankPlacedFromSource blank v items t l top := by
  induction items with
  | nil => rfl
  | cons x xs ih =>
    have tail := ih (fun p mem => text p (List.mem_cons_of_mem _ mem))
      (fun p mem => fig p (List.mem_cons_of_mem _ mem))
    cases x with
    | blank p => simpa [blankPlacedFromSource,nextOfSource,candidateAfterBlank] using tail
    | need p => simpa [blankPlacedFromSource,nextOfSource,candidateAfterBlank] using tail
    | text p =>
      by_cases lt : blank < p
      · simp [blankPlacedFromSource,nextOfSource,candidateAfterBlank,lt,candidateWaits,sourceInColumn,text p (by simp)]
      · simpa [blankPlacedFromSource,nextOfSource,candidateAfterBlank,lt] using tail
    | figure p =>
      have eq := fig p (by simp)
      by_cases lt : blank < p
      · cases waits : v p with
        | true => simpa [blankPlacedFromSource,nextOfSource,candidateAfterBlank,lt,candidateWaits,eq.1,waits] using tail
        | false => simp [blankPlacedFromSource,nextOfSource,candidateAfterBlank,lt,candidateWaits,sourceInColumn,eq.1,eq.2,waits]
      · simpa [blankPlacedFromSource,nextOfSource,candidateAfterBlank,lt] using tail

theorem I3_original_blank_load_bounded_by_padded
    (items : List SourceItem) (config : FigureConfig) (valid : figureDomain items config)
    (used b blank : Nat) (member : .blank blank ∈ items) (kept : Nat → Bool) :
    let augmented := items ++ padNeedFigures (sourceEnd items) config
    let padded := paddedNeedConfig (sourceEnd items) config
    blankPlacedFromSourceFull used blank (figureWaitingAtPos config kept) items
        (textHereAtBreak items b) (figureKeptAtPos config kept) = true →
      blankPlacedFromSourceFull used blank (figureWaitingAtPos padded kept) augmented
        (textHereAtBreak augmented b) (figureKeptAtPos padded kept) = true := by
  intro augmented padded
  have onlyFig : ∀ x ∈ padNeedFigures (sourceEnd items) config, ∃ p, x = .figure p := by
    intro x hi
    cases config <;> simp [padNeedFigures] at hi
    · rcases hi with rfl | rfl <;> exact ⟨_,rfl⟩
    · subst x; exact ⟨_,rfl⟩
  have eq := I3_padding_preserves_real_blank_top items config valid used b blank member kept
  unfold blankPlacedFromSourceFull
  rw [eq]
  intro placed
  apply I3_append_figure_preserves_earlier_blank
  apply (blank_placement_congr_on_source items blank (figureWaitingAtPos padded kept)
    (figureWaitingAtPos config kept) (textHereAtBreak augmented b) (textHereAtBreak items b)
    (figureKeptAtPos padded kept) (figureKeptAtPos config kept) _ ?_ ?_).trans placed
  · intro p _
    simp only [textHereAtBreak,augmented,(I3_padding_preserves_text_prefix items _ onlyFig).2]
  · intro p mem
    exact (I3_padding_preserves_figures_at_original_positions items config valid p mem kept).symm

theorem I3_unpad_need_capacity (items : List SourceItem) (config : FigureConfig)
    (valid : figureDomain items config) (blank : Option Nat) (blankOK : blankDomain items blank)
    (used capacity b : Nat) (kept : Nat → Bool) :
    let augmented := items ++ padNeedFigures (sourceEnd items) config
    let padded := paddedNeedConfig (sourceEnd items) config
    let pos := blank.getD (sourceEnd augmented)
    let placed := blankPlacedFromSourceFull used pos (figureWaitingAtPos padded kept) augmented
      (textHereAtBreak augmented b) (figureKeptAtPos padded kept)
    let original := fun p => blankPlacedFromSourceFull used p (figureWaitingAtPos config kept) items
      (textHereAtBreak items b) (figureKeptAtPos config kept)
    used + b + keptRowsThrough kept (figureSizeAt padded) 2 + (if placed then 1 else 0) ≤ capacity →
    used + b + keptRowsThrough kept (figureSizeAt config) (figureCount config) +
      (if blank.elim false original then 1 else 0) ≤ capacity := by
  intro augmented padded pos placed original fit
  have rows := I3_padding_bounds_original_figure_load items config kept
  change keptRowsThrough kept (figureSizeAt config) (figureCount config) ≤ keptRowsThrough kept (figureSizeAt padded) 2 at rows
  cases blank with
  | none =>
    change used + b + keptRowsThrough kept (figureSizeAt config) (figureCount config) + 0 ≤ capacity
    omega
  | some p =>
    change used + b + keptRowsThrough kept (figureSizeAt config) (figureCount config) + (if original p then 1 else 0) ≤ capacity
    cases orig : original p with
    | false => simp; omega
    | true =>
      have paddedBlank : placed = true := I3_original_blank_load_bounded_by_padded items config valid used b p blankOK.1 kept orig
      have upper : used + b + keptRowsThrough kept (figureSizeAt padded) 2 + 1 ≤ capacity := by
        simpa only [paddedBlank, if_true] using fit
      exact Nat.le_trans (Nat.add_le_add_right (Nat.add_le_add_left rows (used+b)) 1) upper

theorem I3_first_content_remains_first_under_padding (items suffix : List SourceItem)
    (item : SourceItem) (first : firstContent items = some item) :
    firstContent (items ++ suffix) = some item := by
  induction items with
  | nil => simp [firstContent] at first
  | cons h tail ih =>
    cases h with
    | text _ | figure _ => simpa [firstContent] using first
    | blank _ | need _ =>
      exact ih (by simpa [firstContent] using first)

theorem I3_unpad_need_first_content (items : List SourceItem) (config : FigureConfig)
    (valid : figureDomain items config) (ordered : sourceOrdered items) (used b : Nat) (kept : Nat → Bool) :
    firstContentNotSent used b (items ++ padNeedFigures (sourceEnd items) config)
        (paddedNeedConfig (sourceEnd items) config) kept →
      firstContentNotSent used b items config kept := by
  intro padded empty item first
  have retained := padded empty item (I3_first_content_remains_first_under_padding items _ item first)
  cases item with
  | text _ | blank _ | need _ => exact retained
  | figure p =>
    change figureKeptAtPos config kept p = true
    rw [← (I3_padding_preserves_figures_at_original_positions items config valid p
      (I3_firstContent_is_earliest items ordered _ first).2.1 kept).1]
    exact retained

theorem I3_original_figure_P27_under_padding (config : FigureConfig)
    (endPos f : Nat) (actual : f < figureCount config) (used cap : Nat)
    (rank plain : Nat → Nat) (charge : Nat → Bool) (block : Nat → Prop) (needs : List (Nat × Nat)) :
    let padded := paddedNeedConfig endPos config
    needFigureStatic cap used (fun i => rank (figurePosAt padded i)) (fun i => plain (figurePosAt padded i))
      (figureSizeAt padded) (figurePosAt padded) (fun i => charge (figurePosAt padded i)) block needs f ↔
    needFigureStatic cap used (fun i => rank (figurePosAt config i)) (fun i => plain (figurePosAt config i))
      (figureSizeAt config) (figurePosAt config) (fun i => charge (figurePosAt config i)) block needs f := by
  intro padded
  cases config with
  | zero => exact (Nat.not_lt_zero _ actual).elim
  | two _ _ _ _ => rfl
  | one p size =>
    have zero : f = 0 := by change f < 1 at actual; omega
    subst f
    simp [padded,paddedNeedConfig,needFigureStatic,figureHasRoom,figurePosAt,figureSizeAt,
      priorFigureLines,show List.range 0 = [] from rfl,needTargetsFigure, Nat.not_lt_zero]

theorem I3_unpad_need_figures_rule (config : FigureConfig) (endPos used cap b : Nat)
    (rank plain : Nat → Nat) (charge : Nat → Bool) (block : Nat → Prop)
    (needs : List (Nat × Nat)) (kept : Nat → Bool) :
    let padded := paddedNeedConfig endPos config
    let rule := fun (cfg : FigureConfig) count =>
      figures27Model count cap used (fun f => decide (rank (figurePosAt cfg f) ≤ b))
        (fun f => rank (figurePosAt cfg f)) (fun f => plain (figurePosAt cfg f))
        (figureSizeAt cfg) (figurePosAt cfg) (fun f => charge (figurePosAt cfg f)) block needs kept
    rule padded 2 → rule config (figureCount config) := by
  intro padded rule full
  apply figures27_of_static
  have static := (I3_figure_static_rule_iff_model 2 cap used _ _ _ _ _ _ block needs kept).mpr full
  intro f actual
  have bound : f < 2 := by cases config <;> simp_all [figureCount] <;> omega
  have original := static f bound
  have posEq := (I3_padding_keeps_original_figure_data config endPos f actual).1
  apply original.trans
  apply and_congr
  · simp only [posEq]
  · exact and_congr_right fun _ => I3_original_figure_P27_under_padding config endPos f actual
      used cap rank plain charge block needs

/-- Data shared by the single- and multiple-need commands. Needs occur
    in manuscript order so the written tests check successive maxima. -/
structure NeedSource where
  items : List SourceItem
  config : FigureConfig
  blank : Option Nat
  capacity : Nat
  used : Nat
  space : Nat → Bool
  needs : List (Nat × Nat)

namespace NeedSource
def here (d : NeedSource) (b : Nat) := textHereAtBreak d.items b
def waiting (d : NeedSource) (kept : Nat → Bool) := figureWaitingAtPos d.config kept
def atPos (d : NeedSource) (kept : Nat → Bool) := figureKeptAtPos d.config kept
def pos (d : NeedSource) := figurePosAt d.config
def size (d : NeedSource) := figureSizeAt d.config
def count (d : NeedSource) := figureCount d.config
def rank (d : NeedSource) (p : Nat) := textBeforeCount d.items p
def plain (d : NeedSource) (p : Nat) := ((sourceTextPositions d.items).filter
  (fun q => decide (q < p) && !d.space q)).length
def block (d : NeedSource) (p : Nat) := .text p ∈ d.items ∧ d.space p = false
def atTop (d : NeedSource) (b : Nat) (kept : Nat → Bool) (p : Nat) :=
  blankAtTopSource d.used p d.items (d.here b) (d.atPos kept)
def charge (d : NeedSource) (b : Nat) (kept : Nat → Bool) (p : Nat) : Bool :=
  d.blank.elim false (fun q => decide (q < p) && !d.atTop b kept q)
def placedBlank (d : NeedSource) (b : Nat) (kept : Nat → Bool) : Bool :=
  d.blank.elim false (fun p => blankPlacedFromSourceFull d.used p (d.waiting kept)
    d.items (d.here b) (d.atPos kept))
def before (d : NeedSource) (b : Nat) (kept : Nat → Bool) (p : Nat) :=
  placedBeforeNeedSource d.used d.count b d.items d.pos d.size d.space kept p
def load (d : NeedSource) (b : Nat) (kept : Nat → Bool) (p : Nat) :=
  d.used + ((sourceTextPositions d.items).filter (fun q => decide (q < p) && d.here b q)).length +
    keptRowsThrough (fun i => kept i && decide (d.pos i < p)) d.size d.count +
    (if d.charge b kept p then 1 else 0)
def textTarget (d : NeedSource) (kept : Nat → Bool) (n p : Nat) :=
  sourceNeedAtTarget n p d.count d.items d.pos d.space kept
def figureTarget (d : NeedSource) (kept : Nat → Bool) (n f : Nat) :=
  needTargetsFigure n d.pos d.block f (figureWaits kept)
def beforeNeed (d : NeedSource) (b n : Nat) : Prop :=
  ∀ p, .text p ∈ d.items → p < n → d.here b p = true
def earlierFigures (d : NeedSource) (kept : Nat → Bool) (n : Nat) : Prop :=
  ∀ f, f < d.count → d.pos f < n → ¬ figureWaits kept f → kept f = true
noncomputable def group (d : NeedSource) (target : Nat → Prop) :=
  d.needs.filter (fun m => @decide (target m.1) (Classical.propDecidable _))
def base (d : NeedSource) (b : Nat) (kept : Nat → Bool) : Prop :=
  b ≤ (sourceTextPositions d.items).length ∧
  d.used + b + keptRowsThrough kept d.size d.count + (if d.placedBlank b kept then 1 else 0) ≤ d.capacity ∧
  figures27Model d.count d.capacity d.used (fun i => decide (d.rank (d.pos i) ≤ b))
    (fun i => d.rank (d.pos i)) (fun i => d.plain (d.pos i)) d.size d.pos
    (fun i => d.charge b kept (d.pos i)) d.block d.needs kept ∧
  firstContentNotSent d.used b d.items d.config kept ∧
  (∀ t, .text t ∈ d.items → d.here b t = true →
    needAtPlacedText d.used d.capacity d.count d.items d.pos d.size d.space d.needs b kept t)
def keeps (d : NeedSource) (b : Nat) (kept : Nat → Bool) : Prop :=
  (∀ n ∈ d.needs, ∀ t firstPart, .text t ∈ d.items → 0 < firstPart →
    d.textTarget kept n.1 t → d.beforeNeed b n.1 →
    d.load b kept t + firstPart ≤ d.capacity →
    writtenGroupFits d.capacity 0 (d.before b kept) (d.group (fun m => d.textTarget kept m t)) →
    d.here b t = true) ∧
  (∀ n ∈ d.needs, ∀ f, f < d.count → d.figureTarget kept n.1 f → d.beforeNeed b n.1 →
    d.earlierFigures kept n.1 → d.load b kept (d.pos f) + d.size f ≤ d.capacity →
    writtenGroupFits d.capacity 0 (d.before b kept) (d.group (fun m => d.figureTarget kept m f)) →
    kept f = true)
def augment (d : NeedSource) : NeedSource :=
  let items := d.items ++ padNeedFigures (sourceEnd d.items) d.config
  { d with
    items := items
    config := paddedNeedConfig (sourceEnd d.items) d.config
    blank := some (d.blank.getD (sourceEnd items)) }

theorem augmented_count (d : NeedSource) : d.augment.count = 2 := by
  unfold count augment
  cases d.config <;> rfl

theorem augmented_text (d : NeedSource) :
    sourceTextPositions d.augment.items = sourceTextPositions d.items ∧
      ∀ p, d.augment.rank p = d.rank p := by
  apply I3_padding_preserves_text_prefix
  intro x hi
  cases hc : d.config <;> simp [hc,padNeedFigures] at hi
  · rcases hi with rfl | rfl <;> exact ⟨_,rfl⟩
  · subst x; exact ⟨_,rfl⟩

theorem augmented_here (d : NeedSource) (b p : Nat) : d.augment.here b p = d.here b p := by
  change decide (d.augment.rank p < b) = decide (d.rank p < b)
  rw [d.augmented_text.2]

theorem augmented_before (d : NeedSource) (b : Nat) (kept : Nat → Bool) (item : SourceItem)
    (mem : item ∈ d.items) : d.augment.before b kept (sourcePos item) = d.before b kept (sourcePos item) := by
  unfold before
  rw [augmented_count]
  exact I3_padding_preserves_placed_load_before_need d.used b d.items d.config d.space kept item mem

theorem augmented_charge (d : NeedSource) (valid : figureDomain d.items d.config)
    (blankOK : blankDomain d.items d.blank) (b : Nat) (kept : Nat → Bool) (item : SourceItem)
    (member : item ∈ d.items) :
    d.augment.charge b kept (sourcePos item) = d.charge b kept (sourcePos item) := by
  unfold charge
  cases hb : d.blank with
  | none =>
      have original := List.mem_append_of_mem_left (padNeedFigures (sourceEnd d.items) d.config) member
      have last : sourcePos item < sourceEnd d.augment.items := I3_original_positions_before_padding _ _ original
      have skip : ¬ sourceEnd d.augment.items < sourcePos item := by omega
      simp only [augment,hb,Option.getD,Option.elim] at skip ⊢
      simp [skip]
  | some blank =>
      rw [hb] at blankOK
      have eq := I3_padding_preserves_real_blank_top d.items d.config valid d.used b blank blankOK.1 kept
      change (decide (d.blank.getD _ < sourcePos item) && !d.augment.atTop b kept (d.blank.getD _)) =
        (decide (blank < sourcePos item) && !d.atTop b kept blank)
      simp only [hb,Option.getD]
      rw [show d.augment.atTop b kept blank = d.atTop b kept blank from eq]

theorem augmented_load (d : NeedSource) (valid : figureDomain d.items d.config)
    (blankOK : blankDomain d.items d.blank) (b : Nat) (kept : Nat → Bool) (item : SourceItem)
    (mem : item ∈ d.items) : d.augment.load b kept (sourcePos item) = d.load b kept (sourcePos item) := by
  unfold load
  simp only [augmented_text, augmented_here, augmented_count, augmented_charge d valid blankOK b kept item mem]
  rw [show keptRowsThrough (fun i => kept i && decide (d.augment.pos i < sourcePos item)) d.augment.size 2 =
    keptRowsThrough (fun i => kept i && decide (d.pos i < sourcePos item)) d.size d.count from
    I3_padding_never_adds_figure_rows_before_an_original_target d.items d.config kept item mem]
  rfl

theorem original_fig_member (d : NeedSource) (valid : figureDomain d.items d.config)
    (f : Nat) (bound : f < d.count) : .figure (d.pos f) ∈ d.items := by
  cases h : d.config with
  | zero => simp [count,h,figureCount] at bound; omega
  | one _ _ =>
      rw [h] at valid
      simpa [pos,h,figurePosAt] using valid.1
  | two p s q z =>
      rw [h] at valid
      by_cases first : f = 0 <;> simp [pos,h,figurePosAt,first,valid.2.1,valid.2.2.1]

theorem augmented_text_target (d : NeedSource) (kept : Nat → Bool) (n t : Nat)
    (mem : .text t ∈ d.items) : d.augment.textTarget kept n t ↔ d.textTarget kept n t := by
  unfold textTarget
  rw [augmented_count]
  exact I3_padding_preserves_text_target d.items d.config n t mem d.space kept

theorem augmented_figure_target (d : NeedSource) (kept : Nat → Bool) (n f : Nat)
    (bound : f < d.count) : d.augment.figureTarget kept n f ↔ d.figureTarget kept n f :=
  I3_padding_preserves_figure_target d.items d.config n f bound d.space kept

theorem augmented_earlier_figures (d : NeedSource) (kept : Nat → Bool) (n : Nat)
    (member : .need n ∈ d.items) (before : d.earlierFigures kept n) : d.augment.earlierFigures kept n := by
  intro f bound lt awake
  have endAfter : n < sourceEnd d.items := I3_original_positions_before_padding _ _ member
  have actual : f < d.count := by
    rw [augmented_count] at bound
    cases hc : d.config with
    | zero => by_cases z : f = 0 <;> simp [pos,augment,hc,paddedNeedConfig,figurePosAt,z] at lt <;> omega
    | one _ _ =>
        by_cases z : f = 0
        · simp [count,hc,figureCount,z]
        · simp [pos,augment,hc,paddedNeedConfig,figurePosAt,z] at lt; omega
    | two _ _ _ _ => simpa [count,hc,figureCount] using bound
  have eq : d.augment.pos f = d.pos f := (I3_padding_keeps_original_figure_data d.config _ f actual).1
  exact before f actual (eq ▸ lt) awake

theorem augmented_group_fits (d : NeedSource) (b : Nat) (kept : Nat → Bool) (a z : Nat → Prop)
    (same : ∀ p, a p ↔ z p) (members : ∀ m ∈ d.needs, .need m.1 ∈ d.items) :
    writtenGroupFits d.capacity 0 (d.before b kept) (d.group a) →
      writtenGroupFits d.augment.capacity 0 (d.augment.before b kept) (d.augment.group z) := by
  have groupEq : d.augment.group z = d.group a := by
    apply filter_eq_on_members
    intro m _
    apply Bool.eq_iff_iff.mpr
    simp only [decide_eq_true_eq]
    exact (same m.1).symm
  rw [groupEq]
  have gen (ms : List (Nat × Nat)) (prev : Nat) (inside : ∀ m ∈ ms, .need m.1 ∈ d.items) :
      writtenGroupFits d.capacity prev (d.before b kept) ms →
        writtenGroupFits d.augment.capacity prev (d.augment.before b kept) ms := by
    induction ms generalizing prev with
    | nil => exact id
    | cons m rest ih =>
        have eq := augmented_before d b kept (.need m.1) (inside m (by simp))
        change d.augment.before b kept m.1 = d.before b kept m.1 at eq
        simp only [writtenGroupFits,eq]
        intro old
        exact ⟨old.1,ih _ (fun n h => inside n (List.mem_cons_of_mem _ h)) old.2⟩
  exact gen _ _ (fun m member => members m (List.mem_filter.mp member).1)

theorem unpad_keeps (d : NeedSource) (valid : figureDomain d.items d.config)
    (blankOK : blankDomain d.items d.blank) (members : ∀ m ∈ d.needs, .need m.1 ∈ d.items)
    (b : Nat) (kept : Nat → Bool) (padded : d.augment.keeps b kept) : d.keeps b kept := by
  have earlier (n : Nat) (h : d.beforeNeed b n) : d.augment.beforeNeed b n := by
    intro p pm lt
    rw [augmented_here]
    exact h p ((text_mem_padded_source d.items d.config p).mp pm) lt
  constructor
  · intro n mem t part tm positive target reached loadFits groupFits
    rw [← augmented_here]
    apply padded.1 n mem t part ((text_mem_padded_source d.items d.config t).mpr tm) positive
      ((d.augmented_text_target kept n.1 t tm).mpr target) (earlier _ reached)
    · have eq := d.augmented_load valid blankOK b kept (.text t) tm
      change d.augment.load b kept t = d.load b kept t at eq
      rw [eq]; exact loadFits
    · exact d.augmented_group_fits b kept _ _ (fun m => (d.augmented_text_target kept m t tm).symm)
        members groupFits
  · intro n mem f bound target reached prior loadFits groupFits
    have fig := d.original_fig_member valid f bound
    have data := I3_padding_keeps_original_figure_data d.config (sourceEnd d.items) f bound
    have posEq : d.augment.pos f = d.pos f := data.1
    have sizeEq : d.augment.size f = d.size f := data.2
    have within : f < d.augment.count := by
      rw [augmented_count]
      cases h : d.config <;> simp [count,h,figureCount] at bound <;> omega
    apply padded.2 n mem f within ((d.augmented_figure_target kept n.1 f bound).mpr target)
      (earlier _ reached) (d.augmented_earlier_figures kept n.1 (members n mem) prior)
    · have eq := d.augmented_load valid blankOK b kept (.figure (d.pos f)) fig
      change d.augment.load b kept (d.pos f) = d.load b kept (d.pos f) at eq
      rw [posEq,sizeEq,eq]; exact loadFits
    · exact d.augmented_group_fits b kept _ _ (fun m => (d.augmented_figure_target kept m f bound).symm)
        members groupFits

theorem unpad_base (d : NeedSource) (ordered : sourceOrdered d.items)
    (valid : figureDomain d.items d.config) (blankOK : blankDomain d.items d.blank)
    (b : Nat) (kept : Nat → Bool) (padded : d.augment.base b kept) : d.base b kept := by
  obtain ⟨range,cap,rule,first,p1⟩ := padded
  refine ⟨by simpa only [d.augmented_text.1] using range, ?_, ?_, ?_, ?_⟩
  · apply I3_unpad_need_capacity d.items d.config valid d.blank blankOK d.used d.capacity b kept
    simp only [augmented_count] at cap
    exact cap
  · have old := I3_unpad_need_figures_rule d.config (sourceEnd d.items) d.used d.capacity b
      d.augment.rank d.augment.plain (d.augment.charge b kept) d.augment.block d.needs kept
    have all := old (by rw [augmented_count] at rule; exact rule)
    intro f actual
    have fig := d.original_fig_member valid f actual
    have ch := d.augmented_charge valid blankOK b kept (.figure (d.pos f)) fig
    change d.augment.charge b kept (d.pos f) = d.charge b kept (d.pos f) at ch
    have plains (q : Nat) : d.augment.plain q = d.plain q := by
      simp only [plain,d.augmented_text.1]; rfl
    have blocks : d.augment.block = d.block := by
      funext q
      apply propext
      exact and_congr (text_mem_padded_source d.items d.config q) Iff.rfl
    change d.augment.charge b kept (figurePosAt d.config f) = d.charge b kept (figurePosAt d.config f) at ch
    have one := all f actual
    simpa only [figureHasRoom, d.augmented_text.2, plains, blocks, ch] using one
  · exact I3_unpad_need_first_content d.items d.config valid ordered d.used b kept first
  · intro t tm here
    apply (I3_padding_preserves_text_P1 d.used d.capacity b t d.items d.config d.space kept d.needs tm).mp
    have paddedP1 := p1 t ((text_mem_padded_source d.items d.config t).mpr tm) (by rwa [augmented_here])
    rw [augmented_count] at paddedP1
    exact paddedP1

theorem two_figure_solution (d : NeedSource) (a sa z sz q : Nat)
    (cfg : d.config = .two a sa z sz) (bl : d.blank = some q)
    (ordered : sourceOrdered d.items) (figValid : figureDomain d.items d.config)
    (capacityPos : 0 < d.capacity) (usedFits : d.used ≤ d.capacity)
    (aPos : 0 < sa) (zPos : 0 < sz) (aFits : sa ≤ d.capacity)
    (qa : q ≠ a) (qz : q ≠ z) (members : ∀ m ∈ d.needs, .need m.1 ∈ d.items) :
    ∃ b kept, d.base b kept ∧ d.keeps b kept := by
  rw [cfg] at figValid
  obtain ⟨az, aIn, zIn, two⟩ := figValid
  obtain ⟨b, bound, good, stop⟩ := I3_two_figure_need_maximal_placement d.capacity d.used q a z sa sz
    d.items ordered d.space d.needs capacityPos usedFits aPos zPos aFits az qa qz aIn zIn two
  let pos := fun i : Nat => if i = 0 then a else z
  let size := fun i : Nat => if i = 0 then sa else sz
  let top := blankAtTopSource d.used q d.items (fun _ => true) (fun _ => true)
  let mask := fun i => !beforeBlankMask a z q i && !top
  let room := fun i => @decide (needFigureStatic d.capacity d.used (fun i => d.rank (pos i))
    (fun i => d.plain (pos i)) size pos mask d.block d.needs i) (Classical.propDecidable _)
  let kept := greedyFigure (fun i => decide (d.rank (pos i) ≤ b)) room
  obtain ⟨fit,p1,firstText,firstFig⟩ := I3_normalize_two_figure_need_break d.capacity d.used q a z sa sz b
    d.items ordered d.space d.needs good
  have canonicalTop : d.atTop b kept q = top := by
    unfold atTop atPos here
    rw [cfg]
    exact I3_two_figure_need_blank_charge_unique d.used q a z b d.items ordered kept firstText firstFig
  have chargeEq (p : Nat) : d.charge b kept p = (decide (q < p) && !top) := by
    unfold charge
    rw [bl]
    exact congrArg (fun t => decide (q < p) && !t) canonicalTop
  have maskEq (i : Nat) (within : i < 2) : mask i = d.charge b kept (pos i) := by
    rw [chargeEq]
    by_cases zero : i = 0
    · subst i; dsimp [mask,beforeBlankMask,pos]
      by_cases earlier : a < q <;> simp [earlier,show (q < a) ↔ ¬ a < q by omega]
    · have one : i = 1 := by omega
      subst i; dsimp [mask,beforeBlankMask,pos]
      by_cases earlier : z < q <;> simp [earlier,show (q < z) ↔ ¬ z < q by omega]
  have eqPos : d.pos = pos := by unfold NeedSource.pos; rw [cfg]; rfl
  have eqSize : d.size = size := by unfold NeedSource.size; rw [cfg]; rfl
  have eqCount : d.count = 2 := by unfold count; rw [cfg]; rfl
  have loadEq (p : Nat) :
      d.load b kept p = d.used + ((sourceTextPositions d.items).filter (fun v => decide (v < p) && d.here b v)).length +
        keptRowsThrough (fun i => kept i && decide (pos i < p)) size 2 + (if q < p ∧ top = false then 1 else 0) := by
    unfold load
    rw [eqCount,eqSize,eqPos,chargeEq]
    by_cases lt : q < p <;> cases top <;> simp [lt]
  refine ⟨b,kept,⟨bound,?_,?_,?_,?_⟩,?_,?_⟩
  · simpa only [eqSize,eqCount,placedBlank,bl,waiting,atPos,cfg,Option.elim,figureWaitingAtPos,
      figureKeptAtPos,here] using fit
  · rw [eqCount,eqPos,eqSize]
    apply figures27_of_static
    intro i hi
    have static := I3_greedyFigures_rule 2 (fun i => decide (d.rank (pos i) ≤ b)) room i hi
    have check : room i = true ↔ needFigureStatic d.capacity d.used (fun i => d.rank (pos i))
      (fun i => d.plain (pos i)) size pos mask d.block d.needs i := @decide_eq_true_iff _ (Classical.propDecidable _)
    apply static.trans
    apply and_congr_right; intro _
    apply and_congr_right; intro _
    apply check.trans
    simp only [needFigureStatic,figureHasRoom,maskEq i hi]
  · intro empty item first
    cases item with
    | text p => exact firstText empty p first
    | figure p => simpa [cfg,figureKeptAtPos] using firstFig empty p first
    | blank _ | need _ => exact (I3_firstContent_is_earliest d.items ordered _ first).1
  · intro t tm here
    rw [eqCount,eqPos,eqSize]
    exact p1 t tm here
  · intro n mem t part tm positive target reached fits records
    apply I3_maximal_two_figure_need_keeps_text d.capacity d.used q a z sa sz b n.1 t part
      d.items ordered az qa qz aPos zPos aIn zIn positive d.space d.needs members tm reached
      (members n mem) good stop
    · simpa only [textTarget,eqCount,eqPos] using target
    · rw [loadEq] at fits; exact fits
    · unfold group textTarget before at records
      rw [eqCount,eqPos,eqSize] at records
      exact records
  · intro n mem f within target reached prior fits records
    rw [eqCount] at within
    apply I3_maximal_two_figure_need_keeps_figure d.capacity d.used q a z sa sz b n.1 f
      d.items ordered az qa qz aIn zIn aPos zPos d.space d.needs within reached members
      (members n mem) good stop
    · simpa only [figureTarget,eqPos] using target
    · rw [loadEq,eqSize,eqPos] at fits; exact fits
    · simpa only [earlierFigures,eqCount,eqPos] using prior
    · unfold group figureTarget before at records
      rw [eqCount,eqPos,eqSize] at records
      exact records

theorem all_inputs_have_a_placement (d : NeedSource) (ordered : sourceOrdered d.items)
    (valid : figureDomain d.items d.config) (blankOK : blankDomain d.items d.blank)
    (capacityPos : 0 < d.capacity) (usedFits : d.used ≤ d.capacity)
    (sizes : ∀ i, i < d.count → 0 < d.size i ∧ d.size i ≤ d.capacity)
    (members : ∀ m ∈ d.needs, .need m.1 ∈ d.items) :
    ∃ b kept, d.base b kept ∧ d.keeps b kept := by
  have augOrder := I3_padding_preserves_source_order d.items d.config ordered
  have augValid := I3_padded_need_input_has_two_figures d.items d.config valid
  have two : ∃ a sa z sz, d.augment.config = .two a sa z sz := by
    cases h : d.config <;> simp [augment,h,paddedNeedConfig]
  obtain ⟨a,sa,z,sz,cfg⟩ := two
  have augSizes (i : Nat) (hi : i < 2) : 0 < d.augment.size i ∧ d.augment.size i ≤ d.capacity := by
    by_cases actual : i < d.count
    · have same := (I3_padding_keeps_original_figure_data d.config (sourceEnd d.items) i actual).2
      change d.augment.size i = d.size i at same
      rw [same]
      exact sizes i actual
    · cases h : d.config with
      | zero => by_cases z : i = 0 <;> simp [size,augment,h,paddedNeedConfig,figureSizeAt,z] <;> omega
      | one p s =>
          have nz : i ≠ 0 := by simp [count,h,figureCount] at actual; omega
          simp [size,augment,h,paddedNeedConfig,figureSizeAt,nz]; omega
      | two p s q v => simp [count,h,figureCount] at actual; omega
  have saOK := augSizes 0 (by decide)
  have szOK := augSizes 1 (by decide)
  simp only [size,cfg,figureSizeAt,if_pos rfl,show ¬ 1 = 0 by decide,if_false] at saOK szOK
  let q := d.blank.getD (sourceEnd d.augment.items)
  have blankIs : d.augment.blank = some q := rfl
  have distinct (p : Nat) (fig : .figure p ∈ d.augment.items) : q ≠ p := by
    cases h : d.blank with
    | none =>
      have lt : p < sourceEnd d.augment.items := I3_original_positions_before_padding _ _ fig
      simp [q,h]; omega
    | some blank =>
      rw [h] at blankOK
      have actual : .blank blank ∈ d.augment.items := List.mem_append_of_mem_left _ blankOK.1
      intro eq
      have bad := I3_sourceOrdered_unique_position _ augOrder _ _ actual fig
        (by simpa [q,h,sourcePos] using eq)
      cases bad
  have figs : figureDomain d.augment.items d.augment.config := augValid
  rw [cfg] at figs
  obtain ⟨b,kept,base,keeps⟩ := two_figure_solution d.augment a sa z sz q cfg blankIs augOrder augValid
    capacityPos usedFits saOK.1 szOK.1 saOK.2 (distinct a figs.2.1) (distinct z figs.2.2.1)
    (fun m hm => List.mem_append_of_mem_left _ (members m hm))
  exact ⟨b,kept,d.unpad_base ordered valid blankOK b kept base,d.unpad_keeps valid blankOK members b kept keeps⟩

/-- The original Alloy antecedents use a set of preceding needs at
    the same target. The list of needs is stored in source order. -/
def sourceKeeps (d : NeedSource) (b : Nat) (kept : Nat → Bool)
    (written : (Nat × Nat) → (Nat → Prop) → Prop) : Prop :=
  (∀ n ∈ d.needs, ∀ t firstPart, .text t ∈ d.items → 0 < firstPart →
    d.textTarget kept n.1 t → d.beforeNeed b n.1 → d.earlierFigures kept n.1 →
    d.load b kept t + firstPart ≤ d.capacity → written n (fun m => d.textTarget kept m t) →
    d.here b t = true) ∧
  (∀ n ∈ d.needs, ∀ f, f < d.count → d.figureTarget kept n.1 f → d.beforeNeed b n.1 →
    d.earlierFigures kept n.1 → d.load b kept (d.pos f) + d.size f ≤ d.capacity →
    written n (fun m => d.figureTarget kept m f) → kept f = true)

theorem source_keeps_of_written (d : NeedSource) (b : Nat) (kept : Nat → Bool)
    (generic : d.keeps b kept) (written : (Nat × Nat) → (Nat → Prop) → Prop)
    (fits : ∀ n ∈ d.needs, ∀ target : Nat → Prop, target n.1 → written n target →
      writtenGroupFits d.capacity 0 (d.before b kept) (d.group target)) :
    d.sourceKeeps b kept written := by
  constructor
  · intro n mem t part tm positive target reached _ load met
    exact generic.1 n mem t part tm positive target reached load (fits n mem _ target met)
  · intro n mem f bound target reached earlier load met
    exact generic.2 n mem f bound target reached earlier load (fits n mem _ target met)

def singleWritten (d : NeedSource) (b : Nat) (kept : Nat → Bool)
    (n : Nat × Nat) (_ : Nat → Prop) := n.2 ≤ d.capacity - d.before b kept n.1

def recordWritten (d : NeedSource) (b : Nat) (kept : Nat → Bool)
    (_ : Nat × Nat) (target : Nat → Prop) := ∀ m ∈ d.needs, target m.1 →
      (∀ k ∈ d.needs, target k.1 → k.1 < m.1 → k.2 < m.2) →
      m.2 ≤ d.capacity - d.before b kept m.1

theorem I3_needSpaceNone (d : NeedSource) (ordered : sourceOrdered d.items)
    (valid : figureDomain d.items d.config) (blankOK : blankDomain d.items d.blank)
    (capacityPos : 0 < d.capacity) (usedFits : d.used ≤ d.capacity)
    (sizes : ∀ i, i < d.count → 0 < d.size i ∧ d.size i ≤ d.capacity)
    (members : ∀ m ∈ d.needs, .need m.1 ∈ d.items)
    (domain : d.needs = [] ∨ ∃ p, d.needs = [(p,2)]) :
    ∃ b kept, d.base b kept ∧ d.sourceKeeps b kept (d.singleWritten b kept) := by
  obtain ⟨b,kept,base,generic⟩ := d.all_inputs_have_a_placement ordered valid blankOK capacityPos
    usedFits sizes members
  refine ⟨b,kept,base,d.source_keeps_of_written b kept generic _ ?_⟩
  intro n mem target hit met
  rcases domain with none | ⟨p,one⟩
  · simp [none] at mem
  · simp [one] at mem
    subst n
    simpa [group,one,hit,writtenGroupFits,singleWritten] using met

theorem I3_needMoreNone (d : NeedSource) (ordered : sourceOrdered d.items)
    (valid : figureDomain d.items d.config) (blankOK : blankDomain d.items d.blank)
    (capacityPos : 0 < d.capacity) (usedFits : d.used ≤ d.capacity)
    (sizes : ∀ i, i < d.count → 0 < d.size i ∧ d.size i ≤ d.capacity)
    (members : ∀ m ∈ d.needs, .need m.1 ∈ d.items)
    (domain : ∃ a z : Nat × Nat, d.needs = [a,z] ∧ a.1 < z.1) :
    ∃ b kept, d.base b kept ∧ d.sourceKeeps b kept (d.recordWritten b kept) := by
  obtain ⟨b,kept,base,generic⟩ := d.all_inputs_have_a_placement ordered valid blankOK capacityPos
    usedFits sizes members
  refine ⟨b,kept,base,d.source_keeps_of_written b kept generic _ ?_⟩
  intro n _ target _ met
  obtain ⟨a,z,two,lt⟩ := domain
  have aFit (hit : target a.1) : a.2 ≤ d.capacity - d.before b kept a.1 := by
    apply met a (by simp [two]) hit
    intro k km _ early
    simp [two] at km
    rcases km with rfl | rfl <;> omega
  have zFit (hit : target z.1) (earlier : target a.1 → a.2 < z.2) :
      z.2 ≤ d.capacity - d.before b kept z.1 := by
    apply met z (by simp [two]) hit
    intro k km atK early
    simp [two] at km
    rcases km with rfl | rfl
    · exact earlier atK
    · omega
  rcases a with ⟨pa, ha⟩
  rcases z with ⟨pz, hz⟩
  by_cases ta : target pa <;> by_cases tz : target pz <;>
    simp [group,two,ta,tz,writtenGroupFits] at * <;> omega

end NeedSource

namespace GreedyFigureCommand

/-- For the domain with at most one figure, reserve its rows precisely
    when the source prefix and the figure itself fit. Fill the rest with
    the longest text prefix. The skipped figure, if present, is too
    large at its source position regardless of the final break. -/
theorem I3_greedyFigure (capacity used textCount : Nat) (usedFits : used ≤ capacity)
    (figure : Option (Nat × Nat))
    (rankBound : ∀ r h, figure = some (r,h) → r ≤ textCount) :
    ∃ b : Nat, ∃ kept : Bool,
      b ≤ textCount ∧
      (match figure with
      | none => kept = false
      | some (rank,height) => kept = decide (rank ≤ b ∧ used + rank + height ≤ capacity)) ∧
      (let load := used + b + (if kept then figure.elim 0 Prod.snd else 0)
       load ≤ capacity ∧ (b = textCount ∨ capacity < load + 1)) := by
  cases figure with
  | none =>
    refine ⟨min textCount (capacity-used),false, Nat.min_le_left _ _,rfl,?_⟩
    change used + min textCount (capacity-used) + 0 ≤ capacity ∧
      (min textCount (capacity-used) = textCount ∨ capacity < used + min textCount (capacity-used) + 0 + 1)
    omega
  | some data =>
    obtain ⟨rank,height⟩ := data
    have bounded := rankBound rank height rfl
    by_cases room : used + rank + height ≤ capacity
    · let b := min textCount (capacity-used-height)
      have ready : rank ≤ b := by dsimp [b]; omega
      refine ⟨b,true,Nat.min_le_left _ _,by simp [ready,room],?_⟩
      change used + b + height ≤ capacity ∧ (b = textCount ∨ capacity < used + b + height + 1)
      dsimp [b]; omega
    · let b := min textCount (capacity-used)
      refine ⟨b,false,Nat.min_le_left _ _,by simp [room],?_⟩
      change used + b + 0 ≤ capacity ∧ (b = textCount ∨ capacity < used + b + 0 + 1)
      dsimp [b]; omega

theorem figure_text_ready_iff (items : List SourceItem) (ordered : sourceOrdered items)
    (b p : Nat) : textBeforeCount items p ≤ b ↔
      ∀ t, .text t ∈ items → t < p → textHereAtBreak items b t = true := by
  constructor
  · intro ready t member before
    exact decide_eq_true (Nat.lt_of_lt_of_le (I3_source_text_rank_strict_at_member items t p member before) ready)
  · intro all
    apply Nat.le_of_not_gt
    intro beyond
    have count := I3_load_before_unreached_position items ordered b p (Nat.le_of_lt beyond)
    have eq : (sourceTextPositions items).filter (fun t => decide (t < p) && textHereAtBreak items b t) =
        (sourceTextPositions items).filter (fun t => decide (t < p)) := by
      apply filter_eq_on_members
      intro t member
      by_cases before : t < p
      · simp [before,all t ((I3_source_text_position_member items t).mp member) before]
      · simp [before]
    rw [eq] at count
    rw [I3_source_text_before_count] at beyond
    unfold countEarlierText at beyond
    omega

theorem greedyFigure_from_manuscript (capacity used : Nat) (usedFits : used ≤ capacity)
    (items : List SourceItem) (ordered : sourceOrdered items) (p h : Nat) :
    ∃ b : Nat, ∃ kept : Bool, b ≤ (sourceTextPositions items).length ∧
      (kept = true ↔ (∀ t, .text t ∈ items → t < p → textHereAtBreak items b t = true) ∧
        used + textBeforeCount items p + h ≤ capacity) ∧
      used + b + (if kept then h else 0) ≤ capacity ∧
      (b = (sourceTextPositions items).length ∨ capacity < used + b + (if kept then h else 0) + 1) := by
  have rankBound : textBeforeCount items p ≤ (sourceTextPositions items).length := by
    apply Nat.le_of_not_gt
    intro tooBig
    have contradiction := I3_missed_source_has_another_text items (sourceTextPositions items).length p tooBig
    omega
  obtain ⟨b,kept,bound,rule,fit,fill⟩ := I3_greedyFigure capacity used (sourceTextPositions items).length usedFits
    (some (textBeforeCount items p,h)) (by intro r z eq; cases eq; exact rankBound)
  refine ⟨b,kept,bound,?_,fit,fill⟩
  change kept = decide (_ ∧ _) at rule
  rw [rule, decide_eq_true_eq, figure_text_ready_iff items ordered b p]

end GreedyFigureCommand

/- The two-need input judges the larger requirement; both P1 checks are
   satisfied when a line is retained. The preceding space affects fit,
   but neither requirement's remaining-line count. -/
theorem I3_need_space_two_needs_simple_exists
    (capacity used firstNeed secondNeed : Nat)
    (usedFits : used ≤ capacity)
    (firstPositive : 1 ≤ firstNeed) :
    ∃ brk : Fin 3,
      needSpaceSimpleBase capacity used brk ∧
      (brk.val = 2 →
        firstNeed ≤ capacity - used ∧
        secondNeed ≤ capacity - used) ∧
      ((firstNeed ≤ capacity - used ∧
        secondNeed ≤ capacity - used) ∧
        used + (if 1 ≤ brk.val then 1 else 0) + 1 ≤ capacity →
        brk.val = 2) := by
  have maxPositive : 1 ≤ max firstNeed secondNeed :=
    Nat.le_trans firstPositive (Nat.le_max_left _ _)
  obtain ⟨brk, base, met, keeps⟩ :=
    I3_need_space_one_block_exists capacity used
      (max firstNeed secondNeed) usedFits maxPositive
  refine ⟨brk, base, ?_, ?_⟩
  · intro placed
    have enough := met placed
    exact ⟨Nat.le_trans (Nat.le_max_left _ _) enough,
      Nat.le_trans (Nat.le_max_right _ _) enough⟩
  · rintro ⟨⟨firstEnough, secondEnough⟩, fits⟩
    apply keeps
    exact ⟨Nat.max_le.mpr ⟨firstEnough, secondEnough⟩, fits⟩

/- The first part may occupy more than one line. With a space first in
   an empty column, noSendFromEmpty also requires the one-space break
   when the following block cannot stay. -/
theorem I3_need_space_two_needs_first_part_exists
    (capacity used firstNeed secondNeed firstPart : Nat)
    (positiveCapacity : 1 ≤ capacity)
    (usedFits : used ≤ capacity)
    (positivePart : 1 ≤ firstPart) :
    ∃ brk : Fin 3,
      used + brk.val ≤ capacity ∧
      (brk.val = 2 →
        firstNeed ≤ capacity - used ∧
        secondNeed ≤ capacity - used) ∧
      ((firstNeed ≤ capacity - used ∧
        secondNeed ≤ capacity - used) ∧
        used + 1 + firstPart ≤ capacity → brk.val = 2) ∧
      (used = 0 → 1 ≤ brk.val) := by
  by_cases bothMet :
      firstNeed ≤ capacity - used ∧
        secondNeed ≤ capacity - used
  · by_cases firstFits : used + 1 + firstPart ≤ capacity
    · refine ⟨2, ?_, ?_, ?_, ?_⟩
      all_goals simp_all <;> omega
    · by_cases spaceFits : used + 1 ≤ capacity
      · refine ⟨1, ?_, ?_, ?_, ?_⟩
        all_goals simp_all <;> omega
      · refine ⟨0, ?_, ?_, ?_, ?_⟩
        all_goals simp_all <;> omega
  · by_cases spaceFits : used + 1 ≤ capacity
    · refine ⟨1, ?_, ?_, ?_, ?_⟩
      all_goals simp_all <;> omega
    · refine ⟨0, ?_, ?_, ?_, ?_⟩
      all_goals simp_all <;> omega

/- For any number of needs sharing one block, a record-high check
   suffices to choose a break. The single preceding space consumes capacity
   but contributes nothing to placedBefore at any of those needs. -/
theorem I3_shared_needs_first_part_exists
    (capacity used firstPart : Nat) (needs : List Nat)
    (capacityPositive : 1 ≤ capacity) (usedFits : used ≤ capacity) :
    ∃ brk : Fin 3,
      used + (if brk.val = 2 then 1 + firstPart else brk.val) ≤ capacity ∧
      (brk.val = 2 → ∀ n ∈ needs, n ≤ capacity - used) ∧
      (recordNeedsFit (capacity - used) 0 needs ∧
        used + 1 + firstPart ≤ capacity → brk.val = 2) ∧
      (used = 0 → 1 ≤ brk.val) := by
  by_cases keep : recordNeedsFit (capacity - used) 0 needs ∧
      used + 1 + firstPart ≤ capacity
  · refine ⟨2, ?_, ?_, fun _ => rfl, ?_⟩
    · change used + (1 + firstPart) ≤ capacity
      simpa [Nat.add_assoc] using keep.2
    · exact fun _ => (I3_record_needs_fit_iff_all _ _ _ (Nat.zero_le _)).mp keep.1
    · simp
  · by_cases spaceFits : used + 1 ≤ capacity
    · refine ⟨1, spaceFits, ?_, fun h => (keep h).elim, ?_⟩
      · intro h
        cases h
      · simp
    · refine ⟨0, by simpa using usedFits, ?_, fun h => (keep h).elim, ?_⟩
      · intro h
        cases h
      · intro empty
        omega

theorem I3_need_space_fixture_source_break (brk : Fin 3) :
    textHereAtBreak [.need 0, .text 1, .need 2, .text 3]
        brk.val 1 = decide (1 ≤ brk.val) ∧
      textHereAtBreak [.need 0, .text 1, .need 2, .text 3]
        brk.val 3 = decide (brk.val = 2) := by
  have cases : brk.val = 0 ∨ brk.val = 1 ∨ brk.val = 2 := by
    have bound := brk.isLt
    omega
  rcases cases with zero | one | two
  · simp [zero, textHereAtBreak, textBeforeCount, earlierTextItem]
  · simp [one, textHereAtBreak, textBeforeCount, earlierTextItem]
  · simp [two, textHereAtBreak, textBeforeCount, earlierTextItem]

/- Historical two-need input: capacity 3, one used line, need 1, space,
   need 3, then a one-line paragraph. The older P7 tests only the first
   need and keeps the paragraph; P1 tests the larger need before that
   paragraph and rejects it. -/
def needMore27Base (brk : Fin 3) : Prop :=
  1 + brk.val ≤ 3

def needMore27OldKeep (brk : Fin 3) : Prop :=
  (3 - 1 ≥ 1 ∧
    1 + (if 1 ≤ brk.val then 1 else 0) + 1 ≤ 3) →
    brk.val = 2

def needMore27NeedMet (brk : Fin 3) : Prop :=
  brk.val = 2 → 3 - 1 ≥ 3

theorem I3_needMore27 :
    (∃ brk : Fin 3, needMore27Base brk ∧ needMore27OldKeep brk) ∧
    (∃ brk : Fin 3, needMore27Base brk ∧ needMore27NeedMet brk) ∧
    (∀ brk : Fin 3,
      ¬ (needMore27Base brk ∧ needMore27OldKeep brk ∧
        needMore27NeedMet brk)) := by
  refine ⟨⟨2, by simp [needMore27Base],
      by simp [needMore27OldKeep]⟩,
    ⟨0, by simp [needMore27Base],
      by simp [needMore27NeedMet]⟩, ?_⟩
  intro brk ⟨_, oldRule, needRule⟩
  have oldForces : brk.val = 2 := by
    apply oldRule
    constructor
    · decide
    · split <;> omega
  have impossible := needRule oldForces
  omega

/- A one-line body, one-line footnote separator, and one-line note cannot
   all fit in a column of capacity 1 or 2. Golem ADR 0353 makes this a
   diagnostic instead of retrying the same unplaceable note forever. -/
theorem I4_footnote_capacity_conflict (capacity : Nat) (small : capacity ≤ 2) :
    ¬ (1 + 1 + 1 ≤ capacity) := by
  omega

inductive FootnoteOutcome where
  | placed | sent | diagnostic
  deriving DecidableEq, Repr

/- The empty-column decision for one marker line, one separator, and one
   first note line. A temporary reduction sends the note to the full column. -/
def footnoteDecision (base current separator : Nat) : FootnoteOutcome :=
  if 2 + separator ≤ current then .placed
  else if current < base ∧ 2 + separator ≤ base then .sent
  else .diagnostic

def footnoteFinal (base current separator : Nat) : FootnoteOutcome :=
  match footnoteDecision base current separator with
  | .sent => footnoteDecision base base separator
  | x => x

theorem I4_footnote_small_diagnostic (base : Nat) (small : base ≤ 2) :
    footnoteFinal base base 1 = .diagnostic := by
  have tooShort : ¬ 2 + 1 ≤ base := by omega
  simp [footnoteFinal, footnoteDecision, tooShort]

theorem I4_footnote_adjusted_column_places (base current : Nat)
    (fitsBase : 3 ≤ base) (short : current < 3) :
    footnoteFinal base current 1 = .placed := by
  have tooShort : ¬ 2 + 1 ≤ current := by omega
  have send : current < base ∧ 2 + 1 ≤ base := by omega
  simp [footnoteFinal, footnoteDecision, tooShort, send, fitsBase]

theorem I4_footnote_final_never_sends (base current separator : Nat) :
    footnoteFinal base current separator ≠ .sent := by
  by_cases fits : 2 + separator ≤ current
  · simp [footnoteFinal, footnoteDecision, fits]
  · by_cases send : current < base ∧ 2 + separator ≤ base
    · simp [footnoteFinal, footnoteDecision, fits, send, send.2]
    · simp [footnoteFinal, footnoteDecision, fits, send]

namespace FootnoteSplit

structure Note where
  id : Nat
  lines : Nat

structure Part where
  id : Nat
  start : Nat
  lines : Nat
  deriving DecidableEq

def full (n : Note) : Part := ⟨n.id,0,n.lines⟩

/-- A reserved caption or box can leave negative room. In that case
    splitNotes defers the full suffix with offset zero. -/
def split (room : Int) : List Note → List Part × List Part
  | [] => ([],[])
  | n :: rest =>
    if (n.lines : Int) ≤ room then
      let tail := split (room - n.lines) rest
      (full n :: tail.1,tail.2)
    else if room > 0 then
      ([⟨n.id,0,room.toNat⟩],⟨n.id,room.toNat,n.lines-room.toNat⟩ :: rest.map full)
    else ([],full n :: rest.map full)

/-- Identify every output grid line by note ID and zero-based index,
    so equality detects gaps, duplication and changes of order. -/
def linesFrom (id start : Nat) : Nat → List (Nat × Nat)
  | 0 => []
  | n+1 => (id,start) :: linesFrom id (start+1) n

theorem lines_split (id start a b : Nat) :
    linesFrom id start a ++ linesFrom id (start+a) b = linesFrom id start (a+b) := by
  induction a generalizing start with
  | zero => simp [linesFrom]
  | succ a ih =>
    rw [Nat.succ_add]
    simp only [linesFrom,List.cons_append,List.cons.injEq,true_and]
    have eq : start + (a+1) = (start+1)+a := by omega
    rw [eq,ih]

def trace : List Part → List (Nat × Nat)
  | [] => []
  | p :: rest => linesFrom p.id p.start p.lines ++ trace rest

theorem I5_splitNotes_exact (ns : List Note) (room : Int) :
    trace (split room ns).1 ++ trace (split room ns).2 = trace (ns.map full) := by
  induction ns generalizing room with
  | nil => rfl
  | cons n rest ih =>
    by_cases fits : (n.lines : Int) ≤ room
    · simp only [split, fits, if_true, List.map_cons, trace,List.append_assoc]
      rw [ih]
    · by_cases positive : room > 0
      · have cast := Int.toNat_of_nonneg (show 0 ≤ room by omega)
        have sum : room.toNat + (n.lines - room.toNat) = n.lines := by omega
        simp only [split,fits,positive,if_false,if_true,trace,List.append_nil,List.map_cons,full]
        rw [← List.append_assoc]
        have join := lines_split n.id 0 room.toNat (n.lines-room.toNat)
        simp only [Nat.zero_add,sum] at join
        rw [join]
      · simp [split,fits,positive,trace]

/-- The part emitted by carryNote and the pending suffix start exactly
    where the preceding part stopped, including a zero-room column. -/
def carry (room : Nat) (pending : Part) : Part × Option Part :=
  let shown := min pending.lines room
  (⟨pending.id,pending.start,shown⟩,
    if shown < pending.lines then some ⟨pending.id,pending.start+shown,pending.lines-shown⟩ else none)

theorem I5_carryNote_exact (room : Nat) (p : Part) :
    trace ((carry room p).1 :: (carry room p).2.toList) = trace [p] := by
  by_cases notEnough : room < p.lines
  · have shown := Nat.min_eq_right (Nat.le_of_lt notEnough)
    simp only [carry,shown,notEnough,if_true,Option.toList,trace,List.append_nil]
    have eq := lines_split p.id p.start room (p.lines-room)
    have count : room + (p.lines-room) = p.lines := by omega
    rwa [count] at eq
  · have shown := Nat.min_eq_left (show p.lines ≤ room by omega)
    simp [carry,shown,trace,Option.toList]

theorem I4_carryNote_remainder_decreases (room : Nat) (p rest : Part) (positive : 0 < room)
    (requeued : (carry room p).2 = some rest) : rest.lines < p.lines := by
  unfold carry at requeued
  dsimp only at requeued
  split at requeued
  · rename_i notEnough
    cases requeued
    simp only
    omega
  · contradiction

/-- A body line introduces its notes in manuscript order. The abstract
    column counter counts consecutive no-room transitions before an open
    column. Replenishing it is allowed after consuming body or note data. -/
structure Body where
  id : Nat
  notes : List Note

structure Combined where
  body : List Body
  pending : List Part
  blockedColumns : Nat

def pendingSize : List Part → Nat
  | [] => 0
  | p :: rest => 1 + p.lines + pendingSize rest

def bodyNotes : List Body → List (Nat × Nat)
  | [] => []
  | line :: remaining => trace (line.notes.map full) ++ bodyNotes remaining

def noteTrace (s : Combined) := trace s.pending ++ bodyNotes s.body

private theorem trace_append (xs ys : List Part) : trace (xs ++ ys) = trace xs ++ trace ys := by
  induction xs with
  | nil => simp [trace]
  | cons x xs ih => simp [trace,ih,List.append_assoc]

/-- A footprint separates the ordered body IDs and individual note lines.
    A retry can emit a zero-length note segment, whose trace is empty. -/
inductive Progress : Combined → List Nat → List (Nat × Nat) → Combined → Prop where
  | line (l : Body) (rest : List Body) (slots : Int) (before after : Nat) :
    Progress ⟨l::rest,[],before⟩ [l.id] (trace (split slots l.notes).1)
      ⟨rest,(split slots l.notes).2,after⟩
  | lineWaiting (l : Body) (rest : List Body) (ps : List Part) (before after : Nat) :
    Progress ⟨l::rest,ps,before⟩ [l.id] [] ⟨rest,ps ++ l.notes.map full,after⟩
  | nextColumn (body : List Body) (ps : List Part) (before : Nat) :
    Progress ⟨body,ps,before+1⟩ [] [] ⟨body,ps,before⟩
  | carryPart (body : List Body) (p : Part) (ps : List Part) (slots before after : Nat)
      (possible : 0 < slots ∨ p.lines = 0) :
    Progress ⟨body,p::ps,before⟩ [] (trace [(carry slots p).1])
      ⟨body,(carry slots p).2.toList ++ ps,after⟩

def progressRank (s : Combined) : Nat × Nat × Nat := (s.body.length,pendingSize s.pending,s.blockedColumns)

theorem I4_combined_decreases {s t : Combined} {bodyOut : List Nat} {notesOut : List (Nat × Nat)}
    (move : Progress s bodyOut notesOut t) :
    Prod.Lex (· < ·) (Prod.Lex (· < ·) (· < ·)) (progressRank t) (progressRank s) := by
  cases move with
  | line | lineWaiting => apply Prod.Lex.left; simp [progressRank]
  | nextColumn => apply Prod.Lex.right; apply Prod.Lex.right; simp [progressRank]
  | carryPart body p ps slots before after possible =>
      apply Prod.Lex.right
      apply Prod.Lex.left
      cases eq : (carry slots p).2 with
      | none => simp [eq,pendingSize,progressRank]; omega
      | some suffix =>
        have positive : 0 < slots := by
          rcases possible with h | zero
          · exact h
          · simp [carry,zero] at eq
        have decrease := I4_carryNote_remainder_decreases slots p suffix positive eq
        simp [progressRank,eq,pendingSize]
        omega

theorem I5_combined_step_exact {s t : Combined} {bodyOut : List Nat} {notesOut : List (Nat × Nat)}
    (move : Progress s bodyOut notesOut t) :
    bodyOut ++ t.body.map Body.id = s.body.map Body.id ∧ notesOut ++ noteTrace t = noteTrace s := by
  cases move with
  | line l rest slots before after =>
      simp only [noteTrace,bodyNotes,trace,List.map_cons,List.cons_append,List.nil_append,true_and]
      rw [← List.append_assoc,I5_splitNotes_exact]
  | lineWaiting l rest ps before after =>
      simp [noteTrace,bodyNotes,trace_append,List.append_assoc]
  | nextColumn => simp [noteTrace]
  | carryPart body p ps slots before after possible =>
      refine ⟨rfl,?_⟩
      have exactParts := I5_carryNote_exact slots p
      simp only [trace,List.append_nil] at exactParts
      simp only [noteTrace,trace_append,trace,List.append_nil,List.append_assoc]
      rw [← List.append_assoc (linesFrom _ _ _) (trace _) (trace ps ++ bodyNotes body),exactParts]

theorem I4_combined_termination :
    WellFounded (fun t s : Combined => ∃ bodyOut notesOut, Progress s bodyOut notesOut t) := by
  apply Subrelation.wf (r := InvImage (Prod.Lex (· < ·) (Prod.Lex (· < ·) (· < ·))) progressRank)
  · rintro _ _ ⟨_,_,move⟩
    exact I4_combined_decreases move
  · exact InvImage.wf progressRank (Prod.lex Nat.lt_wfRel (Prod.lex Nat.lt_wfRel Nat.lt_wfRel)).wf

/-- A finite execution retains its suffix; at completion the traces of
    the body and of each individual note line coincide with the input. -/
inductive Execution : Combined → List Nat → List (Nat × Nat) → Combined → Prop where
  | stop (s : Combined) : Execution s [] [] s
  | more {s t u : Combined} {bs bRest : List Nat} {ns nRest : List (Nat × Nat)} :
    Progress s bs ns t → Execution t bRest nRest u → Execution s (bs ++ bRest) (ns ++ nRest) u

theorem I5_combined_execution_exact {s t : Combined} {bs : List Nat} {ns : List (Nat × Nat)}
    (run : Execution s bs ns t) :
    bs ++ t.body.map Body.id = s.body.map Body.id ∧ ns ++ noteTrace t = noteTrace s := by
  induction run with
  | stop => exact ⟨rfl,rfl⟩
  | more move _ ih =>
    have first := I5_combined_step_exact move
    simp only [List.append_assoc,ih.1,ih.2]
    exact first

def Complete (s : Combined) := s.body = [] ∧ s.pending = []

theorem I5_completed_output {s t : Combined} {bs : List Nat} {ns : List (Nat × Nat)}
    (run : Execution s bs ns t) (done : Complete t) :
    bs = s.body.map Body.id ∧ ns = noteTrace s := by
  have eq := I5_combined_execution_exact run
  simpa [done.1,done.2,noteTrace,trace,bodyNotes] using eq

theorem I4_I5_three_page_witness :
    Execution ⟨[⟨0,[⟨10,1⟩,⟨20,5⟩,⟨30,2⟩]⟩],[],0⟩ [0]
      [(10,0),(20,0),(20,1),(20,2),(20,3),(20,4),(30,0),(30,1)] ⟨[],[],0⟩ := by
  let initial : Body := ⟨0,[⟨10,1⟩,⟨20,5⟩,⟨30,2⟩]⟩
  have line := Progress.line initial [] 3 0 0
  have first := Progress.carryPart [] ⟨20,2,3⟩ [⟨30,0,2⟩] 3 0 1 (Or.inl (by decide))
  have advance := Progress.nextColumn [] [⟨30,0,2⟩] 0
  have last := Progress.carryPart [] ⟨30,0,2⟩ [] 3 0 0 (Or.inl (by decide))
  exact Execution.more line (Execution.more first (Execution.more advance
    (Execution.more last (Execution.stop _))))

/-- advance ends the page exactly when the next column index reaches
    the column count. A zero-room carry that stays on the same page
    therefore consumes one of the remaining columns on that page. -/
def columnsBeforePage (columns index : Nat) := columns - 1 - index

theorem I4_within_page_retry (columns index : Nat) (samePage : index + 1 < columns) :
    columnsBeforePage columns index = columnsBeforePage columns (index+1) + 1 := by
  unfold columnsBeforePage
  omega

theorem I4_fresh_page_note_progress (capacity separator : Nat) (p : Part)
    (nonempty : 0 < p.lines) :
    (0 < p.lines ∧ (capacity : Int) - separator - 1 ≤ 0) ∨
      (0 < capacity - separator - 1 ∧
        ∀ rest, (carry (capacity-separator-1) p).2 = some rest → rest.lines < p.lines) := by
  by_cases room : capacity ≤ separator+1
  · exact Or.inl ⟨nonempty,by omega⟩
  · right
    have positive : 0 < capacity-separator-1 := by omega
    exact ⟨positive, fun r eq => I4_carryNote_remainder_decreases _ p r positive eq⟩

/-- carryNote uses signed grid arithmetic before clipping available
    room to zero: reservations can exceed the capacity of the next
    column after an adjusted column in the same page. -/
def availableForCarry (cap reserved sep : Int) : Nat := (cap-reserved-sep-1).toNat

theorem I4_I5_reserved_carry (cap reserved sep : Int) (p : Part) :
    let room := availableForCarry cap reserved sep
    trace ((carry room p).1 :: (carry room p).2.toList) = trace [p] ∧
      (∀ rest, (carry room p).2 = some rest →
        p.start ≤ rest.start ∧ rest.lines ≤ p.lines ∧
          (cap-reserved-sep-1 > 0 → rest.lines < p.lines)) := by
  intro room
  refine ⟨I5_carryNote_exact room p,?_⟩
  intro rest again
  unfold carry at again
  dsimp only at again
  split at again
  · cases again
    simp only
    refine ⟨by omega,by omega,?_⟩
    intro pos
    have cast := Int.toNat_of_nonneg (show 0 ≤ cap-reserved-sep-1 by omega)
    have hasRoom : 0 < room := by dsimp [room,availableForCarry]; omega
    omega
  · contradiction

example : carry (availableForCarry 5 6 0) ⟨20,5,3⟩ = (⟨20,5,0⟩,some ⟨20,5,3⟩) := by decide

structure ColumnState where
  page : Nat
  column : Nat
  columns : Nat
  reserved : Nat
  noteLines : Nat

/-- Only the leading turned figures are removed when crossing the page
    boundary. pageFigure increments the page but leaves the fresh
    column's reservation and note load unchanged. -/
def advanceColumn (s : ColumnState) (turned : List Nat) : ColumnState :=
  if s.columns ≤ s.column + 1 then
    { s with page := s.page + 1 + turned.length, column := 0, reserved := 0, noteLines := 0 }
  else
    { s with column := s.column + 1, noteLines := s.reserved }

def carryRoom (cap separator : Nat) (s : ColumnState) : Nat :=
  availableForCarry cap s.noteLines (if s.noteLines = 0 then separator else 0)

def noteWeight (p : Part) := p.lines + 1

/-- A diagnosed first note is removed from the pending list and the
    driver aborts PDF generation. For a carried note, calculate the
    actual remainder using the clamped room of the new column. -/
def firstRemainder (cap separator : Nat) (s : ColumnState) (p : Part) : Option Part :=
  let room := carryRoom cap separator s
  if 0 < p.lines ∧ room = 0 ∧ s.noteLines = 0 ∧ s.reserved = 0 then none
  else (carry room p).2

theorem I4_advance_first_note_rank (s : ColumnState) (turned : List Nat) (cap separator : Nat) (p : Part) :
    let next := advanceColumn s turned
    let old := (noteWeight p, columnsBeforePage s.columns s.column)
    let new := ((firstRemainder cap separator next p).elim 0 noteWeight,
      columnsBeforePage next.columns next.column)
    Prod.Lex (· < ·) (· < ·) new old := by
  intro next old new
  have weight (r : Part) (eq : firstRemainder cap separator next p = some r) :
      r.lines ≤ p.lines ∧ (0 < carryRoom cap separator next → r.lines < p.lines) := by
    unfold firstRemainder at eq
    dsimp only at eq
    split at eq
    · contradiction
    · have rec := eq
      unfold carry at eq
      dsimp only at eq
      split at eq
      · cases eq
        exact ⟨by simp; omega,fun positive => I4_carryNote_remainder_decreases _ _ _ positive rec⟩
      · contradiction
  cases rem : firstRemainder cap separator next p with
  | none =>
    apply Prod.Lex.left
    simp [new,old,rem,noteWeight]
  | some r =>
    obtain ⟨weak,strict⟩ := weight r rem
    by_cases decreased : r.lines < p.lines
    · apply Prod.Lex.left
      simp [new,old,rem,noteWeight]; omega
    · have same : r.lines = p.lines := by omega
      have roomZero : carryRoom cap separator next = 0 := by
        apply Classical.byContradiction
        intro positive
        exact decreased (strict (by omega))
      have remains : 0 < p.lines := by
        apply Classical.byContradiction
        intro zero
        have z : p.lines = 0 := by omega
        simp [firstRemainder,carry,roomZero,z] at rem
      have within : s.column + 1 < s.columns := by
        apply Classical.byContradiction
        intro crossed
        have toPage : s.columns ≤ s.column+1 := by omega
        have fresh : next.noteLines = 0 ∧ next.reserved = 0 := by simp [next,advanceColumn,toPage]
        simp [firstRemainder,remains,roomZero,fresh] at rem
      have eq := I4_within_page_retry s.columns s.column within
      have stay : ¬ s.columns ≤ s.column+1 := by omega
      change Prod.Lex _ _ ((firstRemainder cap separator next p).elim 0 noteWeight,
        columnsBeforePage next.columns next.column) (noteWeight p,columnsBeforePage s.columns s.column)
      rw [rem]
      simp only [Option.elim,noteWeight,same]
      apply Prod.Lex.right
      simp only [next,advanceColumn,stay,if_false]
      omega

/-- Later notes on the same column see the separator and note rows
    already consumed by preceding notes. They are no longer first on an
    empty column, even if a preceding zero-length part was recorded. -/
def carryBatch (cap separator : Nat) : Bool → ColumnState → List Part → List Part
  | _, _, [] => []
  | empty, s, p :: ps =>
    let room := carryRoom cap separator s
    if 0 < p.lines ∧ room = 0 ∧ empty = true ∧ s.reserved = 0 then
      carryBatch cap separator empty s ps
    else
      let part := carry room p
      let sep := if s.noteLines = 0 then separator else 0
      part.2.toList ++ carryBatch cap separator false {s with noteLines := s.noteLines + sep + part.1.lines} ps

theorem carryBatch_weight_le (cap separator : Nat) (ps : List Part) (empty : Bool) (s : ColumnState) :
    pendingSize (carryBatch cap separator empty s ps) ≤ pendingSize ps := by
  induction ps generalizing empty s with
  | nil => exact Nat.le_refl _
  | cons p ps ih =>
    rw [carryBatch]
    dsimp only
    split
    · have rec := ih empty s
      change pendingSize _ ≤ 1 + p.lines + pendingSize ps
      exact Nat.le_trans rec (by omega)
    · cases rem : (carry (carryRoom cap separator s) p).2 with
      | none =>
        simp only [Option.toList,List.nil_append,pendingSize]
        exact Nat.le_trans (ih _ _) (by omega)
      | some r =>
        have bound : r.lines ≤ p.lines := by
          unfold carry at rem
          dsimp only at rem
          split at rem
          · cases rem; exact Nat.sub_le _ _
          · contradiction
        simp only [Option.toList,List.cons_append,List.nil_append,pendingSize]
        apply Nat.add_le_add _ (ih _ _)
        omega

theorem I4_advance_note_batch (ps : List Part) (nonempty : ps ≠ []) (s : ColumnState)
    (turned : List Nat) (cap separator : Nat) :
    let next := advanceColumn s turned
    let rest := carryBatch cap separator true next ps
    Prod.Lex (· < ·) (· < ·) (pendingSize rest,columnsBeforePage next.columns next.column)
      (pendingSize ps,columnsBeforePage s.columns s.column) := by
  cases ps with
  | nil => contradiction
  | cons p ps =>
    intro next rest
    have head := I4_advance_first_note_rank s turned cap separator p
    have fresh : next.noteLines = next.reserved := by
      by_cases last : s.columns ≤ s.column+1 <;> simp [next,advanceColumn,last]
    have whole : pendingSize rest ≤ (firstRemainder cap separator next p).elim 0 noteWeight + pendingSize ps := by
      dsimp only [rest,carryBatch,firstRemainder]
      split
      · rename_i guard
        simp [guard,fresh] at *
        exact carryBatch_weight_le _ _ _ _ _
      · rename_i guard
        simp only [true_and] at guard
        have notDiag : ¬ (0 < p.lines ∧ carryRoom cap separator next = 0 ∧ next.noteLines = 0 ∧ next.reserved = 0) := by
          intro h
          exact guard ⟨h.1,h.2.1,h.2.2.2⟩
        rw [if_neg notDiag]
        cases (carry (carryRoom cap separator next) p).2 with
        | none => simpa [Option.elim] using carryBatch_weight_le cap separator ps false _
        | some r =>
          simp only [Option.elim,Option.toList,List.cons_append,List.nil_append,pendingSize,noteWeight]
          rw [Nat.add_comm 1 r.lines]
          exact Nat.add_le_add_left (carryBatch_weight_le cap separator ps false _) _
    have lexCases {x y u v : Nat} (h : Prod.Lex (· < ·) (· < ·) (x,u) (y,v)) :
        x < y ∨ (x = y ∧ u < v) := by
      cases h with
      | left _ _ lt => exact Or.inl lt
      | right _ lt => exact Or.inr ⟨rfl,lt⟩
    have options := lexCases head
    change (firstRemainder cap separator next p).elim 0 noteWeight < noteWeight p ∨
      ((firstRemainder cap separator next p).elim 0 noteWeight = noteWeight p ∧
        columnsBeforePage next.columns next.column < columnsBeforePage s.columns s.column) at options
    change Prod.Lex _ _ (pendingSize rest,_) (1+p.lines+pendingSize ps,_)
    rcases options with less | ⟨equal,closer⟩
    · apply Prod.Lex.left
      change _ < p.lines + 1 at less
      omega
    · rw [equal] at whole
      unfold noteWeight at whole
      by_cases fewer : pendingSize rest < 1+p.lines+pendingSize ps
      · exact Prod.Lex.left _ _ fewer
      · have same : pendingSize rest = 1+p.lines+pendingSize ps := by omega
        rw [same]
        exact Prod.Lex.right _ closer

inductive Deferred where
  | figure (id height : Nat)
  | turned (id : Nat)
  deriving DecidableEq

def splitTurned : List Deferred → List Nat × List Deferred
  | .turned id :: rest => let parts := splitTurned rest; (id :: parts.1,parts.2)
  | rest => ([],rest)

theorem splitTurned_exact (xs : List Deferred) :
    (splitTurned xs).1.map Deferred.turned ++ (splitTurned xs).2 = xs := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    cases x with
    | figure _ _ => rfl
    | turned id =>
      simpa only [splitTurned,List.map_cons,List.cons_append,List.cons.injEq,true_and] using ih

def placeDeferred (free : Int) (empty : Bool) : List Deferred → List Deferred × List Deferred
  | [] => ([],[])
  | .turned i :: rest => ([],.turned i :: rest)
  | .figure i h :: rest =>
    if (h : Int) ≤ free ∨ empty = true then
      let placed := placeDeferred (free-h) false rest
      (.figure i h :: placed.1,placed.2)
    else ([],.figure i h :: rest)

theorem placeDeferred_exact (xs : List Deferred) (free : Int) (empty : Bool) :
    (placeDeferred free empty xs).1 ++ (placeDeferred free empty xs).2 = xs := by
  induction xs generalizing free empty with
  | nil => rfl
  | cons x xs ih =>
    cases x with
    | turned _ => rfl
    | figure i h =>
      by_cases fit : (h : Int) ≤ free ∨ empty = true
      · simp only [placeDeferred,fit,if_true,List.cons_append,List.cons.injEq,true_and]
        exact ih _ _
      · simp [placeDeferred,fit]

def placedOnAdvance (s : ColumnState) (xs : List Deferred) (free : Int) (empty : Bool) :
    List Deferred × List Deferred :=
  let parts := if s.columns ≤ s.column+1 then splitTurned xs else ([],xs)
  let placed := placeDeferred free empty parts.2
  (parts.1.map Deferred.turned ++ placed.1,placed.2)

theorem I5_figures_on_advance (s : ColumnState) (xs : List Deferred) (free : Int) (empty : Bool) :
    (placedOnAdvance s xs free empty).1 ++ (placedOnAdvance s xs free empty).2 = xs := by
  by_cases crossed : s.columns ≤ s.column+1
  · simp only [placedOnAdvance,crossed,if_true,List.append_assoc,placeDeferred_exact,splitTurned_exact]
  · simp [placedOnAdvance,crossed,placeDeferred_exact]

theorem I4_advance_waiting_figures (s : ColumnState) (xs : List Deferred) (nonempty : xs ≠ [])
    (free : Int) (empty : Bool) (freshEmpty : s.columns ≤ s.column+1 → empty = true) :
    let rest := (placedOnAdvance s xs free empty).2
    let next := advanceColumn s (splitTurned xs).1
    Prod.Lex (· < ·) (· < ·) (rest.length,columnsBeforePage next.columns next.column)
      (xs.length,columnsBeforePage s.columns s.column) := by
  intro rest next
  have exactFig := I5_figures_on_advance s xs free empty
  have total := congrArg List.length exactFig
  rw [List.length_append] at total
  change (placedOnAdvance s xs free empty).1.length + rest.length = xs.length at total
  by_cases progress : rest.length < xs.length
  · exact Prod.Lex.left _ _ progress
  · have same : rest.length = xs.length := by omega
    have none : (placedOnAdvance s xs free empty).1 = [] := List.length_eq_zero.mp (by omega)
    have before : s.column+1 < s.columns := by
      apply Nat.lt_of_not_ge
      intro nextPage
      have e := freshEmpty nextPage
      cases xs with
      | nil => contradiction
      | cons x xs =>
        cases x with
        | turned id => simp [placedOnAdvance,nextPage,splitTurned] at none
        | figure i h => simp [placedOnAdvance,nextPage,splitTurned,placeDeferred,e] at none
    rw [same]
    apply Prod.Lex.right
    have rank := I4_within_page_retry s.columns s.column before
    simp only [next,advanceColumn,show ¬ s.columns ≤ s.column+1 by omega,if_false]
    omega

structure FlushState where
  geometry : ColumnState
  figures : List Deferred
  notes : List Part

def flushRank (s : FlushState) : Nat × Nat × Nat :=
  (s.figures.length,pendingSize s.notes,columnsBeforePage s.geometry.columns s.geometry.column)

def flushStep (s : FlushState) (cap sep : Nat) (free : Int) (emptyAfterNotes : Bool) : FlushState :=
  let next := advanceColumn s.geometry (splitTurned s.figures).1
  ⟨next,(placedOnAdvance s.geometry s.figures free emptyAfterNotes).2,carryBatch cap sep true next s.notes⟩

/-- On a fresh page with no carried notes, therefore before openBox,
    no body or figure has occupied the new column. Leading turned
    figures already emitted each occupy a separate preceding page. -/
theorem I4_actual_flush_step (s : FlushState) (cap sep : Nat) (free : Int) (emptyAfterNotes : Bool)
    (needsFlush : s.figures ≠ [] ∨ s.notes ≠ [])
    (freshEmpty : s.notes = [] → s.geometry.columns ≤ s.geometry.column+1 → emptyAfterNotes = true) :
    Prod.Lex (· < ·) (Prod.Lex (· < ·) (· < ·)) (flushRank (flushStep s cap sep free emptyAfterNotes)) (flushRank s) := by
  let next := advanceColumn s.geometry (splitTurned s.figures).1
  let ps := placedOnAdvance s.geometry s.figures free emptyAfterNotes
  have total := congrArg List.length (I5_figures_on_advance s.geometry s.figures free emptyAfterNotes)
  change (ps.1 ++ ps.2).length = s.figures.length at total
  rw [List.length_append] at total
  change Prod.Lex _ _ (ps.2.length,pendingSize (carryBatch cap sep true next s.notes),columnsBeforePage next.columns next.column)
    (s.figures.length,pendingSize s.notes,columnsBeforePage s.geometry.columns s.geometry.column)
  by_cases fewer : ps.2.length < s.figures.length
  · exact Prod.Lex.left _ _ fewer
  · have equal : ps.2.length = s.figures.length := by omega
    rw [equal]
    apply Prod.Lex.right
    by_cases hasNotes : s.notes ≠ []
    · exact I4_advance_note_batch s.notes hasNotes s.geometry (splitTurned s.figures).1 cap sep
    · have noNotes : s.notes = [] := Classical.byContradiction (fun h => hasNotes h)
      have figs : s.figures ≠ [] := needsFlush.resolve_right hasNotes
      have progress := I4_advance_waiting_figures s.geometry s.figures figs free emptyAfterNotes (freshEmpty noNotes)
      change Prod.Lex _ _ (ps.2.length,columnsBeforePage next.columns next.column)
        (s.figures.length,columnsBeforePage s.geometry.columns s.geometry.column) at progress
      rw [equal] at progress
      rw [noNotes]
      apply Prod.Lex.right
      have coords {a b c : Nat} (p : Prod.Lex (· < ·) (· < ·) (a,b) (a,c)) : b < c := by
        cases p with
        | left _ _ h => omega
        | right _ h => exact h
      exact coords progress

inductive FlushTransition : FlushState → FlushState → Prop where
  | advance (s : FlushState) (cap sep : Nat) (free : Int) (empty : Bool)
      (pending : s.figures ≠ [] ∨ s.notes ≠ [])
      (fresh : s.notes = [] → s.geometry.columns ≤ s.geometry.column+1 → empty = true) :
      FlushTransition (flushStep s cap sep free empty) s

theorem I4_flush_terminates : WellFounded FlushTransition := by
  apply Subrelation.wf (r := InvImage (Prod.Lex (· < ·) (Prod.Lex (· < ·) (· < ·))) flushRank)
  · intro _ _ moved
    cases moved with
    | advance s cap sep free empty pending fresh =>
      exact I4_actual_flush_step _ _ _ _ _ pending fresh
  · exact InvImage.wf flushRank (Prod.lex Nat.lt_wfRel (Prod.lex Nat.lt_wfRel Nat.lt_wfRel)).wf

example : let st : FlushState := ⟨⟨1,0,2,6,6⟩,[.turned 99],[⟨20,5,3⟩]⟩
    let second := flushStep st 5 1 (-1) false
    let third := flushStep second 5 1 1 false
    second.geometry.page = 1 ∧ second.geometry.column = 1 ∧ second.notes = [⟨20,5,3⟩] ∧
    third.geometry.page = 3 ∧ third.geometry.column = 0 ∧ third.geometry.reserved = 0 ∧
    third.notes = [] ∧ third.figures = [] := by decide

end FootnoteSplit

namespace TablePagination

/-- Projection of placeTable.rowsFrom. Capacity includes any caption
    that must accompany the last body row. A repeated header takes one
    grid line per box; its new start can be anywhere in the column. -/
structure Cursor where
  used : Nat
  segmentStart : Nat

def emitHeader (s : Cursor) (header : List Nat) : Cursor :=
  header.foldl (fun acc _ => { acc with used := acc.used + 1 }) s

theorem header_used (s : Cursor) (header : List Nat) :
    (emitHeader s header).used = s.used + header.length := by
  induction header generalizing s with
  | nil => simp [emitHeader]
  | cons x xs ih =>
      change (emitHeader {s with used := s.used+1} xs).used = _
      rw [ih]
      simp; omega

def retry (fresh : Cursor) (header : List Nat) : Cursor :=
  { emitHeader fresh header with segmentStart := fresh.used }

theorem repeated_header_guard (fresh : Cursor) (header : List Nat) :
    (retry fresh header).used = (retry fresh header).segmentStart + header.length :=
  header_used fresh header

def rank (header : List Nat) (s : Cursor) (remaining : List (List Nat)) :=
  2 * remaining.length + (if s.used = s.segmentStart + header.length then 0 else 1)

theorem retry_decreases (header : List Nat) (s fresh : Cursor) (remaining : List (List Nat))
    (mustRetry : s.used ≠ s.segmentStart + header.length) :
    rank header (retry fresh header) remaining < rank header s remaining := by
  simp [rank,mustRetry,repeated_header_guard]

theorem row_decreases (header : List Nat) (s next : Cursor) (row : List Nat) (rest : List (List Nat)) :
    rank header next rest < rank header s (row :: rest) := by
  unfold rank
  simp only [List.length_cons]
  split <;> split <;> omega

/-- The fitting test and fresh cursor depend on the concrete pagination
    state. The progress proof works for every result of those calls.
    The output here includes only original table body rows. -/
def rowsFrom (header : List Nat) (fits : Cursor → List Nat → List (List Nat) → Bool)
    (fresh : Cursor → Cursor) (s : Cursor) (remaining : List (List Nat)) : List (List Nat) :=
  match remaining with
  | [] => []
  | row :: rest =>
    if _consume : fits s row rest = true ∨ s.used = s.segmentStart + header.length then
      row :: rowsFrom header fits fresh {s with used := s.used + row.length} rest
    else
      rowsFrom header fits fresh (retry (fresh s) header) (row :: rest)
termination_by rank header s remaining
decreasing_by
  all_goals simp_wf
  · exact row_decreases _ _ _ _ _
  · exact retry_decreases _ _ _ _ (fun ready => _consume (Or.inr ready))

theorem I5_table_body_exact (header : List Nat) (fits : Cursor → List Nat → List (List Nat) → Bool)
    (fresh : Cursor → Cursor) (s : Cursor) (remaining : List (List Nat)) :
    rowsFrom header fits fresh s remaining = remaining := by
  cases remaining with
  | nil => rw [rowsFrom]
  | cons row rest =>
    rw [rowsFrom]
    split
    · rw [I5_table_body_exact header fits fresh _ rest]
    · exact I5_table_body_exact header fits fresh _ (row :: rest)
termination_by rank header s remaining
decreasing_by
  · exact row_decreases _ _ _ _ _
  · apply retry_decreases
    intro ready
    rename_i guard
    exact guard (Or.inr ready)

end TablePagination

namespace TableAdvance
open FootnoteSplit TablePagination

/-- A table can cross several columns while keep waits for a repeated
    header and its first body row. Each crossing carries notes and emits
    the prefix of figures actually placed on that crossing. -/
inductive Crossings : FlushState → List Deferred → FlushState → Prop where
  | stop (s) : Crossings s [] s
  | next (s cap sep free empty emitted last)
      (tail : Crossings (flushStep s cap sep free empty) emitted last) :
      Crossings s ((placedOnAdvance s.geometry s.figures free empty).1 ++ emitted) last

theorem crossings_fifo {s last : FlushState} {emitted : List Deferred}
    (run : Crossings s emitted last) : emitted ++ last.figures = s.figures := by
  induction run with
  | stop => simp
  | next s cap sep free empty emitted last _ ih =>
    rw [List.append_assoc, ih]
    exact I5_figures_on_advance s.geometry s.figures free empty

/-- Retrying the same source row decreases the table rank even if keep
    crosses several columns, places deferred figures, and replays the
    header at a cursor with a different initial occupancy. -/
theorem retry_after_crossings (header : List Nat) (rows : List (List Nat))
    (old fresh : Cursor) (retryNeeded : old.used ≠ old.segmentStart + header.length)
    {s last : FlushState} {emitted : List Deferred} (run : Crossings s emitted last) :
    rank header (retry fresh header) rows < rank header old rows ∧
    emitted ++ last.figures = s.figures :=
  ⟨retry_decreases header old fresh rows retryNeeded, crossings_fifo run⟩

/-- Projection of putLineKeeping on the input line, its displayed notes,
    and the pending state shared with the next column crossing. cap is
    the signed, box-adjusted capacity returned by the implementation. -/
def putBody (s : FlushState) (cap : Int) (used reserve separator : Nat) (line : Body) :
    Nat × List Part × FlushState :=
  let sep := if s.geometry.noteLines = 0 ∧ 0 < (line.notes.foldl (fun total n => total + n.lines) 0) then separator else 0
  let room := cap - used - 1 - reserve - s.geometry.noteLines - sep
  let (shown,pending) := split room line.notes
  let charged := if shown.isEmpty && reserve > 0 then 0 else sep
  let next := {s.geometry with noteLines := s.geometry.noteLines + charged + (shown.foldl (fun total part => total + part.lines) 0)}
  (line.id,shown,{s with geometry := next, notes := s.notes ++ pending})

/-- Displaying a new note can precede older pending notes. Track its own
    suffix separately from the old FIFO prefix. Figure order survives
    every subsequent crossing, including one that repeats a table header. -/
theorem body_then_crossings (s : FlushState) (cap : Int) (used reserve separator : Nat)
    (line : Body) {emitted : List Deferred} {last : FlushState}
    (run : Crossings (putBody s cap used reserve separator line).2.2 emitted last) :
    let result := putBody s cap used reserve separator line
    result.1 = line.id ∧ emitted ++ last.figures = s.figures ∧
    ∃ pending, result.2.2.notes = s.notes ++ pending ∧
      trace result.2.1 ++ trace pending = trace (line.notes.map full) := by
  have fifo := crossings_fifo run
  refine ⟨rfl,fifo,_,rfl,?_⟩
  exact I5_splitNotes_exact _ _

/-- putBlock emits one heading slot, flattening the notes of its input
    lines in source order. Unlike putLineKeeping, it never charges the
    separator if the heading displays no note fragment. -/
def putHeading (s : FlushState) (cap : Int) (used height separator : Nat)
    (first : Body) (rest : List Body) : (Nat × Nat) × List Part × FlushState :=
  let notes := (first :: rest).bind Body.notes
  let sep := if s.geometry.noteLines = 0 ∧ 0 < notes.foldl (fun total n => total + n.lines) 0
    then separator else 0
  let (shown,pending) := split (cap - used - height - s.geometry.noteLines - sep) notes
  let charged := if shown.isEmpty then 0 else sep
  let amount := shown.foldl (fun total part => total + part.lines) 0
  let next := {s.geometry with noteLines := s.geometry.noteLines + charged + amount}
  ((first.id,rest.length+1),shown,{s with geometry := next,notes := s.notes ++ pending})

theorem heading_then_crossings (s : FlushState) (cap : Int) (used height separator : Nat)
    (first : Body) (rest : List Body) {emitted : List Deferred} {last : FlushState}
    (run : Crossings (putHeading s cap used height separator first rest).2.2 emitted last) :
    let result := putHeading s cap used height separator first rest
    result.1 = (first.id,(first :: rest).length) ∧ emitted ++ last.figures = s.figures ∧
    ∃ pending, result.2.2.notes = s.notes ++ pending ∧
      trace result.2.1 ++ trace pending = trace (((first :: rest).bind Body.notes).map full) := by
  have fifo := crossings_fifo run
  refine ⟨rfl,fifo,_,rfl,?_⟩
  exact I5_splitNotes_exact _ _

/-- sDone is newest first. Project each PageOut to slots and note
    fragments; control diagnostics and section annotations do not
    modify those two fields. -/
structure PageContent (Slot : Type) where
  slots : List Slot
  notes : List Part

def closeContent {Slot : Type} (done : List (PageContent Slot)) (current : PageContent Slot) :=
  if current.slots.isEmpty && current.notes.isEmpty then done else current :: done

private theorem bind_snoc {A B : Type} (xs : List A) (x : A) (f : A → List B) :
    (xs ++ [x]).bind f = xs.bind f ++ f x := by
  induction xs with
  | nil => simp [List.bind]
  | cons h t ih =>
    change f h ++ (t ++ [x]).bind f = (f h ++ t.bind f) ++ f x
    rw [ih,List.append_assoc]

theorem closeContent_slots {Slot : Type} (done : List (PageContent Slot)) (current : PageContent Slot) :
    (closeContent done current).reverse.bind PageContent.slots =
    done.reverse.bind PageContent.slots ++ current.slots := by
  cases current with
  | mk slots notes =>
    cases slots <;> cases notes <;> simp [closeContent,bind_snoc,List.isEmpty]

theorem closeContent_notes {Slot : Type} (done : List (PageContent Slot)) (current : PageContent Slot) :
    (closeContent done current).reverse.bind PageContent.notes =
    done.reverse.bind PageContent.notes ++ current.notes := by
  cases current with
  | mk slots notes =>
    cases slots <;> cases notes <;> simp [closeContent,bind_snoc,List.isEmpty]

namespace BreakDispatch

inductive Kind where
  | page | column | recto | verso

inductive Action where
  | stay | nextColumn | nextPage | blank | recto | verso
  deriving DecidableEq

def turned : Deferred → Bool
  | .turned _ => true
  | .figure _ _ => false

def pageAction (empty : Bool) (column : Nat) (afterPageFigure : Bool) : Action :=
  if empty && column == 0 then (if afterPageFigure then .stay else .blank) else .nextPage

def forced (kind : Kind) (columns column : Nat) (empty afterPageFigure : Bool)
    (pending : List Deferred) : Action :=
  match kind with
  | .page => pageAction empty column afterPageFigure
  | .recto => .recto
  | .verso => .verso
  | .column =>
    if 1 < columns ∧ pending.any turned = false then .nextColumn
    else pageAction empty column afterPageFigure

theorem turned_anywhere (before after : List Deferred) (id : Nat) :
    (before ++ Deferred.turned id :: after).any turned = true := by
  induction before with
  | nil => rfl
  | cons d rest ih =>
    cases d <;> simp [List.any,turned,ih]

theorem column_before_turned (columns column id : Nat) (empty afterPageFigure : Bool)
    (before after : List Deferred) :
    forced .column columns column empty afterPageFigure (before ++ Deferred.turned id :: after) =
      pageAction empty column afterPageFigure := by
  simp [forced,turned_anywhere]

theorem column_without_turned (columns column : Nat) (empty afterPageFigure : Bool)
    (pending : List Deferred) (many : 1 < columns) (regular : pending.any turned = false) :
    forced .column columns column empty afterPageFigure pending = .nextColumn := by
  simp [forced,many,regular]

/-- startBefore receives the post-flush geometry for a page start,
    and the current geometry for a column start. -/
def startAction (kind : Kind) (empty : Bool) (column : Nat) : Action :=
  match kind with
  | .column => if empty then .stay else .nextColumn
  | .page => if empty && column == 0 then .stay else .nextPage
  | .recto => .recto
  | .verso => .verso

/-- parityStart uses the page reached after flushing deferred content
    and moving to a page boundary. blankPage then advances once. -/
def parityPage (recto : Bool) (page : Nat) :=
  if page % 2 = (if recto then 1 else 0) then page else page+1

theorem parityPage_correct (recto : Bool) (page : Nat) :
    (parityPage recto page) % 2 = (if recto then 1 else 0) ∧
    page ≤ parityPage recto page ∧ parityPage recto page ≤ page+1 := by
  cases recto
  · by_cases h : page % 2 = 0 <;> simp [parityPage,h] <;> omega
  · by_cases h : page % 2 = 1 <;> simp [parityPage,h] <;> omega

/-- Each stored paragraph space carries the requested and actual grid
    lines. Only the actual lines are subtracted when testing need-lines. -/
def charged (top boxStart : Bool) (request free : Int) : Int :=
  if top || boxStart then 0 else max 0 (min request free)

def placeSpaces (used : Int) : List Int → Int
  | [] => used
  | actual :: rest => placeSpaces (used+actual) rest

theorem restore_before_spaces (used : Int) (actual : List Int) :
    placeSpaces used actual - actual.foldr (· + ·) 0 = used := by
  induction actual generalizing used with
  | nil => simp [placeSpaces]
  | cons a rest ih =>
    simp only [placeSpaces,List.foldr]
    have h := ih (used+a)
    omega

theorem charged_bounds (top boxStart : Bool) (request free : Int) :
    0 ≤ charged top boxStart request free ∧ charged top boxStart request free ≤ max 0 free := by
  unfold charged
  split <;> omega

/-- At EOF a nonempty pending-blank list triggers exactly one extra
    column crossing only if a figure is deferred. The subsequent flush
    still processes carried notes in all branches. -/
def crossBeforeDropping {A : Type} (blanks : List A) (figures : List Deferred) : Bool :=
  !blanks.isEmpty && !figures.isEmpty

theorem eof_cross_iff {A : Type} (blanks : List A) (figures : List Deferred) :
    crossBeforeDropping blanks figures = true ↔ blanks ≠ [] ∧ figures ≠ [] := by
  cases blanks <;> cases figures <;> simp [crossBeforeDropping,List.isEmpty]

/-- FSwitchColumns judges geometry after flushDeferred. A usable base
    single column or the empty first column starts the set in place. -/
def switchHere (baseColumns column : Nat) (free : Int) (empty : Bool) : Bool :=
  (decide (baseColumns = 1) && decide (0 < free)) || (empty && decide (column = 0))

theorem switch_requires_page (baseColumns column : Nat) (free : Int) (empty : Bool) :
    switchHere baseColumns column free empty = false ↔
    (baseColumns ≠ 1 ∨ free ≤ 0) ∧ (empty = false ∨ column ≠ 0) := by
  cases empty <;> by_cases base : baseColumns = 1 <;> by_cases col : column = 0 <;>
    by_cases room : 0 < free <;> simp [switchHere,base,col,room] <;> omega

/-- waitFor merges counts with max and the lines-only requirement
    with disjunction. Both restrictions then apply at the first
    control's original page, column and slot offset. -/
def combineWait (a b : Int × Bool) : Int × Bool := (max a.1 b.1,a.2 || b.2)

theorem combined_count_met (a b : Int × Bool) (added : Int) :
    max 1 (combineWait a b).1 ≤ added ↔ max 1 a.1 ≤ added ∧ max 1 b.1 ≤ added := by
  unfold combineWait
  simp only
  omega

theorem combined_lines_only (a b : Int × Bool) :
    (combineWait a b).2 = true ↔ a.2 = true ∨ b.2 = true := by
  cases a with
  | mk n x =>
    cases b with
    | mk m y => cases x <;> cases y <;> simp [combineWait]

abbrev Address := Nat × Nat

/-- A space records the address reached by applyNeed. At a following
    block keep asks for the block's first part there and the original
    need-lines at each other address it visits. -/
def needAtBlock (cached here : Address) (first need : Int) :=
  if here = cached then first else need

theorem block_rejudges_after_move (cached here : Address) (first need : Int)
    (moved : here ≠ cached) :
    needAtBlock cached cached first need = first ∧ needAtBlock cached here first need = need := by
  simp [needAtBlock,moved]

/-- Multiple PageOut entries can share an address. checkNoBreak takes
    their maximum, never their sum. lines is the count after dropping
    the stored slot offset from that particular output entry. -/
def closedAdded (target : Address) : List (Address × Nat) → Nat
  | [] => 0
  | (addr,lines) :: rest =>
    if addr = target then max lines (closedAdded target rest) else closedAdded target rest

theorem closed_met_iff (target : Address) (done : List (Address × Nat)) (k : Nat) (positive : 0 < k) :
    k ≤ closedAdded target done ↔ ∃ lines, (target,lines) ∈ done ∧ k ≤ lines := by
  induction done with
  | nil => simp [closedAdded]; omega
  | cons entry rest ih =>
    rcases entry with ⟨addr,n⟩
    by_cases same : addr = target
    · subst addr
      simp only [closedAdded,if_true,List.mem_cons,Prod.mk.injEq,true_and]
      constructor
      · intro met
        by_cases first : k ≤ n
        · exact ⟨n,Or.inl rfl,first⟩
        · obtain ⟨v,mem,ok⟩ := ih.mp (by omega)
          exact ⟨v,Or.inr mem,ok⟩
      · rintro ⟨v,eq|mem,ok⟩
        · subst v; omega
        · have := ih.mpr ⟨v,mem,ok⟩; omega
    · have rev : target ≠ addr := Ne.symm same
      simp [closedAdded,same,rev,ih]

theorem checkNoBreak_result (target here : Address) (current k : Nat) (done : List (Address × Nat)) :
    max 1 k ≤ (if here = target then current else closedAdded target done) ↔
      (here = target ∧ max 1 k ≤ current) ∨
      (here ≠ target ∧ ∃ lines, (target,lines) ∈ done ∧ max 1 k ≤ lines) := by
  by_cases same : here = target
  · simp [same]
  · simp [same,closed_met_iff target done (max 1 k) (by omega)]

end BreakDispatch

/-- Admission of a regular or turned figure by place. Availability for
    a turned figure also requires the first column, zero used lines
    and no displayed or reserved footnotes. -/
def admitFigure (s : FlushState) (used : Nat) (noShown empty : Bool) (free : Int)
    (fig : Deferred) : List Deferred × FlushState :=
  let fits := match fig with
    | .figure _ height => decide ((height : Int) ≤ free) || empty
    | .turned _ => decide (s.geometry.column = 0 ∧ used = 0 ∧ s.geometry.noteLines = 0) && noShown
  if s.figures.isEmpty && fits then ([fig],s)
  else ([],{s with figures := s.figures ++ [fig]})

theorem figure_admission_fifo (s : FlushState) (used : Nat) (noShown empty : Bool) (free : Int)
    (fig : Deferred) :
    (admitFigure s used noShown empty free fig).1 ++ (admitFigure s used noShown empty free fig).2.figures =
      s.figures ++ [fig] := by
  unfold admitFigure
  dsimp only
  split
  · rename_i h
    have nil : s.figures = [] := by
      cases eq : s.figures with
      | nil => rfl
      | cons x xs => simp [eq,List.isEmpty] at h
    simp [nil]
  · rfl

/-- Each source figure first goes through admission; before the next
    source figure, body/table placement can cause any sequence of
    crossings. At EOF all outstanding figures go through that same
    queue. Geometry between source figures is supplied by the layout. -/
inductive FigureExecution : FlushState → List Deferred → List Deferred → FlushState → Prop where
  | finish {s emitted last} (run : Crossings s emitted last) : FigureExecution s [] emitted last
  | step (s used noShown empty free fig rest placed next) (afterBody : FlushState) (tail last)
      (run : Crossings (admitFigure s used noShown empty free fig).2 placed next)
      (bodyKeepsQueue : afterBody.figures = next.figures)
      (more : FigureExecution afterBody rest tail last) :
      FigureExecution s (fig :: rest) ((admitFigure s used noShown empty free fig).1 ++ placed ++ tail) last

theorem I5_source_figures_fifo {s last : FlushState} {input emitted : List Deferred}
    (execution : FigureExecution s input emitted last) :
    emitted ++ last.figures = s.figures ++ input := by
  induction execution with
  | finish run => simpa using crossings_fifo run
  | step s used noShown empty free fig rest placed next afterBody tail last run bodyKeepsQueue _ ih =>
    have crossing := crossings_fifo run
    have admission := figure_admission_fifo s used noShown empty free fig
    simp only [List.append_assoc] at *
    rw [ih, bodyKeepsQueue, ← List.append_assoc placed, crossing, ← List.append_assoc, admission]
    simp [List.append_assoc]

/-- Projection of the source tree onto the deferred-figure lane. FBoxed
    retains its nested source body, FFigure/FPageFigure each retain one
    item. Other constructors, including FWrapped, do not enqueue a new
    deferred figure. A sibling list uses nil/cons so recursion on deeply
    nested boxes has a structural measure independent of pagination. -/
inductive SourceFlow where
  | other
  | figure (f : Deferred)
  | box (children : SourceFlow)
  | nil
  | cons (first rest : SourceFlow)

def sourceFigures : SourceFlow → List Deferred
  | .other | .nil => []
  | .figure f => [f]
  | .box children => sourceFigures children
  | .cons first rest => sourceFigures first ++ sourceFigures rest

/-- The worklist follows placeAll and foldBody: entering a box visits its
    body before the enclosing suffix, and completes both exactly once. -/
def visitFlows : List SourceFlow → List Deferred
  | [] => []
  | .nil :: rest | .other :: rest => visitFlows rest
  | .figure f :: rest => f :: visitFlows rest
  | .box children :: rest => visitFlows (children :: rest)
  | .cons first more :: rest => visitFlows (first :: more :: rest)
termination_by pending => pending.foldr (fun flow total => sizeOf flow + total) 0
decreasing_by all_goals simp_wf; all_goals omega

theorem I5_box_dispatch (pending : List SourceFlow) :
    visitFlows pending = pending.bind sourceFigures := by
  cases pending with
  | nil => rw [visitFlows]; rfl
  | cons flow rest =>
    cases flow with
    | nil | other => rw [visitFlows,I5_box_dispatch rest]; rfl
    | figure f => rw [visitFlows,I5_box_dispatch rest]; rfl
    | box children =>
      rw [visitFlows,I5_box_dispatch (children :: rest)]; rfl
    | cons first more =>
      rw [visitFlows,I5_box_dispatch (first :: more :: rest)]
      change sourceFigures first ++ (sourceFigures more ++ _) = (sourceFigures first ++ sourceFigures more) ++ _
      rw [List.append_assoc]
termination_by pending.foldr (fun flow total => sizeOf flow + total) 0
decreasing_by all_goals simp_wf; all_goals omega

theorem I5_nested_source_fifo {s last : FlushState} {pending : List SourceFlow} {emitted : List Deferred}
    (run : FigureExecution s (visitFlows pending) emitted last) :
    emitted ++ last.figures = s.figures ++ pending.bind sourceFigures := by
  simpa [I5_box_dispatch] using I5_source_figures_fifo run

/-- Geometry is sampled anew after each crossing. The empty-column
    premise is the post-carry, pre-openBox condition of advance. -/
structure CrossingGeometry where
  cap : Nat
  sep : Nat
  free : Int
  empty : Bool

theorem drain_exists (geometry : FlushState → CrossingGeometry)
    (fresh : ∀ s : FlushState, s.notes = [] → s.geometry.columns ≤ s.geometry.column+1 →
      (geometry s).empty = true) (s : FlushState) :
    ∃ emitted last, Crossings s emitted last ∧ last.figures = [] ∧ last.notes = [] := by
  induction s using I4_flush_terminates.induction with
  | h s ih =>
    by_cases pending : s.figures ≠ [] ∨ s.notes ≠ []
    · let g := geometry s
      have step := FlushTransition.advance s g.cap g.sep g.free g.empty pending (fresh s)
      obtain ⟨out,last,run,figures,notes⟩ := ih _ step
      exact ⟨_,last,Crossings.next s g.cap g.sep g.free g.empty out last run,figures,notes⟩
    · have figures : s.figures = [] := Classical.byContradiction (fun n => pending (Or.inl n))
      have notes : s.notes = [] := Classical.byContradiction (fun n => pending (Or.inr n))
      exact ⟨[],s,Crossings.stop s,figures,notes⟩

/-- Unlike flushDeferred, flushFigures stops as soon as the figure
    queue empties. Pending notes may still be carried alongside the next
    wrapped figure. Cross only while there is a pending figure. -/
inductive FigureFlush (geometry : FlushState → CrossingGeometry) :
    FlushState → List Deferred → FlushState → Prop where
  | stop (s : FlushState) (done : s.figures = []) : FigureFlush geometry s [] s
  | cross (s : FlushState) (pending : s.figures ≠ []) (out : List Deferred)
      (last : FlushState)
      (rest : FigureFlush geometry
        (flushStep s (geometry s).cap (geometry s).sep (geometry s).free (geometry s).empty) out last) :
      FigureFlush geometry s
        ((placedOnAdvance s.geometry s.figures (geometry s).free (geometry s).empty).1 ++ out) last

theorem I4_flush_figures (geometry : FlushState → CrossingGeometry)
    (fresh : ∀ s : FlushState, s.notes = [] → s.geometry.columns ≤ s.geometry.column+1 →
      (geometry s).empty = true) (s : FlushState) :
    ∃ out last, FigureFlush geometry s out last ∧ last.figures = [] ∧ out = s.figures := by
  induction s using I4_flush_terminates.induction with
  | h s ih =>
    by_cases done : s.figures = []
    · exact ⟨[],s,.stop s done,done,done.symm⟩
    · let g := geometry s
      have step := FlushTransition.advance s g.cap g.sep g.free g.empty (Or.inl done) (fresh s)
      obtain ⟨out,last,run,empty,fifo⟩ := ih _ step
      have head := crossings_fifo (Crossings.next s g.cap g.sep g.free g.empty [] _
        (Crossings.stop (flushStep s g.cap g.sep g.free g.empty)))
      exact ⟨_,last,.cross s done out last run,empty,by simpa [fifo] using head⟩

theorem I5_flush_figures_keeps_pending_notes (geometry : FlushState → CrossingGeometry)
    (s : FlushState) (done : s.figures = []) {out last} (run : FigureFlush geometry s out last) :
    out = [] ∧ last = s := by
  cases run with
  | stop => exact ⟨rfl,rfl⟩
  | cross s pending => exact (pending done).elim

structure FigureGeometry where
  used : Nat
  noShown : Bool
  empty : Bool
  free : Int

/-- A finite sequence of intervening crossings is data, not a premise
    that the execution exists. Replay computes all emitted figures. -/
def replay (s : FlushState) : List CrossingGeometry → List Deferred × FlushState
  | [] => ([],s)
  | g :: gs =>
    let tail := replay (flushStep s g.cap g.sep g.free g.empty) gs
    ((placedOnAdvance s.geometry s.figures g.free g.empty).1 ++ tail.1,tail.2)

theorem replay_crossings (s : FlushState) (gs : List CrossingGeometry) :
    Crossings s (replay s gs).1 (replay s gs).2 := by
  induction gs generalizing s with
  | nil => exact Crossings.stop s
  | cons g gs ih => exact Crossings.next s g.cap g.sep g.free g.empty _ _ (ih _)

theorem figure_execution_exists (geometry : FlushState → CrossingGeometry)
    (fresh : ∀ s : FlushState, s.notes = [] → s.geometry.columns ≤ s.geometry.column+1 →
      (geometry s).empty = true)
    (admission : FlushState → Deferred → FigureGeometry)
    (cross : FlushState → Deferred → List CrossingGeometry)
    (bodyGeometry : FlushState → ColumnState) (bodyNotes : FlushState → List Part)
    (input : List Deferred) (s : FlushState) :
    ∃ emitted last, FigureExecution s input emitted last ∧
      last.notes = [] ∧ last.figures = [] ∧ emitted = s.figures ++ input := by
  induction input generalizing s with
  | nil =>
    obtain ⟨out,last,run,figures,notes⟩ := drain_exists geometry fresh s
    have fifo := crossings_fifo run
    exact ⟨out,last,.finish run,notes,figures,by simpa [figures] using fifo⟩
  | cons fig rest ih =>
    let a := admission s fig
    let enter := admitFigure s a.used a.noShown a.empty a.free fig
    let gs := cross enter.2 fig
    let next := (replay enter.2 gs).2
    let afterBody := {next with geometry := bodyGeometry next,notes := bodyNotes next}
    obtain ⟨out,last,more,notes,figures,_⟩ := ih afterBody
    have run := FigureExecution.step s a.used a.noShown a.empty a.free fig rest _ next afterBody
      out last (replay_crossings enter.2 gs) rfl more
    exact ⟨_,last,run,notes,figures,by simpa [figures] using I5_source_figures_fifo run⟩

/-- Operations in execution order, including crossings *before* the first
    figure or inside a box containing no figures. A body update changes only
    geometry and note state; an advance can discharge earlier figures. -/
inductive LayoutEvent where
  | figure (fig : Deferred) (g : FigureGeometry)
  | crossing (g : CrossingGeometry)
  | body (geometry : ColumnState) (notes : List Part)

def LayoutEvent.figures : LayoutEvent → List Deferred
  | .figure fig _ => [fig]
  | .crossing _ | .body _ _ => []

def LayoutEvent.perform (e : LayoutEvent) (s : FlushState) : List Deferred × FlushState :=
  match e with
  | .figure fig g => admitFigure s g.used g.noShown g.empty g.free fig
  | .crossing g => ((placedOnAdvance s.geometry s.figures g.free g.empty).1,
      flushStep s g.cap g.sep g.free g.empty)
  | .body geo notes => ([],{s with geometry := geo, notes := notes})

theorem LayoutEvent.preserve (e : LayoutEvent) (s : FlushState) :
    (e.perform s).1 ++ (e.perform s).2.figures = s.figures ++ e.figures := by
  cases e with
  | figure fig g => exact figure_admission_fifo s g.used g.noShown g.empty g.free fig
  | body geo notes => simp [perform,figures]
  | crossing g =>
    have h := crossings_fifo (Crossings.next s g.cap g.sep g.free g.empty [] _
      (Crossings.stop (flushStep s g.cap g.sep g.free g.empty)))
    simpa [perform,figures] using h

def performEvents (s : FlushState) : List LayoutEvent → List Deferred × FlushState
  | [] => ([],s)
  | e :: es =>
    let step := e.perform s
    let rest := performEvents step.2 es
    (step.1 ++ rest.1,rest.2)

theorem I5_events_fifo (s : FlushState) (es : List LayoutEvent) :
    (performEvents s es).1 ++ (performEvents s es).2.figures = s.figures ++ es.bind LayoutEvent.figures := by
  induction es generalizing s with
  | nil => simp [performEvents]
  | cons e es ih =>
    change ((e.perform s).1 ++ (performEvents (e.perform s).2 es).1) ++ (performEvents (e.perform s).2 es).2.figures = s.figures ++ (e.figures ++ es.bind _)
    rw [List.append_assoc, ih, ← List.append_assoc, e.preserve, List.append_assoc]

theorem I5_events_eof (geometry : FlushState → CrossingGeometry)
    (fresh : ∀ s : FlushState, s.notes = [] → s.geometry.columns ≤ s.geometry.column+1 →
      (geometry s).empty = true) (s : FlushState) (es : List LayoutEvent) :
    ∃ out last, Crossings (performEvents s es).2 out last ∧ last.notes = [] ∧
      last.figures = [] ∧ (performEvents s es).1 ++ out = s.figures ++ es.bind LayoutEvent.figures := by
  obtain ⟨out,last,run,figures,notes⟩ := drain_exists geometry fresh (performEvents s es).2
  have suffix := crossings_fifo run
  simp [figures] at suffix
  exact ⟨out,last,run,notes,figures,by rw [suffix]; exact I5_events_fifo s es⟩

/-- Hierarchical trace of layout. Before and after an enclosed body, box
    opening/closing may change geometry or advance; neither introduces a
    source figure. Each crossing is retained at its actual position. -/
inductive BodyEvent where
  | crossing (g : CrossingGeometry)
  | body (geometry : ColumnState) (notes : List Part)

def BodyEvent.layout : BodyEvent → LayoutEvent
  | .crossing g => .crossing g
  | .body geo notes => .body geo notes

inductive LayoutTrace where
  | body (e : BodyEvent)
  | figure (f : Deferred) (g : FigureGeometry)
  | nil
  | cons (first rest : LayoutTrace)
  | box (enter leave : BodyEvent) (children : LayoutTrace)

def LayoutTrace.events : LayoutTrace → List LayoutEvent
  | .body e => [e.layout]
  | .figure f g => [.figure f g]
  | .nil => []
  | .cons first rest => first.events ++ rest.events
  | .box enter leave children => enter.layout :: (children.events ++ [leave.layout])

def LayoutTrace.source : LayoutTrace → SourceFlow
  | .body _ => .other
  | .figure f _ => .figure f
  | .nil => .nil
  | .cons first rest => .cons first.source rest.source
  | .box _ _ children => .box children.source

theorem BodyEvent.no_source_figure (e : BodyEvent) : e.layout.figures = [] := by
  cases e <;> rfl

theorem LayoutTrace.event_source (t : LayoutTrace) :
    t.events.bind LayoutEvent.figures = sourceFigures t.source := by
  induction t with
  | nil | figure => rfl
  | body e => simp [events,source,sourceFigures,e.no_source_figure]
  | cons first rest left right => simp [events,source,sourceFigures,left,right]
  | box enter leave child inside =>
    simp [events,source,sourceFigures,inside,BodyEvent.no_source_figure]

theorem I5_box_event_positions (geometry : FlushState → CrossingGeometry)
    (fresh : ∀ s : FlushState, s.notes = [] → s.geometry.columns ≤ s.geometry.column+1 →
      (geometry s).empty = true) (s : FlushState) (tree : LayoutTrace) :
    ∃ out last, Crossings (performEvents s tree.events).2 out last ∧ last.notes = [] ∧
      last.figures = [] ∧ (performEvents s tree.events).1 ++ out =
        s.figures ++ sourceFigures tree.source := by
  simpa [tree.event_source] using I5_events_eof geometry fresh s tree.events

/-- placeAll [] advances once before flushing precisely when terminal
    blanks and deferred figures coexist. Recording dropped blank spans
    and resetting break controls do not modify the figure or note queue. -/
def endCrossings (terminalBlanks : Bool) (s : FlushState) (next : CrossingGeometry) :
    List CrossingGeometry :=
  if terminalBlanks && !s.figures.isEmpty then [next] else []

theorem I5_placeAll_eof (geometry : FlushState → CrossingGeometry)
    (fresh : ∀ s : FlushState, s.notes = [] → s.geometry.columns ≤ s.geometry.column+1 →
      (geometry s).empty = true) (s : FlushState) (terminalBlanks : Bool)
    (next : CrossingGeometry) :
    let beforeFlush := replay s (endCrossings terminalBlanks s next)
    ∃ out last, Crossings beforeFlush.2 out last ∧ last.figures = [] ∧ last.notes = [] ∧
        beforeFlush.1 ++ out = s.figures := by
  dsimp only
  let gs := endCrossings terminalBlanks s next
  obtain ⟨out,last,run,figures,notes⟩ := drain_exists geometry fresh (replay s gs).2
  have drained := crossings_fifo run
  simp [figures] at drained
  have earlier := crossings_fifo (replay_crossings s gs)
  exact ⟨out,last,run,figures,notes,by rw [drained]; exact earlier⟩

theorem I5_flow_events_and_terminal_blanks (geometry : FlushState → CrossingGeometry)
    (fresh : ∀ s : FlushState, s.notes = [] → s.geometry.columns ≤ s.geometry.column+1 →
      (geometry s).empty = true) (s : FlushState) (tree : LayoutTrace)
    (terminalBlanks : Bool) (next : CrossingGeometry) :
    let placed := performEvents s tree.events
    let beforeFlush := replay placed.2 (endCrossings terminalBlanks placed.2 next)
    ∃ out last, Crossings beforeFlush.2 out last ∧ last.figures = [] ∧ last.notes = [] ∧
      placed.1 ++ (beforeFlush.1 ++ out) = s.figures ++ sourceFigures tree.source := by
  dsimp only
  obtain ⟨out,last,run,figs,notes,fifo⟩ :=
    I5_placeAll_eof geometry fresh (performEvents s tree.events).2 terminalBlanks next
  exact ⟨out,last,run,figs,notes,by
    rw [fifo, ← tree.event_source]
    exact I5_events_fifo s tree.events⟩

/-- State inspected by placeDeferred after carryNote has visited all
    pending notes. A rejected note does not occupy the column; a shown
    part of zero lines still adds an entry to sNotes. -/
def carriedGeometry (cap sep : Nat) : Bool → ColumnState → List Part → Bool × ColumnState
  | empty, st, [] => (empty,st)
  | empty, st, p :: ps =>
    let room := carryRoom cap sep st
    if 0 < p.lines ∧ room = 0 ∧ empty = true ∧ st.reserved = 0 then
      carriedGeometry cap sep empty st ps
    else
      let shown := (carry room p).1
      let separator := if st.noteLines = 0 then sep else 0
      carriedGeometry cap sep false {st with noteLines := st.noteLines+separator+shown.lines} ps

/-- The typesetter's column capacity (including the box end reserve),
    top of a noninitial column set, and footnote separator suffice to
    derive free and isEmpty at placeDeferred before openBox. -/
structure FlushDimensions where
  cap : Int
  top : Nat
  separator : Nat

def measureCrossing (dims : FlushDimensions) (s : FlushState) : CrossingGeometry :=
  let next := advanceColumn s.geometry (splitTurned s.figures).1
  let carried := carriedGeometry dims.cap.toNat dims.separator true next s.notes
  let top := if s.geometry.columns ≤ s.geometry.column+1 then 0 else dims.top
  ⟨dims.cap.toNat,dims.separator,dims.cap - (top : Int) - (carried.2.noteLines : Int),carried.1⟩

/-- A negative effective capacity can occur inside a reserved area.
    Clamping capacity to zero before the note fold gives exactly the
    signed subtraction followed by max 0 in carryNote. -/
theorem I4_carry_room_toNat (cap : Int) (reserved separator : Nat) :
    availableForCarry (cap.toNat : Int) reserved separator =
      availableForCarry cap reserved separator := by
  unfold availableForCarry
  by_cases pos : 0 ≤ cap
  · simp [Int.toNat_of_nonneg pos]
  · have clamp (v : Int) (negative : v < 0) : v.toNat = 0 := by
      cases v with
      | ofNat n => exact False.elim (Int.not_lt.mpr (Int.ofNat_zero_le n) negative)
      | negSucc n => rfl
    rw [clamp cap (by omega),Int.ofNat_zero]
    rw [clamp (0 - (reserved : Int) - (separator : Int) - 1) (by omega)]
    exact (clamp _ (by omega)).symm

theorem I4_measured_crossing_fresh (dims : FlushDimensions) (s : FlushState)
    (noNotes : s.notes = []) : (measureCrossing dims s).empty = true := by
  simp [measureCrossing,noNotes,carriedGeometry]

/-- At a new page a diagnosed positive-length note takes no space.
    A zero-length note still has a displayed part, reserving a separator
    and preventing the oversize-figure fallback on an empty column. -/
example :
    let fresh : ColumnState := ⟨1,0,1,0,0⟩
    let dims : FlushDimensions := ⟨1,0,1⟩
    let rejected := measureCrossing dims ⟨fresh,[],[⟨4,0,2⟩]⟩
    let zero := measureCrossing dims ⟨fresh,[],[⟨4,0,0⟩]⟩
    rejected.empty = true ∧ rejected.free = 1 ∧ zero.empty = false ∧ zero.free = 0 := by decide

theorem I5_measured_flow_eof (dims : FlushState → FlushDimensions)
    (s : FlushState) (tree : LayoutTrace) (blanks : Bool) :
    let geometry := fun st => measureCrossing (dims st) st
    let placed := performEvents s tree.events
    let beforeFlush := replay placed.2 (endCrossings blanks placed.2 (geometry placed.2))
    ∃ out last, Crossings beforeFlush.2 out last ∧ last.figures = [] ∧ last.notes = [] ∧
      placed.1 ++ (beforeFlush.1 ++ out) = s.figures ++ sourceFigures tree.source :=
  I5_flow_events_and_terminal_blanks (fun st => measureCrossing (dims st) st)
    (fun st noNotes _ => I4_measured_crossing_fresh _ st noNotes) s tree blanks _

/-- The St fields read by cap/free/isEmpty during figure admission.
    A displayed note part has an entry even when it occupies zero lines. -/
structure AdmissionBox where
  top : Bool
  start : Nat
  before : Nat
  after : Nat

structure AdmissionColumn where
  capacity : Int
  adjust : Int
  firstLine : Nat
  used : Nat
  shownNotes : List Part
  box : Option AdmissionBox

def AdmissionColumn.measure (c : AdmissionColumn) (s : FlushState) : FigureGeometry :=
  let atBoxTop := c.box.elim false (fun b => b.top && decide (c.used = b.start + b.before))
  let boxAfter := c.box.elim 0 AdmissionBox.after
  ⟨c.used,c.shownNotes.isEmpty,c.shownNotes.isEmpty && (decide (c.used = c.firstLine) || atBoxTop),
    c.capacity + c.adjust - (boxAfter : Int) - (c.used : Int) - (s.geometry.noteLines : Int)⟩

def AdmissionColumn.figureNow (c : AdmissionColumn) (s : FlushState) (height : Nat) : Prop :=
  s.figures = [] ∧
    ((height : Int) ≤ c.capacity + c.adjust - ((c.box.elim 0 AdmissionBox.after : Nat) : Int) -
        (c.used : Int) - (s.geometry.noteLines : Int) ∨
      c.shownNotes = [] ∧ (c.used = c.firstLine ∨
        ∃ b, c.box = some b ∧ b.top = true ∧ c.used = b.start + b.before))

theorem I5_regular_admission_iff (c : AdmissionColumn) (s : FlushState) (id h : Nat) :
    let g := c.measure s
    (admitFigure s g.used g.noShown g.empty g.free (.figure id h)).1 = [.figure id h] ↔
      c.figureNow s h := by
  cases shape : c.box with
  | none =>
    cases queue : s.figures <;> cases shown : c.shownNotes <;>
      simp [AdmissionColumn.measure,AdmissionColumn.figureNow,admitFigure,shape,queue,shown,List.isEmpty] <;>
      split <;> simp_all
  | some b =>
    cases queue : s.figures <;> cases shown : c.shownNotes <;>
      simp [AdmissionColumn.measure,AdmissionColumn.figureNow,admitFigure,shape,queue,shown,List.isEmpty] <;>
      split <;> simp_all

theorem I5_turned_admission_iff (c : AdmissionColumn) (s : FlushState) (id : Nat) :
    let g := c.measure s
    (admitFigure s g.used g.noShown g.empty g.free (.turned id)).1 = [.turned id] ↔
      s.figures = [] ∧ s.geometry.column = 0 ∧ c.used = 0 ∧
        c.shownNotes = [] ∧ s.geometry.noteLines = 0 := by
  cases queue : s.figures <;> cases shown : c.shownNotes <;>
    simp [admitFigure,AdmissionColumn.measure,queue,shown,List.isEmpty] <;> split <;> simp_all

/-- placeKept can evaluate several candidate layouts from the original
    immutable state. The output is only that of its selected candidate.
    Items may be individual paragraph lines or whole verse lines. -/
def keptSplitAt (len first last : Nat) (allLines : Bool) : Nat :=
  len - (if allLines || decide (len ≤ last ∨ len < first+last) then len else last)

def chooseKeptLayout {α σ : Type} (place : σ → Bool → List α → σ) (nextColumn : σ → σ)
    (fits empty : σ → Bool) (sameColumn : σ → σ → Bool) (first last : Nat)
    (allLines start : Bool) (s : σ) (xs : List α) : σ :=
  let whole := place s start xs
  let cut := keptSplitAt xs.length first last allLines
  let front := xs.take cut
  let back := xs.drop cut
  let prefixState := place s start front
  let backStart := start && front.isEmpty
  let here := place prefixState backStart back
  if fits whole then whole
  else if sameColumn here prefixState && fits here then here
  else if empty prefixState then whole else place (nextColumn prefixState) backStart back

theorem I5_kept_layout_emits_once {α σ β : Type} (place : σ → Bool → List α → σ)
    (nextColumn : σ → σ) (fits empty : σ → Bool) (sameColumn : σ → σ → Bool)
    (visible : σ → List β) (contents : α → List β)
    (placeKeeps : ∀ s start xs, visible (place s start xs) = visible s ++ xs.bind contents)
    (crossKeeps : ∀ s, visible (nextColumn s) = visible s)
    (first last : Nat) (allLines start : Bool) (s : σ) (xs : List α) :
    visible (chooseKeptLayout place nextColumn fits empty sameColumn first last allLines start s xs) =
      visible s ++ xs.bind contents := by
  have partition (k : Nat) : (xs.take k).bind contents ++ (xs.drop k).bind contents = xs.bind contents := by
    induction k generalizing xs with
    | zero => simp
    | succ k ih => cases xs with
      | nil => simp
      | cons x xs => simpa [List.bind,List.append_assoc] using congrArg (fun ys => contents x ++ ys) (ih xs)
  unfold chooseKeptLayout
  dsimp only
  split
  · exact placeKeeps _ _ _
  · split
    · simp only [placeKeeps,List.append_assoc,partition]
    · split
      · exact placeKeeps _ _ _
      · simp only [placeKeeps,crossKeeps,List.append_assoc,partition]

/-- Decide.splitAtBreak for either physical lines or stanza verse lines.
    Prove the maximal *unforced* choice; placeLines separately allows
    its forced first part in an empty or heading-only column. -/
def keptBreakCount (first last n fitting : Nat) (allLines start : Bool) : Nat :=
  if n ≤ fitting then fitting
  else if allLines then 0
  else
    let k := if n-fitting < last then n-last else fitting
    if start && decide (0 < k ∧ k < first) then 0 else k

def legalPartial (first last n fitting k : Nat) (allLines start : Bool) : Prop :=
  k = 0 ∨ (allLines = false ∧ k ≤ fitting ∧ last ≤ n-k ∧ (start = true → first ≤ k))

theorem I3_kept_break_is_largest (first last n fitting : Nat) (allLines start : Bool)
    (partialFit : fitting < n) :
    let k := keptBreakCount first last n fitting allLines start
    legalPartial first last n fitting k allLines start ∧
      ∀ j, legalPartial first last n fitting j allLines start → j ≤ k := by
  cases allLines <;> cases start <;>
    simp [keptBreakCount,legalPartial,Nat.not_le_of_lt partialFit] <;>
    repeat' first | split | apply And.intro | intro
  all_goals omega

/-- A stanza counts whole verse lines by their cumulative physical
    line lengths. Reaching the end of the available room exactly fits;
    an empty verse line is counted even with zero room. -/
def fittingVerses {α : Type} (room : Nat) : List (List α) → Nat
  | [] => 0
  | v :: rest => if v.length ≤ room then 1 + fittingVerses (room-v.length) rest else 0

def verseEnds {α : Type} (used : Nat) : List (List α) → List Nat
  | [] => []
  | v :: rest => (used+v.length) :: verseEnds (used+v.length) rest

theorem I3_fitting_verses_scan {α : Type} (vs : List (List α)) (used room : Nat) :
    ((verseEnds used vs).takeWhile (fun n => decide (n ≤ used+room))).length =
      fittingVerses room vs := by
  induction vs generalizing used room with
  | nil => rfl
  | cons v rest ih =>
    by_cases fits : v.length ≤ room
    · have bound : used+v.length ≤ used+room := by omega
      have total : used+v.length+(room-v.length) = used+room := by omega
      have tail := ih (used+v.length) (room-v.length)
      rw [total] at tail
      simp [verseEnds,fittingVerses,fits,bound,List.takeWhile,tail] <;> omega
    · have beyond : ¬used+v.length ≤ used+room := by omega
      simp [verseEnds,fittingVerses,fits,beyond,List.takeWhile]

theorem I3_fitting_verses_maximal {α : Type} (vs : List (List α)) (room : Nat) :
    let k := fittingVerses room vs
    (vs.take k).join.length ≤ room ∧
      (∀ next, (vs.drop k).head? = some next → room < (vs.take k).join.length + next.length) := by
  induction vs generalizing room with
  | nil => simp [fittingVerses]
  | cons v rest ih =>
    by_cases fits : v.length ≤ room
    · simp only [fittingVerses,if_pos fits,Nat.one_add,List.take,List.drop,List.join,List.length_append]
      obtain ⟨within,over⟩ := ih (room-v.length)
      constructor
      · omega
      · intro next atNext
        have h := over next atNext
        omega
    · simp [fittingVerses,fits]
      omega

/-- Exact charge of FSpace. A box part begins at start+before even when
    it did not open at column top; isEmpty has a different box guard. -/
def AdmissionColumn.chargeSpace (c : AdmissionColumn) (s : FlushState) (requested : Int) : Nat :=
  let boxStart := c.box.elim false (fun b => decide (c.used = b.start+b.before))
  (BreakDispatch.charged (decide (c.used = c.firstLine)) boxStart requested (c.measure s).free).toNat

def AdmissionColumn.placeSpace (c : AdmissionColumn) (s : FlushState) (requested : Int) :
    AdmissionColumn × (Int × Nat) :=
  let actual := c.chargeSpace s requested
  ({c with used := c.used+actual}, (requested,actual))

theorem I3_space_reduces_actual_free (c : AdmissionColumn) (s : FlushState) (n : Int) :
    let step := c.placeSpace s n
    (step.1.measure s).free = (c.measure s).free - (step.2.2 : Int) := by
  simp [AdmissionColumn.placeSpace,AdmissionColumn.measure,Int.ofNat_add]
  omega

/-- Replay uses requests, since the destination column has its own
    capacity, footnotes and top; remember the new actual charge. -/
def replayRequestedSpaces (s : FlushState) (c : AdmissionColumn) :
    List Int → AdmissionColumn × List (Int × Nat)
  | [] => (c,[])
  | n :: ns =>
    let placed := c.placeSpace s n
    let rest := replayRequestedSpaces s placed.1 ns
    (rest.1,placed.2 :: rest.2)

theorem I3_replayed_space_charges (s : FlushState) (c : AdmissionColumn) (ns : List Int) :
    let done := replayRequestedSpaces s c ns
    done.2.map Prod.fst = ns ∧ done.1.used = c.used + done.2.foldr (fun entry total => entry.2 + total) 0 := by
  induction ns generalizing c with
  | nil => simp [replayRequestedSpaces,List.foldr]
  | cons n ns ih =>
    have h := ih (c.placeSpace s n).1
    simp only [replayRequestedSpaces,List.map_cons,List.foldr,AdmissionColumn.placeSpace] at h ⊢
    obtain ⟨requests,actual⟩ := h
    simp [requests,actual,Nat.add_assoc]

theorem I3_replay_on_column_top (s : FlushState) (c : AdmissionColumn) (ns : List Int)
    (top : c.used = c.firstLine) :
    (replayRequestedSpaces s c ns).1.used = c.used := by
  induction ns with
  | nil => rfl
  | cons n ns ih =>
    have zero : c.chargeSpace s n = 0 := by
      simp [AdmissionColumn.chargeSpace,top,BreakDispatch.charged]
    simpa [replayRequestedSpaces,AdmissionColumn.placeSpace,zero] using ih

/-- The constructors of Flow that do not introduce an FFigure or an
    FPageFigure. FWrapped places its own slot, not a deferred figure. -/
inductive BodyKind where
  | paragraph | stanza | heading | defTerm | wrapped | continued | table
  | space | forcedBreak | section | keepNext | code | ruled | switchColumns
  | restoreColumns | noBreak | needLines | adjustLines | blank

/-- Measured body operations retain their positions relative to admission
    and box entry/exit. Geometry is sampled from the state at each step. -/
abbrev BodyAction := FlushState → BodyEvent

inductive MeasuredFlow where
  | body (kind : BodyKind) (ops : List BodyAction)
  | figure (id height : Nat) (breaks controls after : List BodyAction)
      (geometry : FlushState → AdmissionColumn)
  | pageFigure (id : Nat) (breaks controls after : List BodyAction)
      (geometry : FlushState → AdmissionColumn)
  | boxed (enter leave : List BodyAction) (children : MeasuredFlow)
  | nil
  | cons (first rest : MeasuredFlow)

def runBodyActions (s : FlushState) : List BodyAction → List LayoutEvent
  | [] => []
  | f :: fs =>
    let e := (f s).layout
    e :: runBodyActions (e.perform s).2 fs

theorem runBodyActions_no_figures (s : FlushState) (fs : List BodyAction) :
    (runBodyActions s fs).bind LayoutEvent.figures = [] := by
  induction fs generalizing s with
  | nil => rfl
  | cons f fs ih => simp [runBodyActions,BodyEvent.no_source_figure,ih]

theorem performEvents_append_state (s : FlushState) (xs ys : List LayoutEvent) :
    (performEvents s (xs ++ ys)).2 = (performEvents (performEvents s xs).2 ys).2 := by
  induction xs generalizing s with
  | nil => rfl
  | cons x xs ih => simpa [performEvents] using ih (x.perform s).2

def measuredAdmission (s : FlushState) (fig : Deferred) (before after : List BodyAction)
    (geometry : FlushState → AdmissionColumn) : List LayoutEvent :=
  let prep := runBodyActions s before
  let ready := (performEvents s prep).2
  let e := LayoutEvent.figure fig ((geometry ready).measure ready)
  prep ++ e :: runBodyActions (e.perform ready).2 after

/-- step first applies pending breaks and then evaluates waitsBehind.
    A waiting figure skips needBefore/placeBlank entirely. A regular
    first figure that does not fit still visits those controls; turned
    figures skip them unless they can take the empty page immediately. -/
def figureWaitsBehind (s : FlushState) (c : AdmissionColumn) : Deferred → Bool
  | .figure _ _ => !s.figures.isEmpty
  | .turned _ => !(s.figures.isEmpty && decide (s.geometry.column = 0 ∧ c.used = 0 ∧
      c.shownNotes = [] ∧ s.geometry.noteLines = 0))

def dispatchFigure (s : FlushState) (fig : Deferred) (breaks controls after : List BodyAction)
    (geometry : FlushState → AdmissionColumn) : List LayoutEvent :=
  let prefixEvents := runBodyActions s breaks
  let ready := (performEvents s prefixEvents).2
  let before := if figureWaitsBehind ready (geometry ready) fig then [] else controls
  prefixEvents ++ measuredAdmission ready fig before after geometry

def MeasuredFlow.events (s : FlushState) : MeasuredFlow → List LayoutEvent
  | .nil => []
  | .body _ ops => runBodyActions s ops
  | .figure id h breaks controls after g => dispatchFigure s (.figure id h) breaks controls after g
  | .pageFigure id breaks controls after g => dispatchFigure s (.turned id) breaks controls after g
  | .cons f rest =>
    let es := f.events s
    es ++ rest.events (performEvents s es).2
  | .boxed enter leave children =>
    let prep := runBodyActions s enter
    let inside := children.events (performEvents s prep).2
    prep ++ inside ++ runBodyActions (performEvents s (prep ++ inside)).2 leave

def MeasuredFlow.figures : MeasuredFlow → List Deferred
  | .nil | .body _ _ => []
  | .figure id h _ _ _ _ => [.figure id h]
  | .pageFigure id _ _ _ _ => [.turned id]
  | .boxed _ _ children => children.figures
  | .cons f rest => f.figures ++ rest.figures

theorem measuredAdmission_single (s : FlushState) (fig : Deferred) (before after : List BodyAction)
    (g : FlushState → AdmissionColumn) :
    (measuredAdmission s fig before after g).bind LayoutEvent.figures = [fig] := by
  simp [measuredAdmission,runBodyActions_no_figures,LayoutEvent.figures]

theorem dispatchFigure_single (s : FlushState) (fig : Deferred)
    (breaks controls after : List BodyAction) (g : FlushState → AdmissionColumn) :
    (dispatchFigure s fig breaks controls after g).bind LayoutEvent.figures = [fig] := by
  simp [dispatchFigure,runBodyActions_no_figures,measuredAdmission_single]

theorem I5_measured_flow_source (s : FlushState) (flow : MeasuredFlow) :
    (flow.events s).bind LayoutEvent.figures = flow.figures := by
  induction flow generalizing s with
  | nil => rfl
  | body _ fs => exact runBodyActions_no_figures s fs
  | figure id h breaks controls after g => exact dispatchFigure_single s _ breaks controls after g
  | pageFigure id breaks controls after g => exact dispatchFigure_single s _ breaks controls after g
  | cons f rest first tail => simp [MeasuredFlow.events,MeasuredFlow.figures,first,tail]
  | boxed enter leave children ih =>
    simp [MeasuredFlow.events,MeasuredFlow.figures,runBodyActions_no_figures,ih]

theorem I5_all_measured_flows_eof (dims : FlushState → FlushDimensions)
    (s : FlushState) (flow : MeasuredFlow) (blanks : Bool) :
    let placed := performEvents s (flow.events s)
    let beforeFlush := replay placed.2
      (endCrossings blanks placed.2 (measureCrossing (dims placed.2) placed.2))
    ∃ out last, Crossings beforeFlush.2 out last ∧ last.figures = [] ∧ last.notes = [] ∧
      placed.1 ++ (beforeFlush.1 ++ out) = s.figures ++ flow.figures := by
  dsimp only
  let placed := performEvents s (flow.events s)
  obtain ⟨out,last,run,figs,notes,fifo⟩ := I5_placeAll_eof
    (fun st => measureCrossing (dims st) st)
    (fun st noNotes _ => I4_measured_crossing_fresh _ st noNotes) placed.2 blanks
    (measureCrossing (dims placed.2) placed.2)
  exact ⟨out,last,run,figs,notes,by
    rw [fifo, ← I5_measured_flow_source s flow]
    exact I5_events_fifo s (flow.events s)⟩

end TableAdvance


/- The figure-only projection of a pagination state. Sending the next
   figure adds it to the FIFO waiting queue; emitting the queue's head
   appends it to the output. `placed ++ waiting ++ remaining` is the
   input order throughout those two transitions. -/
structure FigureState where
  placed : List Nat
  waiting : List Nat
  remaining : List Nat

def figureTrace (s : FigureState) : List Nat :=
  s.placed ++ s.waiting ++ s.remaining

def sendFigure (s : FigureState) : FigureState :=
  match s.remaining with
  | [] => s
  | x :: rest => { s with waiting := s.waiting ++ [x], remaining := rest }

def emitFigure (s : FigureState) : FigureState :=
  match s.waiting with
  | [] => s
  | x :: rest => { s with placed := s.placed ++ [x], waiting := rest }

theorem I5_sendFigure_preserves_trace (s : FigureState) :
    figureTrace (sendFigure s) = figureTrace s := by
  cases s with
  | mk placed waiting remaining =>
    cases remaining <;> simp [sendFigure, figureTrace, List.append_assoc]

theorem I5_emitFigure_preserves_trace (s : FigureState) :
    figureTrace (emitFigure s) = figureTrace s := by
  cases s with
  | mk placed waiting remaining =>
    cases waiting <;> simp [emitFigure, figureTrace, List.append_assoc]

def figureRank (s : FigureState) : Nat :=
  2 * s.remaining.length + s.waiting.length

theorem I4_sendFigure_decreases (s : FigureState) (nonempty : s.remaining ≠ []) :
    figureRank (sendFigure s) < figureRank s := by
  cases s with
  | mk placed waiting remaining =>
    cases remaining with
    | nil => contradiction
    | cons x rest => simp [sendFigure, figureRank, List.length_append]; omega

theorem I4_emitFigure_decreases (s : FigureState) (nonempty : s.waiting ≠ []) :
    figureRank (emitFigure s) < figureRank s := by
  cases s with
  | mk placed waiting remaining =>
    cases waiting with
    | nil => contradiction
    | cons x rest => simp [emitFigure, figureRank, List.length_append]; omega

def drainFigures (s : FigureState) : List Nat :=
  if _waiting : s.waiting ≠ [] then
    drainFigures (emitFigure s)
  else if _remaining : s.remaining ≠ [] then
    drainFigures (sendFigure s)
  else
    s.placed
termination_by figureRank s
decreasing_by
  all_goals simp_wf
  · exact I4_emitFigure_decreases _ _waiting
  · exact I4_sendFigure_decreases _ _remaining

theorem I5_drainFigures_exact (s : FigureState) :
    drainFigures s = figureTrace s := by
  by_cases waiting : s.waiting ≠ []
  · calc
      drainFigures s = drainFigures (emitFigure s) := by
        rw [drainFigures]
        simp [waiting]
      _ = figureTrace (emitFigure s) := I5_drainFigures_exact (emitFigure s)
      _ = figureTrace s := I5_emitFigure_preserves_trace s
  · by_cases remaining : s.remaining ≠ []
    · calc
        drainFigures s = drainFigures (sendFigure s) := by
          rw [drainFigures]
          simp [waiting, remaining]
        _ = figureTrace (sendFigure s) := I5_drainFigures_exact (sendFigure s)
        _ = figureTrace s := I5_sendFigure_preserves_trace s
    · have waitingEmpty : s.waiting = [] := by
        cases h : s.waiting with
        | nil => rfl
        | cons x xs => exact False.elim (waiting (by simp [h]))
      have remainingEmpty : s.remaining = [] := by
        cases h : s.remaining with
        | nil => rfl
        | cons x xs => exact False.elim (remaining (by simp [h]))
      simp [drainFigures, waitingEmpty, remainingEmpty, figureTrace]
termination_by figureRank s
decreasing_by
  · exact I4_emitFigure_decreases _ waiting
  · exact I4_sendFigure_decreases _ remaining


/- In the ADR 0206 domain, deleting the single optional figure leaves an
   ordered list of text items. Texts are identified by their zero-based
   ranks. A figure at rank f precedes text t exactly when f ≤ t. Size zero
   encodes absence, since every actual figure has positive size. -/
structure RectoInput where
  cap : Nat
  used : Nat
  texts : Nat
  figureRank : Nat
  figureSize : Nat
  heading : Nat → Prop
  line : Nat → Prop
  recto : Nat → Prop
  paragraph : List ParagraphBoundary
  headingsNotLines : ∀ t, heading t → ¬ line t
  rectosHeadings : ∀ t, recto t → heading t
  paragraphFirst : ∀ p ∈ paragraph, line p.firstPos
  paragraphOrder : ∀ p ∈ paragraph, p.firstPos ≤ p.beforeLastPos
  figureFits : figureSize ≤ cap
  usedFits : used ≤ cap

namespace RectoInput
def kept (d : RectoInput) (b : Nat) : Prop :=
  0 < d.figureSize ∧ d.figureRank ≤ b ∧ d.used + d.figureRank + d.figureSize ≤ d.cap

def starts (d : RectoInput) (b t : Nat) : Prop :=
  d.used = 0 ∧ t = 0 ∧ (d.kept b → t < d.figureRank)

def afterHeads (d : RectoInput) (b t : Nat) : Prop :=
  d.used = 0 ∧ (∀ u, u < t → u < b → d.heading u) ∧
    (d.kept b → t < d.figureRank)

def base (d : RectoInput) (b : Nat) : Prop :=
  b ≤ d.texts ∧ d.used + b ≤ d.cap ∧
  (d.kept b → d.used + b + d.figureSize ≤ d.cap) ∧
  (d.kept b → d.figureRank ≤ b) ∧
  (d.used = 0 → 0 < d.figureSize → d.figureRank = 0 → d.kept b) ∧
  (d.used = 0 → 0 < d.texts → (d.figureSize = 0 ∨ 0 < d.figureRank) → 0 < b)

def lineAfter (d : RectoInput) (b : Nat) : Prop :=
  d.used = 0 → 0 < b → ¬ d.kept b →
    (∀ t, t < b → d.heading t) → b < d.texts → ¬ d.line b

def orphanH (d : RectoInput) (b : Nat) : Prop :=
  ∀ p ∈ d.paragraph, 2 ≤ p.lineCount → p.firstPos < b → b ≤ p.secondPos →
    d.afterHeads b p.firstPos

def widowH (d : RectoInput) (b : Nat) : Prop :=
  ∀ p ∈ d.paragraph, 2 ≤ p.lineCount → p.beforeLastPos < b → b ≤ p.lastPos →
    d.afterHeads b p.firstPos

/- These sufficient conditions make both heading-run variants hold,
   independently of the length of the heading run and the kept lines. -/
def feasible (d : RectoInput) (b : Nat) : Prop :=
  d.base b ∧ d.lineAfter b ∧ d.orphanH b ∧ d.widowH b ∧
  (∀ t, t < b → d.heading t → d.starts b t)

private theorem feasible_of_prefix (d : RectoInput) (b : Nat)
    (base : d.base b) (after : d.lineAfter b)
    (paragraphStart : ∀ t, t < b → d.line t → d.afterHeads b t)
    (heads : ∀ t, t < b → d.heading t → d.starts b t) : d.feasible b := by
  refine ⟨base, after, ?_, ?_, heads⟩
  · intro p member _ here _
    exact paragraphStart _ here (d.paragraphFirst p member)
  · intro p member _ here _
    exact paragraphStart _ (Nat.lt_of_le_of_lt (d.paragraphOrder p member) here)
      (d.paragraphFirst p member)

theorem feasible_exists (d : RectoInput) (twoFit : 2 ≤ d.cap) :
    ∃ b, d.feasible b := by
  by_cases zeroBreak : d.used ≠ 0 ∨ d.texts = 0 ∨
      (0 < d.figureSize ∧ d.figureRank = 0)
  · refine ⟨0, feasible_of_prefix d 0 ?_ ?_ ?_ ?_⟩
    · refine ⟨by omega, by simpa using d.usedFits, ?_, fun k => k.2.1, ?_, ?_⟩
      · intro k
        have room := k.2.2
        omega
      · intro empty pos rank
        exact ⟨pos, by omega, by simpa [empty, rank] using d.figureFits⟩
      · intro empty nonempty first
        omega
    · intro _ positive
      omega
    · intro t here
      omega
    · intro t here
      omega
  · have empty : d.used = 0 := by apply Classical.byContradiction; intro h; exact zeroBreak (Or.inl h)
    have nonempty : 0 < d.texts := by
      apply Classical.byContradiction
      intro h
      exact zeroBreak (Or.inr (Or.inl (by omega)))
    have firstText : d.figureSize = 0 ∨ 0 < d.figureRank := by
      apply Classical.byContradiction
      intro h
      exact zeroBreak (Or.inr (Or.inr ⟨by omega, by omega⟩))
    have startsZero : ∀ b, d.starts b 0 := by
      intro b
      refine ⟨empty, rfl, ?_⟩
      intro k
      have positive := k.1
      omega
    by_cases two : 1 < d.texts ∧ d.heading 0 ∧ d.line 1 ∧ ¬ d.kept 1
    · obtain ⟨texts, heading, line, sent⟩ := two
      have keptAfter : d.kept 2 → d.figureRank = 2 := by
        intro k
        apply Classical.byContradiction
        intro h
        exact sent ⟨k.1, by have := k.2.1; omega, k.2.2⟩
      refine ⟨2, feasible_of_prefix d 2 ?_ ?_ ?_ ?_⟩
      · refine ⟨by omega, by omega, ?_, fun k => k.2.1, ?_, by intros; decide⟩
        · intro k
          simpa [keptAfter k] using k.2.2
        · intro _ pos rank
          omega
      · intro _ _ _ allHeadings
        exact (d.headingsNotLines 1 (allHeadings 1 (by decide)) line).elim
      · intro t here _
        refine ⟨empty, ?_, ?_⟩
        · intro u before _
          have : u = 0 := by omega
          simpa [this] using heading
        · intro k
          rw [keptAfter k]
          omega
      · intro t here tHead
        have tZero : t = 0 := by
          apply Classical.byContradiction
          intro h
          have : t = 1 := by omega
          exact d.headingsNotLines 1 (this ▸ tHead) line
        exact tZero ▸ startsZero 2
    · refine ⟨1, feasible_of_prefix d 1 ?_ ?_ ?_ ?_⟩
      · refine ⟨by omega, by omega, ?_, fun k => k.2.1, ?_, by intros; decide⟩
        · intro k
          have pos := k.1
          have bound := k.2.1
          have rank : d.figureRank = 1 := by omega
          simpa [rank] using k.2.2
        · intro _ pos rank
          omega
      · intro _ _ sent heads more line
        exact two ⟨more, heads 0 (by decide), line, sent⟩
      · intro t here _
        have eq : t = 0 := by omega
        subst t
        exact ⟨empty, by intros; omega, (startsZero 1).2.2⟩
      · intro t here _
        have eq : t = 0 := by omega
        exact eq ▸ startsZero 1
/- The explicit keep flag ranges over both choices of the Alloy placement.
   A figure occupies slot 2*f just before text f at slot 2*f+1.
   Thus intervals in headingRunKeep include the intervening figure. -/
def itemAt (d : RectoInput) (pos : Nat) : Prop :=
  (∃ t, t < d.texts ∧ pos = 2*t+1) ∨
    (0 < d.figureSize ∧ pos = 2*d.figureRank)

def basePlacement (d : RectoInput) (b : Nat) (keep : Bool) : Prop :=
  b ≤ d.texts ∧ (keep = true ↔ d.kept b) ∧
    d.used + b + (if keep then d.figureSize else 0) ≤ d.cap ∧
    (keep = true → d.figureRank ≤ b) ∧
    (d.used = 0 → 0 < d.figureSize → d.figureRank = 0 → keep = true) ∧
    (d.used = 0 → 0 < d.texts → (d.figureSize = 0 ∨ 0 < d.figureRank) → 0 < b)

def headingRule (d : RectoInput) (b : Nat) (heading : Nat → Prop)
    (linesKept : Nat → Prop) : Prop :=
  headingRunKeep d.itemAt (fun p => ∃ t, t < d.texts ∧ p = 2*t+1)
    (fun p => ∃ t, t < d.texts ∧ p = 2*t+1 ∧ heading t)
    (fun p => p / 2 < b) (fun p => d.starts b (p / 2))
    (fun p => d.line (p / 2)) linesKept

theorem placement_of_feasible (d : RectoInput) (b : Nat) (ok : d.feasible b) :
    ∃ keep, d.basePlacement b keep := by
  obtain ⟨bounds, room, fits, order, firstFigure, firstText⟩ := ok.1
  by_cases k : d.kept b
  · exact ⟨true, bounds, by simp [k], by simpa using fits k,
      fun _ => order k, by intros; rfl, firstText⟩
  · exact ⟨false, bounds, by simp [k], by simpa using room,
      by simp, fun empty pos rank => (k (firstFigure empty pos rank)).elim,
      firstText⟩

theorem headings_of_feasible (d : RectoInput) (b : Nat) (ok : d.feasible b)
    (heading linesKept : Nat → Prop) (subset : ∀ h, heading h → d.heading h) :
    d.headingRule b heading linesKept := by
  intro p eligible here inside
  obtain ⟨t, _, position, head⟩ := eligible
  subst p
  have rank : (2*t+1) / 2 = t := by omega
  change (2*t+1) / 2 < b at here
  change ¬ d.starts b ((2*t+1) / 2) at inside
  rw [rank] at here inside
  exact (inside (ok.2.2.2.2 t here (subset t head))).elim

end RectoInput

/- Alloy's "no placement" has no witness: for each input there is a
   placement satisfying all the predicates. keptLines may be any predicate,
   which includes the paragraph-dependent keptLines of ADR 0021. -/
theorem I3_rectoKept (d : RectoInput) (twoFit : 2 ≤ d.cap)
    (keptLines : Nat → Prop) :
    ∃ b keep, d.basePlacement b keep ∧ d.orphanH b ∧ d.widowH b ∧
      d.headingRule b d.heading keptLines ∧ d.lineAfter b ∧
      (∀ t, t < b → d.recto t → d.starts b t) := by
  obtain ⟨b, ok⟩ := d.feasible_exists twoFit
  obtain ⟨keep, base⟩ := d.placement_of_feasible b ok
  exact ⟨b, keep, base, ok.2.2.1, ok.2.2.2.1,
    d.headings_of_feasible b ok d.heading keptLines (fun _ h => h),
    ok.2.1, fun t here r => ok.2.2.2.2 t here (d.rectosHeadings t r)⟩

theorem I3_rectoEnds (d : RectoInput) (twoFit : 2 ≤ d.cap)
    (keptLines : Nat → Prop) :
    ∃ b keep, d.basePlacement b keep ∧ d.orphanH b ∧ d.widowH b ∧
      d.headingRule b (fun t => d.heading t ∧ ¬ d.recto t) keptLines ∧
      d.lineAfter b ∧ (∀ t, t < b → d.recto t → d.starts b t) := by
  obtain ⟨b, ok⟩ := d.feasible_exists twoFit
  obtain ⟨keep, base⟩ := d.placement_of_feasible b ok
  exact ⟨b, keep, base, ok.2.2.1, ok.2.2.2.1,
    d.headings_of_feasible b ok _ keptLines (fun _ h => h.1),
    ok.2.1, fun t here r => ok.2.2.2.2 t here (d.rectosHeadings t r)⟩

theorem I3_relaxedAfterHeadings (d : RectoInput) (twoFit : 2 ≤ d.cap)
    (keptLines : Nat → Prop) :
    ∃ b keep, d.basePlacement b keep ∧ d.orphanH b ∧ d.widowH b ∧
      d.headingRule b d.heading keptLines ∧ d.lineAfter b := by
  obtain ⟨b, keep, base, orphan, widow, heading, after, _⟩ := I3_rectoKept d twoFit keptLines
  exact ⟨b, keep, base, orphan, widow, heading, after⟩


/-- The source payload carried by boxes; unlike kinds alone, this keeps
    every item identity and its measured data. Glue and penalties are
    not text boxes and are not part of this projection. -/
def captionBoxes {α : Type} (kind : α → CaptionItemKind) (items : List α) : List α :=
  items.filter (fun item => kind item == .box)


private theorem captionBoxes_append {α : Type} (kind : α → CaptionItemKind)
    (xs ys : List α) :
    captionBoxes kind (xs ++ ys) = captionBoxes kind xs ++ captionBoxes kind ys := by
  induction xs with
  | nil => rfl
  | cons h t ih =>
    simp only [List.cons_append,captionBoxes,List.filter_cons] at *
    split <;> simp_all

/-- The actual after/skip scan stops at the first box or forced penalty.
    In particular it cannot hide a source box, even after arbitrary
    glue and optional penalty runs. -/
theorem I1_caption_discard_preserves_boxes {α : Type} (kind : α → CaptionItemKind)
    (items : List α) :
    captionBoxes kind (items.drop (captionDiscardCount (items.map kind))) =
      captionBoxes kind items := by
  induction items with
  | nil => rfl
  | cons h t ih =>
    cases eq : kind h with
    | box => simp [captionDiscardCount,eq]
    | glue => simpa [captionDiscardCount,eq,Nat.one_add,captionBoxes] using ih
    | penalty value flag =>
      by_cases forced : value ≤ -10000
      · simp [captionDiscardCount,eq,forced]
      · simpa [captionDiscardCount,eq,forced,Nat.one_add,captionBoxes] using ih

/-- A concrete source decomposition at each chosen break. The break
    item cannot be a box (isBreak only admits glue or penalties); the
    suffix starts exactly where after/skip starts the next line.
    done means the source is exhausted, not that its content has been
    assumed to vanish. skipped records an empty display line; the concrete
    checker verifies its original-source after/skip condition separately. -/
inductive CaptionAssembly {α : Type} (kind : α → CaptionItemKind) :
    List α → List (List α) → Prop where
  | done : CaptionAssembly kind [] []
  | skipped (source : List α) (later : List (List α))
      (tail : CaptionAssembly kind source later) :
      CaptionAssembly kind source ([] :: later)
  | line (before : List α) (atBreak : α) (rest : List α) (later : List (List α))
      (breakItem : kind atBreak ≠ .box)
      (tail : CaptionAssembly kind
        (rest.drop (captionDiscardCount (rest.map kind))) later) :
      CaptionAssembly kind (before ++ atBreak :: rest) (before :: later)

/-- mkLine selects items [start, break), then optionally appends the
    penalty at the break. Since that penalty is never a box, flattening
    the assembled line payloads emits every source box exactly once,
    in its source order, including identical-looking boxes. -/
theorem I1_caption_assembly_boxes_exact {α : Type} (kind : α → CaptionItemKind)
    (source : List α) (lines : List (List α)) (valid : CaptionAssembly kind source lines) :
    (lines.map (captionBoxes kind)).join = captionBoxes kind source := by
  induction valid with
  | done => rfl
  | skipped source later tail ih => simpa [captionBoxes,List.join] using ih
  | line before atBreak rest later notBox _tail ih =>
    have gone : (kind atBreak == CaptionItemKind.box) = false := by
      cases eq : kind atBreak <;> simp_all <;> rfl
    simp only [List.map_cons,List.join_cons,ih]
    rw [I1_caption_discard_preserves_boxes]
    rw [captionBoxes_append]
    simp [captionBoxes,gone]

/-- A positive penalty width may be appended for drawing a hyphen or
    wrap mark, but it adds no source text box to the line projection. -/
theorem I1_caption_break_penalty_adds_no_box {α : Type} (kind : α → CaptionItemKind)
    (line : List α) (penalty : α) (value : Int) (pattern : Bool)
    (isPenalty : kind penalty = .penalty value pattern) :
    captionBoxes kind (line ++ [penalty]) = captionBoxes kind line := by
  rw [captionBoxes_append]
  simp [captionBoxes,isPenalty]

example : captionBoxes id
    (([.glue,.penalty 20 false,.box,.box] : List CaptionItemKind).drop
      (captionDiscardCount [.glue,.penalty 20 false,.box,.box])) = [.box,.box] := by decide

example : captionDiscardCount [.glue,.penalty (-10000) false,.box] = 1 := by decide


/-- Check the concrete absolute break positions before projecting line
    items. This is the same half-open item slice and after/skip offset
    as mkLine/assemble. Overlapping ranges, breaks on boxes, and an
    incompletely consumed source are rejected. Pass-specific candidate
    admissibility is a separate obligation of the active-node producer. -/
def captionAssembleAt {α : Type} (kind : α → CaptionItemKind)
    (items : List α) (start : Nat) : List Nat → Option (List (List α))
  | [] => if items.isEmpty then some [] else none
  | b :: bs =>
    if start ≤ b then
      match items.drop (b-start) with
      | [] => none
      | atBreak :: rest =>
        if kind atBreak == .box then none else
          let skip := captionDiscardCount (rest.map kind)
          match captionAssembleAt kind (rest.drop skip) (b+1+skip) bs with
          | none => none
          | some later => some (items.take (b-start) :: later)
    else none

theorem I1_caption_assemble_checked {α : Type} (kind : α → CaptionItemKind)
    (breaks : List Nat) (items : List α) (start : Nat) (lines : List (List α))
    (assembled : captionAssembleAt kind items start breaks = some lines) :
    CaptionAssembly kind items lines := by
  induction breaks generalizing items start lines with
  | nil =>
    simp only [captionAssembleAt] at assembled
    split at assembled
    · have empty : items = [] := by
        cases items <;> simp_all [List.isEmpty]
      subst items
      cases assembled
      exact CaptionAssembly.done
    · contradiction
  | cons b bs ih =>
    simp only [captionAssembleAt] at assembled
    split at assembled
    · rename_i ordered
      split at assembled
      · contradiction
      · rename_i atBreak rest tailEq
        split at assembled
        · contradiction
        · rename_i notBox
          split at assembled
          · contradiction
          · rename_i later laterEq
            have validTail := ih _ _ _ laterEq
            have nb : kind atBreak ≠ .box := by
              intro eq
              simp [eq] at notBox
            cases assembled
            have source : items.take (b-start) ++ atBreak :: rest = items := by
              rw [← tailEq]
              exact List.take_append_drop _ _
            simpa only [source] using
              (CaptionAssembly.line (items.take (b-start)) atBreak rest later nb validTail)
    · contradiction

theorem I1_caption_checked_payload_exact {α : Type} (kind : α → CaptionItemKind)
    (breaks : List Nat) (items : List α) (start : Nat) (lines : List (List α))
    (assembled : captionAssembleAt kind items start breaks = some lines) :
    (lines.map (captionBoxes kind)).join = captionBoxes kind items :=
  I1_caption_assembly_boxes_exact _ _ _ (I1_caption_assemble_checked kind breaks items start lines assembled)

example : captionAssembleAt Prod.fst
    [(.box,7),(.glue,0),(.penalty 0 true,0),(.box,8),(.penalty (-10000) false,0)]
    0 [1,4] = some [[(.box,7)],[ (.box,8)]] := by decide

example : captionAssembleAt id [.box,.penalty (-10000) false] 0 [0,1] = none := by decide


/-- The absolute source offset where after/skip stops when it starts
    scanning at an item. The predecessor's chosen break calls this
    function at break+1; the paragraph itself starts at offset zero. -/
def captionNextSourceStart (items : List CaptionItemKind) (start : Nat) : Nat :=
  start + captionDiscardCount (items.drop start)

private theorem captionDiscardCons_le (item : CaptionItemKind)
    (items : List CaptionItemKind) :
    captionDiscardCount (item :: items) ≤ 1 + captionDiscardCount items := by
  cases item <;> simp [captionDiscardCount]
  split <;> omega

/-- Later break positions cannot make after/skip move backwards. This
    holds with forced penalties and arbitrary runs of optional penalties
    and glue, without any assumption about measured widths. -/
theorem I1_caption_next_start_monotone (items : List CaptionItemKind)
    (earlier later : Nat) (ordered : earlier ≤ later) :
    captionNextSourceStart items earlier ≤ captionNextSourceStart items later := by
  induction items generalizing earlier later with
  | nil => simpa [captionNextSourceStart] using ordered
  | cons item items ih =>
    cases earlier with
    | zero =>
      cases later with
      | zero => exact Nat.le_refl _
      | succ later =>
        have first := captionDiscardCons_le item items
        have rest := ih 0 later (Nat.zero_le _)
        simp only [captionNextSourceStart,List.drop_zero,Nat.zero_add] at rest
        simp only [captionNextSourceStart,List.drop_zero,Nat.zero_add,List.drop_succ_cons]
        omega
    | succ earlier =>
      cases later with
      | zero => exact False.elim (Nat.not_succ_le_zero _ ordered)
      | succ later =>
        have rest := ih earlier later (by omega)
        simp only [captionNextSourceStart,List.drop_succ_cons] at *
        omega

theorem I1_caption_next_start_bounds (items : List CaptionItemKind)
    (start : Nat) (inside : start ≤ items.length) :
    start ≤ captionNextSourceStart items start ∧
      captionNextSourceStart items start ≤ items.length := by
  have bound := I1_caption_discard_bounded (items.drop start)
  simp only [List.length_drop] at bound
  simp only [captionNextSourceStart]
  omega


/-- Active-node metadata in Knuth--Plass. Positions are encoded as the
    Haskell position plus one, so the initial -1 is zero. History retains
    both position and fitness as walk/key do, newest break first. -/
structure CaptionActiveNode where
  position : Nat
  lineCount : Nat
  fitness : Nat
  flagged : Bool
  demerits : Int
  history : List (Nat × Nat)
  deriving DecidableEq

structure CaptionActiveEval where
  fitness : Nat
  demerits : Int
  feasible : Bool
  alive : Bool

def captionActiveKeyBefore (left right : CaptionActiveNode) : Bool :=
  decide (left.lineCount < right.lineCount) ||
    (decide (left.lineCount = right.lineCount) && decide (left.fitness < right.fitness))

def captionActiveKeyEqual (left right : CaptionActiveNode) : Bool :=
  decide (left.lineCount = right.lineCount ∧ left.fitness = right.fitness)

/-- The ordered map values after insertWith: equal keys keep the later
    predecessor when its total cost is equal, not just when it is lower. -/
def captionInsertActive (node : CaptionActiveNode) :
    List CaptionActiveNode → List CaptionActiveNode
  | [] => [node]
  | prior :: rest =>
    if captionActiveKeyBefore node prior then node :: prior :: rest
    else if captionActiveKeyEqual node prior then
      (if node.demerits ≤ prior.demerits then node else prior) :: rest
    else prior :: captionInsertActive node rest

def captionActiveSuccessors (position : Nat) (flagged : Bool)
    (evaluate : CaptionActiveNode → CaptionActiveEval) :
    List CaptionActiveNode → List CaptionActiveNode
  | [] => []
  | prior :: rest =>
    let ev := evaluate prior
    let later := captionActiveSuccessors position flagged evaluate rest
    if ev.feasible then
      { position := position+1, lineCount := prior.lineCount+1,
        fitness := ev.fitness, flagged := flagged,
        demerits := prior.demerits+ev.demerits,
        history := (position,ev.fitness) :: prior.history } :: later
    else later

def captionActiveStep (position : Nat) (forced flagged : Bool)
    (evaluate : CaptionActiveNode → CaptionActiveEval)
    (actives : List CaptionActiveNode) : List CaptionActiveNode :=
  let survivors := if forced then [] else actives.filter (fun node => (evaluate node).alive)
  let successors := captionActiveSuccessors position flagged evaluate actives
  survivors ++ successors.foldl (fun table node => captionInsertActive node table) []

private theorem captionInsert_preserves {P : CaptionActiveNode → Prop}
    (node : CaptionActiveNode) (nodes : List CaptionActiveNode)
    (new : P node) (old : ∀ n ∈ nodes, P n) :
    ∀ n ∈ captionInsertActive node nodes, P n := by
  induction nodes with
  | nil => simpa [captionInsertActive] using new
  | cons prior rest ih =>
    have priorOk := old prior (List.Mem.head _)
    have restOk : ∀ n ∈ rest, P n := fun n h => old n (List.Mem.tail _ h)
    simp only [captionInsertActive]
    split
    · intro n member
      simp only [List.mem_cons] at member
      rcases member with rfl | rfl | member
      · exact new
      · exact priorOk
      · exact restOk _ member
    · split
      · intro n member
        simp only [List.mem_cons] at member
        rcases member with rfl | member
        · split <;> assumption
        · exact restOk _ member
      · intro n member
        simp only [List.mem_cons] at member
        rcases member with rfl | member
        · exact priorOk
        · exact ih restOk _ member

private theorem captionFold_preserves {P : CaptionActiveNode → Prop}
    (nodes seed : List CaptionActiveNode)
    (new : ∀ n ∈ nodes, P n) (old : ∀ n ∈ seed, P n) :
    ∀ n ∈ nodes.foldl (fun table node => captionInsertActive node table) seed, P n := by
  induction nodes generalizing seed with
  | nil => exact old
  | cons h t ih =>
    have headOk := new h (List.Mem.head _)
    have tailOk : ∀ n ∈ t, P n := fun n m => new n (List.Mem.tail _ m)
    exact ih _ tailOk (captionInsert_preserves h seed headOk old)

private theorem captionSuccessors_progress (position : Nat) (flagged : Bool)
    (evaluate : CaptionActiveNode → CaptionActiveEval) (actives : List CaptionActiveNode)
    (counts : ∀ n ∈ actives, n.lineCount = n.history.length) :
    ∀ n ∈ captionActiveSuccessors position flagged evaluate actives,
      n.position = position+1 ∧ n.lineCount = n.history.length := by
  induction actives with
  | nil => simp [captionActiveSuccessors]
  | cons h t ih =>
    have tailOk : ∀ n ∈ t, n.lineCount = n.history.length :=
      fun n m => counts n (List.Mem.tail _ m)
    have headOk := counts h (List.Mem.head _)
    simp only [captionActiveSuccessors]
    split
    · intro n member
      simp only [List.mem_cons] at member
      rcases member with rfl | later
      · exact ⟨rfl,by simp only [List.length_cons]; omega⟩
      · exact ih tailOk _ later
    · exact ih tailOk

private theorem captionMemberAppend {α : Type} (x : α) (xs ys : List α) :
    x ∈ xs ++ ys ↔ x ∈ xs ∨ x ∈ ys := by
  induction xs with
  | nil => simp
  | cons h t ih => simp only [List.cons_append,List.mem_cons,ih,or_assoc]

/-- Grouping feasible successors by (line count, fitness), with the
    actual equal-cost replacement policy, cannot invent a break offset
    or change the number of source breaks in a node's history. The
    integer cost and evaluation result may depend on the whole context. -/
theorem I1_caption_active_step_progress (position lower : Nat) (forced flagged : Bool)
    (evaluate : CaptionActiveNode → CaptionActiveEval) (actives : List CaptionActiveNode)
    (bounds : ∀ n ∈ actives, lower ≤ n.position ∧ n.position ≤ position+1)
    (counts : ∀ n ∈ actives, n.lineCount = n.history.length)
    (inside : lower ≤ position+1) :
    ∀ n ∈ captionActiveStep position forced flagged evaluate actives,
      lower ≤ n.position ∧ n.position ≤ position+1 ∧ n.lineCount = n.history.length := by
  have successors := captionSuccessors_progress position flagged evaluate actives counts
  have successorOk : ∀ n ∈ captionActiveSuccessors position flagged evaluate actives,
      lower ≤ n.position ∧ n.position ≤ position+1 ∧ n.lineCount = n.history.length := by
    intro n member
    have h := successors n member
    exact ⟨by omega,by omega,h.2⟩
  have folded := captionFold_preserves
    (captionActiveSuccessors position flagged evaluate actives) [] successorOk (by simp)
  intro n member
  simp only [captionActiveStep,captionMemberAppend] at member
  rcases member with survived | created
  · split at survived
    · contradiction
    · have old := (List.mem_filter.mp survived).1
      exact ⟨(bounds n old).1,(bounds n old).2,counts n old⟩
  · exact folded n created


/-- insertWith uses <=: an equally good later predecessor replaces the
    earlier history at exactly the same line-count/fitness key. -/
theorem I1_caption_active_equal_cost_keeps_later (new old : CaptionActiveNode)
    (rest : List CaptionActiveNode) (lines : new.lineCount = old.lineCount)
    (fit : new.fitness = old.fitness) (cost : new.demerits ≤ old.demerits) :
    captionInsertActive new (old :: rest) = new :: rest := by
  simp [captionInsertActive,captionActiveKeyBefore,captionActiveKeyEqual,lines,fit,cost]

example : captionInsertActive
    ⟨5,2,2,false,9,[(4,2),(2,0)]⟩ [⟨5,2,2,false,9,[(4,2),(1,0)]⟩] =
    [⟨5,2,2,false,9,[(4,2),(2,0)]⟩] := by decide


/-- Every new active has one concrete predecessor, advances its source
    offset, and adds exactly the current break to that predecessor's
    history. Feasibility/cost calculations cannot change that history. -/
theorem I1_caption_successor_history_advances (position : Nat) (flagged : Bool)
    (evaluate : CaptionActiveNode → CaptionActiveEval) (actives : List CaptionActiveNode)
    (before : ∀ n ∈ actives, n.position ≤ position) :
    ∀ n ∈ captionActiveSuccessors position flagged evaluate actives,
      ∃ prior ∈ actives,
        n.position = position+1 ∧ prior.position < n.position ∧
        n.lineCount = prior.lineCount+1 ∧
        n.history = (position,n.fitness) :: prior.history := by
  induction actives with
  | nil => simp [captionActiveSuccessors]
  | cons h t ih =>
    have tailBefore : ∀ n ∈ t, n.position ≤ position :=
      fun n member => before n (List.Mem.tail _ member)
    have headBefore := before h (List.Mem.head _)
    simp only [captionActiveSuccessors]
    split
    · intro n member
      simp only [List.mem_cons] at member
      rcases member with rfl | later
      · exact ⟨h,List.Mem.head _,rfl,Nat.lt_succ_of_le headBefore,rfl,rfl⟩
      · obtain ⟨prior,member,rest⟩ := ih tailBefore n later
        exact ⟨prior,List.Mem.tail _ member,rest⟩
    · intro n member
      obtain ⟨prior,member,rest⟩ := ih tailBefore n member
      exact ⟨prior,List.Mem.tail _ member,rest⟩


/-- Assemble with the original source available. A chosen break can lie
    inside the predecessor's discarded prefix. mkLine then has no text
    boxes; its next offset is still the same stopping point. Check that
    equality against the original source rather than assuming it. -/
def captionAssembleFrom {α : Type} (kind : α → CaptionItemKind)
    (original remaining : List α) (start : Nat) : List Nat → Option (List (List α))
  | [] => if remaining.isEmpty then some [] else none
  | b :: bs =>
    if start ≤ b then
      match remaining.drop (b-start) with
      | [] => none
      | atBreak :: rest =>
        if kind atBreak == .box then none else
          let skip := captionDiscardCount (rest.map kind)
          match captionAssembleFrom kind original (rest.drop skip) (b+1+skip) bs with
          | none => none
          | some later => some (remaining.take (b-start) :: later)
    else
      match original.drop b with
      | [] => none
      | atBreak :: rest =>
        if kind atBreak == .box then none else
          let next := b+1+captionDiscardCount (rest.map kind)
          if next = start then
            match captionAssembleFrom kind original remaining start bs with
            | none => none
            | some later => some ([] :: later)
          else none

def captionAssembleWhole {α : Type} (kind : α → CaptionItemKind)
    (original : List α) (breaks : List Nat) : Option (List (List α)) :=
  captionAssembleFrom kind original original 0 breaks

theorem I1_caption_assemble_with_empty_lines {α : Type} (kind : α → CaptionItemKind)
    (breaks : List Nat) (original remaining : List α) (start : Nat) (lines : List (List α))
    (assembled : captionAssembleFrom kind original remaining start breaks = some lines) :
    CaptionAssembly kind remaining lines ∧ lines.length = breaks.length := by
  induction breaks generalizing remaining start lines with
  | nil =>
    simp only [captionAssembleFrom] at assembled
    split at assembled
    · have empty : remaining = [] := by
        cases remaining <;> simp_all [List.isEmpty]
      subst remaining
      cases assembled
      exact ⟨CaptionAssembly.done,rfl⟩
    · contradiction
  | cons b bs ih =>
    simp only [captionAssembleFrom] at assembled
    split at assembled
    · split at assembled
      · contradiction
      · rename_i atBreak rest tailEq
        split at assembled
        · contradiction
        · split at assembled
          · contradiction
          · rename_i later laterEq
            have validTail := ih _ _ _ laterEq
            have nb : kind atBreak ≠ .box := by
              intro eq
              simp [eq] at *
            cases assembled
            have source : remaining.take (b-start) ++ atBreak :: rest = remaining := by
              rw [← tailEq]
              exact List.take_append_drop _ _
            refine ⟨?_,?_⟩
            · simpa only [source] using
                (CaptionAssembly.line (remaining.take (b-start)) atBreak rest later nb validTail.1)
            · simpa only [List.length_cons] using congrArg Nat.succ validTail.2
    · split at assembled
      · contradiction
      · split at assembled
        · contradiction
        · split at assembled
          · split at assembled
            · contradiction
            · rename_i later laterEq
              have validTail := ih _ _ _ laterEq
              cases assembled
              exact ⟨CaptionAssembly.skipped _ _ validTail.1,
                by simpa only [List.length_cons] using congrArg Nat.succ validTail.2⟩
          · contradiction

/-- Empty display lines reached via a discarded penalty do not erase,
    duplicate or reorder any source box. Their legitimacy is checked by
    comparing after/skip with the predecessor's actual source offset. -/
theorem I1_caption_whole_payload_exact {α : Type} (kind : α → CaptionItemKind)
    (source : List α) (breaks : List Nat) (lines : List (List α))
    (assembled : captionAssembleWhole kind source breaks = some lines) :
    (lines.map (captionBoxes kind)).join = captionBoxes kind source :=
  I1_caption_assembly_boxes_exact _ _ _
    (I1_caption_assemble_with_empty_lines kind breaks source source 0 lines assembled).1

example : captionAssembleWhole Prod.fst
    [(.penalty (-10000) false,0),(.penalty (-100) false,0),(.box,2),
      (.glue,0),(.penalty (-10000) false,0)] [0,1,4] =
    some [[],[],[(.box,2),(.glue,0)]] := by decide


theorem I1_caption_whole_grid_span {α : Type} (kind : α → CaptionItemKind)
    (source : List α) (breaks : List Nat) (lines : List (List α))
    (body pitch size : Nat)
    (assembled : captionAssembleWhole kind source breaks = some lines) :
    captionGridSpan body pitch size lines.length =
      captionGridSpan body pitch size breaks.length := by
  rw [(I1_caption_assemble_with_empty_lines kind breaks source source 0 lines assembled).2]


/-- Reverse predecessor history: every older break is strictly earlier. -/
def CaptionHistoryOrdered : Nat → List (Nat × Nat) → Prop
  | _, [] => True
  | ceiling, (position,_) :: rest =>
      position < ceiling ∧ CaptionHistoryOrdered position rest

private theorem captionHistoryOrdered_mono (old new : Nat)
    (history : List (Nat × Nat)) (ordered : CaptionHistoryOrdered old history)
    (later : old ≤ new) : CaptionHistoryOrdered new history := by
  cases history with
  | nil => trivial
  | cons head tail => exact ⟨by have := ordered.1; omega,ordered.2⟩

def CaptionNodeValid (ceiling : Nat) (candidates : List Nat)
    (node : CaptionActiveNode) : Prop :=
  node.position ≤ ceiling ∧ node.lineCount = node.history.length ∧
  CaptionHistoryOrdered node.position node.history ∧
  (∀ entry ∈ node.history, entry.1 ∈ candidates)

private theorem captionSuccessors_valid (position : Nat) (flagged : Bool)
    (evaluate : CaptionActiveNode → CaptionActiveEval) (actives : List CaptionActiveNode)
    (candidates : List Nat) (candidate : position ∈ candidates)
    (old : ∀ node ∈ actives, CaptionNodeValid position candidates node) :
    ∀ node ∈ captionActiveSuccessors position flagged evaluate actives,
      CaptionNodeValid (position+1) candidates node := by
  induction actives with
  | nil => simp [captionActiveSuccessors]
  | cons head tail ih =>
    have headOk := old head (List.Mem.head _)
    have tailOk : ∀ node ∈ tail, CaptionNodeValid position candidates node :=
      fun node member => old node (List.Mem.tail _ member)
    simp only [captionActiveSuccessors]
    split
    · intro node member
      simp only [List.mem_cons] at member
      rcases member with rfl | later
      · refine ⟨Nat.le_refl _,?_,?_,?_⟩
        · simp only [List.length_cons]; exact congrArg Nat.succ headOk.2.1
        · exact ⟨Nat.lt_succ_self _,
            captionHistoryOrdered_mono head.position position head.history headOk.2.2.1 headOk.1⟩
        · intro entry entryMember
          simp only [List.mem_cons] at entryMember
          rcases entryMember with rfl | prior
          · exact candidate
          · exact headOk.2.2.2 entry prior
      · exact ih tailOk node later
    · exact ih tailOk

private theorem captionNodeValid_mono (old new : Nat) (candidates : List Nat)
    (node : CaptionActiveNode) (valid : CaptionNodeValid old candidates node)
    (later : old ≤ new) : CaptionNodeValid new candidates node :=
  ⟨Nat.le_trans valid.1 later,valid.2⟩

/-- One ordinary active step preserves the actual source candidate
    provenance and strictly ordered predecessor history, not only counts. -/
theorem I1_caption_active_step_history (position : Nat) (forced flagged : Bool)
    (evaluate : CaptionActiveNode → CaptionActiveEval) (actives : List CaptionActiveNode)
    (candidates : List Nat) (candidate : position ∈ candidates)
    (old : ∀ node ∈ actives, CaptionNodeValid position candidates node) :
    ∀ node ∈ captionActiveStep position forced flagged evaluate actives,
      CaptionNodeValid (position+1) candidates node := by
  have successors := captionSuccessors_valid position flagged evaluate actives candidates candidate old
  have folded := captionFold_preserves
    (captionActiveSuccessors position flagged evaluate actives) [] successors (by simp)
  intro node member
  simp only [captionActiveStep,captionMemberAppend] at member
  rcases member with survived | created
  · split at survived
    · contradiction
    · exact captionNodeValid_mono position (position+1) candidates node
        (old node (List.mem_filter.mp survived).1) (Nat.le_succ _)
  · exact folded node created

/-- The ordinary passes call step on the remaining candidates once, in
    source order. Pass four's pushOut restart is deliberately separate. -/
def captionRunOrdinary (forced flagged : Nat → Bool)
    (evaluate : Nat → CaptionActiveNode → CaptionActiveEval) :
    List Nat → List CaptionActiveNode → List CaptionActiveNode
  | [], actives => actives
  | position :: rest, actives =>
      captionRunOrdinary forced flagged evaluate rest
        (captionActiveStep position (forced position) (flagged position) (evaluate position) actives)

def CaptionCandidatesOrdered : Nat → Nat → List Nat → Prop
  | _, _, [] => True
  | lower, upper, position :: rest =>
      lower ≤ position ∧ position < upper ∧
      CaptionCandidatesOrdered (position+1) upper rest

/-- For arbitrary candidate counts and arbitrary context-dependent
    evaluation, every ordinary pass terminates by consuming the candidate
    list. All resulting histories refer only to actual candidates, in
    strictly decreasing source order, and retain their exact line count. -/
theorem I1_caption_ordinary_pass_history (lower upper : Nat)
    (allCandidates candidates : List Nat) (forced flagged : Nat → Bool)
    (evaluate : Nat → CaptionActiveNode → CaptionActiveEval)
    (actives : List CaptionActiveNode)
    (ordered : CaptionCandidatesOrdered lower upper candidates)
    (source : ∀ position ∈ candidates, position ∈ allCandidates)
    (within : lower ≤ upper)
    (initial : ∀ node ∈ actives, CaptionNodeValid lower allCandidates node) :
    ∀ node ∈ captionRunOrdinary forced flagged evaluate candidates actives,
      CaptionNodeValid upper allCandidates node := by
  induction candidates generalizing lower actives with
  | nil =>
    intro node member
    exact captionNodeValid_mono lower upper allCandidates node (initial node member) within
  | cons position rest ih =>
    have old : ∀ node ∈ actives, CaptionNodeValid position allCandidates node :=
      fun node member => captionNodeValid_mono lower position allCandidates node
        (initial node member) ordered.1
    have next := I1_caption_active_step_history position (forced position) (flagged position)
      (evaluate position) actives allCandidates (source position (List.Mem.head _)) old
    exact ih (position+1) _ ordered.2.2
      (fun p member => source p (List.Mem.tail _ member)) (by have := ordered.2.1; omega) next

/-- The actual initial node has encoded position zero, line zero,
    fitness two, no predecessor and zero accumulated demerits. -/
def captionInitialActive : CaptionActiveNode := ⟨0,0,2,false,0,[]⟩

theorem I1_caption_ordinary_pass_from_start (upper : Nat) (candidates : List Nat)
    (forced flagged : Nat → Bool)
    (evaluate : Nat → CaptionActiveNode → CaptionActiveEval)
    (ordered : CaptionCandidatesOrdered 0 upper candidates) :
    ∀ node ∈ captionRunOrdinary forced flagged evaluate candidates [captionInitialActive],
      CaptionNodeValid upper candidates node := by
  apply I1_caption_ordinary_pass_history 0 upper candidates candidates forced flagged evaluate
    [captionInitialActive] ordered (fun _ member => member) (Nat.zero_le _)
  intro node member
  simp only [List.mem_cons,List.not_mem_nil,or_false] at member
  subst node
  exact ⟨Nat.le_refl _,rfl,True.intro,by simp [captionInitialActive]⟩


/-- Reversing candidate order really breaks the history invariant; the
    ordered-source precondition of the ordinary-pass theorem is needed. -/
example : (captionRunOrdinary (fun _ => true) (fun _ => false)
    (fun _ _ => ⟨2,0,true,true⟩) [1,0] [captionInitialActive]).map
      (fun node => node.history) = [[(0,2),(1,2)]] := by decide

example : ¬ CaptionHistoryOrdered 1 [(0,2),(1,2)] := by simp [CaptionHistoryOrdered]

example : (captionRunOrdinary (fun _ => true) (fun _ => false)
    (fun _ _ => ⟨2,0,true,true⟩) [0,1] [captionInitialActive]).map
      (fun node => node.history) = [[(1,2),(0,2)]] := by decide

example : CaptionHistoryOrdered 2 [(1,2),(0,2)] := by simp [CaptionHistoryOrdered]

private theorem captionHistoryOrdered_length (ceiling : Nat) (history : List (Nat × Nat))
    (ordered : CaptionHistoryOrdered ceiling history) : history.length ≤ ceiling := by
  induction history generalizing ceiling with
  | nil => exact Nat.zero_le _
  | cons head tail ih =>
    have shorter := ih head.1 ordered.2
    simp only [List.length_cons]
    have earlier := ordered.1
    omega

/-- Even negative penalties cannot produce unboundedly many lines in an
    ordinary pass: each predecessor break strictly advances in the finite
    source. The source length itself is unrestricted. -/
theorem I1_caption_ordinary_line_bound (upper : Nat) (candidates : List Nat)
    (forced flagged : Nat → Bool)
    (evaluate : Nat → CaptionActiveNode → CaptionActiveEval)
    (ordered : CaptionCandidatesOrdered 0 upper candidates) :
    ∀ node ∈ captionRunOrdinary forced flagged evaluate candidates [captionInitialActive],
      node.lineCount ≤ upper := by
  intro node member
  have valid := I1_caption_ordinary_pass_from_start upper candidates forced flagged evaluate ordered node member
  have bounded := captionHistoryOrdered_length node.position node.history valid.2.2.1
  rw [valid.2.1]
  exact Nat.le_trans bounded valid.1


/-- pushOut examines source candidates from latest to earliest, accepts
    only a finite line ending strictly after after(prior), and stops at
    the first such candidate for that predecessor. -/
def captionFindPushBreak (start before : Nat) (finite : Nat → Bool) :
    List Nat → Option Nat
  | [] => none
  | position :: rest =>
      if start < position ∧ position < before ∧ finite position = true then some position
      else captionFindPushBreak start before finite rest

private theorem captionFindPushBreak_sound (start before : Nat)
    (finite : Nat → Bool) (candidates : List Nat) (position : Nat)
    (found : captionFindPushBreak start before finite candidates = some position) :
    position ∈ candidates ∧ start < position ∧ position < before ∧ finite position = true := by
  induction candidates with
  | nil => simp [captionFindPushBreak] at found
  | cons head tail ih =>
    simp only [captionFindPushBreak] at found
    split at found
    · rename_i accepted
      cases found
      exact ⟨List.Mem.head _,accepted⟩
    · have fromTail := ih found
      exact ⟨List.Mem.tail _ fromTail.1,fromTail.2⟩

def captionAfterEncoded (items : List CaptionItemKind) (position : Nat) : Nat :=
  if position = 0 then 0 else captionNextSourceStart items position

private theorem captionAfterEncoded_ge (items : List CaptionItemKind) (position : Nat) :
    position ≤ captionAfterEncoded items position := by
  unfold captionAfterEncoded
  split
  · omega
  · simp only [captionNextSourceStart]; omega

structure CaptionPushOption where
  predecessor : Nat
  node : CaptionActiveNode
  deriving DecidableEq

def captionPushOptions (items : List CaptionItemKind) (candidates : List Nat)
    (before : Nat) (flagged : Nat → Bool)
    (evaluate : CaptionActiveNode → Nat → CaptionActiveEval)
    (finite : CaptionActiveNode → Nat → Bool) :
    List CaptionActiveNode → List CaptionPushOption
  | [] => []
  | prior :: rest =>
      let later := captionPushOptions items candidates before flagged evaluate finite rest
      match captionFindPushBreak (captionAfterEncoded items prior.position) before
          (finite prior) candidates.reverse with
      | none => later
      | some position =>
          let ev := evaluate prior position
          let node : CaptionActiveNode :=
            { position := position+1, lineCount := prior.lineCount+1,
              fitness := ev.fitness, flagged := flagged position,
              demerits := prior.demerits+ev.demerits,
              history := (position,ev.fitness) :: prior.history }
          { predecessor := prior.position, node := node } :: later

/-- The ordering is exactly (Down position, total cost, Down predecessor).
    A tie keeps the first option, matching the stable sort in pushOut. -/
def captionPushBeforeOrEqual (left right : CaptionPushOption) : Bool :=
  decide (right.node.position < left.node.position) ||
    (decide (left.node.position = right.node.position) &&
      (decide (left.node.demerits < right.node.demerits) ||
        (decide (left.node.demerits = right.node.demerits) &&
          decide (right.predecessor ≤ left.predecessor))))

def captionChoosePush : List CaptionPushOption → Option CaptionPushOption
  | [] => none
  | head :: tail =>
      match captionChoosePush tail with
      | none => some head
      | some later => some (if captionPushBeforeOrEqual head later then head else later)

private theorem captionChoosePush_member (options : List CaptionPushOption)
    (selected : CaptionPushOption) (chosen : captionChoosePush options = some selected) :
    selected ∈ options := by
  induction options with
  | nil => simp [captionChoosePush] at chosen
  | cons head tail ih =>
    simp only [captionChoosePush] at chosen
    split at chosen
    · cases chosen; exact List.Mem.head _
    · rename_i later laterEq
      split at chosen
      · cases chosen; exact List.Mem.head _
      · cases chosen; exact List.Mem.tail _ (ih laterEq)

private theorem captionPushOptions_progress (items : List CaptionItemKind)
    (candidates : List Nat) (before lower : Nat) (flagged : Nat → Bool)
    (evaluate : CaptionActiveNode → Nat → CaptionActiveEval)
    (finite : CaptionActiveNode → Nat → Bool) (actives : List CaptionActiveNode)
    (old : ∀ prior ∈ actives, lower ≤ prior.position) :
    ∀ option ∈ captionPushOptions items candidates before flagged evaluate finite actives,
      lower < option.node.position ∧ option.node.position ≤ before := by
  induction actives with
  | nil => simp [captionPushOptions]
  | cons prior rest ih =>
    have headLower := old prior (List.Mem.head _)
    have tailLower : ∀ node ∈ rest, lower ≤ node.position :=
      fun node member => old node (List.Mem.tail _ member)
    simp only [captionPushOptions]
    split
    · exact ih tailLower
    · rename_i position selected
      have source := captionFindPushBreak_sound (captionAfterEncoded items prior.position)
        before (finite prior) candidates.reverse position selected
      have after := captionAfterEncoded_ge items prior.position
      intro option member
      simp only [List.mem_cons] at member
      rcases member with rfl | later
      · exact ⟨by simp only; omega,by simp only; omega⟩
      · exact ih tailLower option later

/-- The actual pushOut choice strictly raises a common lower bound on
    active source positions, even though it restarts earlier candidates.
    This is derived from the candidate search and selection, not assumed
    as a property of a caller-supplied restart node. -/
theorem I1_caption_push_out_advances (items : List CaptionItemKind)
    (candidates : List Nat) (before lower : Nat) (flagged : Nat → Bool)
    (evaluate : CaptionActiveNode → Nat → CaptionActiveEval)
    (finite : CaptionActiveNode → Nat → Bool) (actives : List CaptionActiveNode)
    (selected : CaptionPushOption)
    (old : ∀ prior ∈ actives, lower ≤ prior.position)
    (chosen : captionChoosePush
      (captionPushOptions items candidates before flagged evaluate finite actives) = some selected) :
    lower < selected.node.position ∧ selected.node.position ≤ before :=
  captionPushOptions_progress items candidates before lower flagged evaluate finite actives old
    selected (captionChoosePush_member _ selected chosen)

/-- The first component of a finite-source scan rank decreases on an
    actual pushOut restart; the candidate count may increase freely. -/
theorem I1_caption_push_out_rank (items : List CaptionItemKind)
    (candidates : List Nat) (before lower sourceLength : Nat) (flagged : Nat → Bool)
    (evaluate : CaptionActiveNode → Nat → CaptionActiveEval)
    (finite : CaptionActiveNode → Nat → Bool) (actives : List CaptionActiveNode)
    (selected : CaptionPushOption)
    (inside : before < sourceLength)
    (old : ∀ prior ∈ actives, lower ≤ prior.position)
    (chosen : captionChoosePush
      (captionPushOptions items candidates before flagged evaluate finite actives) = some selected) :
    sourceLength+1-selected.node.position < sourceLength+1-lower := by
  have advances := I1_caption_push_out_advances items candidates before lower flagged
    evaluate finite actives selected old chosen
  omega


/-- A natural-number scan rank, with room for every candidate after a
    restart. The candidate/source sizes are arbitrary parameters. -/
def captionScanRank (sourceLength candidateCount lower remainingCount : Nat) : Nat :=
  (sourceLength+1-lower)*(candidateCount+1)+remainingCount

theorem I1_caption_ordinary_scan_rank (sourceLength candidateCount lower remainingCount : Nat) :
    captionScanRank sourceLength candidateCount lower remainingCount <
      captionScanRank sourceLength candidateCount lower (remainingCount+1) := by
  unfold captionScanRank
  omega

/-- No fixed retry cap is needed: a source-advancing restart lowers the
    rank even when every original candidate is scanned again. -/
theorem I1_caption_restart_scan_rank (sourceLength candidateCount oldLower newLower
    oldRemaining newRemaining : Nat)
    (advanced : oldLower < newLower) (inside : newLower ≤ sourceLength+1)
    (restartBound : newRemaining ≤ candidateCount) :
    captionScanRank sourceLength candidateCount newLower newRemaining <
      captionScanRank sourceLength candidateCount oldLower oldRemaining := by
  have gap : sourceLength+1-newLower+1 ≤ sourceLength+1-oldLower := by omega
  have scaled := Nat.mul_le_mul_right (candidateCount+1) gap
  simp only [Nat.add_mul,Nat.one_mul] at scaled
  unfold captionScanRank
  omega

example : captionFindPushBreak 4 8 (fun _ => true) [7,6,5,4,3] = some 7 := by decide
example : captionFindPushBreak 4 8 (fun p => decide (p ≤ 6)) [7,6,5,4,3] = some 6 := by decide
example : captionFindPushBreak 4 8 (fun _ => true) [4,3,2] = none := by decide

/-- At an exact key tie stable sort preserves the first predecessor. -/
example : captionChoosePush
    [⟨2,⟨6,2,1,false,9,[(5,1),(1,2)]⟩⟩,
     ⟨2,⟨6,2,3,false,9,[(5,3),(1,2)]⟩⟩] =
    some ⟨2,⟨6,2,1,false,9,[(5,1),(1,2)]⟩⟩ := by decide

/-- Later source position wins before demerits are considered. -/
example : captionChoosePush
    [⟨2,⟨5,2,1,false,0,[(4,1),(1,2)]⟩⟩,
     ⟨2,⟨6,2,3,false,99,[(5,3),(1,2)]⟩⟩] =
    some ⟨2,⟨6,2,3,false,99,[(5,3),(1,2)]⟩⟩ := by decide
/-- Stable minimum of the actual context-dependent overflow expression. -/
def captionChooseOverflow (overflow : CaptionActiveNode → Int) :
    List CaptionActiveNode → Option CaptionActiveNode
  | [] => none
  | head :: rest =>
      match captionChooseOverflow overflow rest with
      | none => some head
      | some later => some (if overflow head ≤ overflow later then head else later)

private theorem captionOverflow_none (overflow : CaptionActiveNode → Int)
    (actives : List CaptionActiveNode) (noneChosen : captionChooseOverflow overflow actives = none) :
    actives = [] := by
  cases actives with
  | nil => rfl
  | cons head tail =>
    simp only [captionChooseOverflow] at noneChosen
    split at noneChosen <;> contradiction

theorem I1_caption_rescue_minimum (overflow : CaptionActiveNode → Int)
    (actives : List CaptionActiveNode) (selected : CaptionActiveNode)
    (chosen : captionChooseOverflow overflow actives = some selected) :
    selected ∈ actives ∧ ∀ node ∈ actives, overflow selected ≤ overflow node := by
  induction actives generalizing selected with
  | nil => simp [captionChooseOverflow] at chosen
  | cons head tail ih =>
    simp only [captionChooseOverflow] at chosen
    split at chosen
    · rename_i tailNone
      have empty := captionOverflow_none overflow tail tailNone
      subst tail
      cases chosen
      refine ⟨List.Mem.head _,?_⟩
      intro node member
      simp only [List.mem_cons,List.not_mem_nil,or_false] at member
      subst node
      exact Int.le_refl _
    · rename_i later laterChosen
      have best := ih later laterChosen
      split at chosen
      · rename_i headBetter
        cases chosen
        refine ⟨List.Mem.head _,?_⟩
        intro node member
        simp only [List.mem_cons] at member
        rcases member with rfl | prior
        · exact Int.le_refl _
        · exact Int.le_trans headBetter (best.2 node prior)
      · rename_i laterBetter
        cases chosen
        refine ⟨List.Mem.tail _ best.1,?_⟩
        intro node member
        simp only [List.mem_cons] at member
        rcases member with rfl | prior
        · omega
        · exact best.2 node prior

def captionRescueNode (position : Nat) (flagged : Bool)
    (prior : CaptionActiveNode) : CaptionActiveNode :=
  { position := position+1, lineCount := prior.lineCount+1,
    fitness := 3, flagged := flagged,
    demerits := prior.demerits+100000000,
    history := (position,3) :: prior.history }

private theorem captionHistoryRaise (old new : Nat) (history : List (Nat × Nat))
    (ordered : CaptionHistoryOrdered old history) (later : old ≤ new) :
    CaptionHistoryOrdered new history := by
  cases history with
  | nil => trivial
  | cons head tail => exact ⟨by have := ordered.1; omega,ordered.2⟩

/-- Rescue keeps the selected predecessor's whole history and adds the
    forced overfull line with fitness three and the actual demerit. -/
theorem I1_caption_rescue_history (position : Nat) (flagged : Bool)
    (candidates : List Nat) (candidate : position ∈ candidates)
    (overflow : CaptionActiveNode → Int) (actives : List CaptionActiveNode)
    (prior : CaptionActiveNode)
    (old : ∀ node ∈ actives, CaptionNodeValid position candidates node)
    (chosen : captionChooseOverflow overflow actives = some prior) :
    CaptionNodeValid (position+1) candidates (captionRescueNode position flagged prior) := by
  have member := (I1_caption_rescue_minimum overflow actives prior chosen).1
  have valid := old prior member
  refine ⟨Nat.le_refl _,?_,?_,?_⟩
  · simp only [captionRescueNode,List.length_cons]
    exact congrArg Nat.succ valid.2.1
  · exact ⟨Nat.lt_succ_self _,captionHistoryRaise prior.position position prior.history valid.2.2.1 valid.1⟩
  · intro entry entryMember
    simp only [captionRescueNode,List.mem_cons] at entryMember
    rcases entryMember with rfl | older
    · exact candidate
    · exact valid.2.2.2 entry older

example : captionChooseOverflow (fun node => node.demerits)
    [⟨1,1,1,false,9,[(0,1)]⟩,⟨2,1,3,false,9,[(1,3)]⟩] =
    some ⟨1,1,1,false,9,[(0,1)]⟩ := by decide


example : captionChooseOverflow (fun node => node.demerits)
    [⟨1,1,1,false,2,[(0,1)]⟩,⟨2,1,3,false,9,[(1,3)]⟩] =
    some ⟨1,1,1,false,2,[(0,1)]⟩ := by decide

/-- Rescue advances to the current break; an empty predecessor set
    simply produces no node. Either case needs no retry cap. -/
theorem I1_caption_rescue_scan_rank (sourceLength candidateCount lower position
    oldRemaining newRemaining : Nat)
    (before : lower ≤ position) (inside : position < sourceLength)
    (remaining : newRemaining ≤ candidateCount) :
    captionScanRank sourceLength candidateCount (position+1) newRemaining <
      captionScanRank sourceLength candidateCount lower oldRemaining :=
  I1_caption_restart_scan_rank sourceLength candidateCount lower (position+1)
    oldRemaining newRemaining (by omega) (by omega) remaining
private theorem candidatesWeaken (old new upper : Nat) (candidates : List Nat)
    (ordered : CaptionCandidatesOrdered old upper candidates) (weaker : new ≤ old) :
    CaptionCandidatesOrdered new upper candidates := by
  cases candidates with
  | nil => trivial
  | cons head tail => exact ⟨Nat.le_trans weaker ordered.1,ordered.2⟩

private theorem candidatesFilter (lower upper threshold : Nat) (candidates : List Nat)
    (ordered : CaptionCandidatesOrdered lower upper candidates) :
    CaptionCandidatesOrdered (max lower threshold) upper
      (candidates.filter (fun p => decide (threshold ≤ p))) := by
  induction candidates generalizing lower with
  | nil => trivial
  | cons head tail ih =>
    have tailValid := ih (head+1) ordered.2.2
    simp only [List.filter_cons]
    split
    · rename_i accepted
      have fits : threshold ≤ head := of_decide_eq_true accepted
      refine ⟨by have := ordered.1; omega,ordered.2.1,?_⟩
      exact candidatesWeaken (max (head+1) threshold) (head+1) upper _ tailValid (by omega)
    · exact candidatesWeaken (max (head+1) threshold) (max lower threshold) upper _ tailValid
        (by have := ordered.1; omega)

private theorem filterCount (threshold : Nat) (candidates : List Nat) :
    (candidates.filter (fun p => decide (threshold ≤ p))).length ≤ candidates.length := by
  induction candidates with
  | nil => exact Nat.le_refl _
  | cons head tail ih =>
    simp only [List.filter_cons]
    split <;> simp only [List.length_cons] <;> omega

private theorem successorsLower (position lower : Nat) (flagged : Bool)
    (evaluate : CaptionActiveNode → CaptionActiveEval) (actives : List CaptionActiveNode)
    (inside : lower ≤ position+1) :
    ∀ node ∈ captionActiveSuccessors position flagged evaluate actives, lower ≤ node.position := by
  induction actives with
  | nil => simp [captionActiveSuccessors]
  | cons head tail ih =>
    simp only [captionActiveSuccessors]
    split
    · intro node member
      simp only [List.mem_cons] at member
      rcases member with rfl | later
      · exact inside
      · exact ih node later
    · exact ih

private theorem activeStepLower (position lower : Nat) (forced flagged : Bool)
    (evaluate : CaptionActiveNode → CaptionActiveEval) (actives : List CaptionActiveNode)
    (inside : lower ≤ position+1) (old : ∀ node ∈ actives, lower ≤ node.position) :
    ∀ node ∈ captionActiveStep position forced flagged evaluate actives, lower ≤ node.position := by
  have fresh := successorsLower position lower flagged evaluate actives inside
  have folded := captionFold_preserves
    (captionActiveSuccessors position flagged evaluate actives) [] fresh (by simp)
  intro node member
  simp only [captionActiveStep,captionMemberAppend] at member
  rcases member with survived | created
  · split at survived
    · contradiction
    · exact old node (List.mem_filter.mp survived).1
  · exact folded node created

structure CaptionScanContext where
  items : List CaptionItemKind
  candidates : List Nat
  forced : Nat → Bool
  flagged : Nat → Bool
  evaluate : Nat → CaptionActiveNode → CaptionActiveEval
  finite : CaptionActiveNode → Nat → Bool
  overflow : Nat → CaptionActiveNode → Int
  allowOverfull : Bool

structure CaptionScanState where
  lower : Nat
  remaining : List Nat
  actives : List CaptionActiveNode

/-- lower is a ghost lower bound; the implementation stores only the
    remaining candidates and actives. Restarting drops exactly those
    candidates whose source position is at or before the chosen break. -/
def captionScanNext (context : CaptionScanContext) (state : CaptionScanState) :
    Option CaptionScanState :=
  match state.remaining with
  | [] => none
  | position :: rest =>
      let next := captionActiveStep position (context.forced position) (context.flagged position)
        (context.evaluate position) state.actives
      if context.allowOverfull && next.isEmpty then
        match captionChoosePush (captionPushOptions context.items context.candidates position
            context.flagged (fun prior p => context.evaluate p prior) context.finite state.actives) with
        | some selected =>
            some ⟨selected.node.position,
              context.candidates.filter (fun p => decide (selected.node.position ≤ p)),[selected.node]⟩
        | none =>
            let rescued := match captionChooseOverflow (context.overflow position) state.actives with
              | none => []
              | some prior => [captionRescueNode position (context.flagged position) prior]
            some ⟨position+1,rest,rescued⟩
      else some ⟨state.lower,rest,next⟩

def CaptionScanValid (context : CaptionScanContext) (state : CaptionScanState) : Prop :=
  state.lower ≤ context.items.length+1 ∧
  state.remaining.length ≤ context.candidates.length ∧
  CaptionCandidatesOrdered state.lower context.items.length state.remaining ∧
  (∀ node ∈ state.actives, state.lower ≤ node.position)

def captionStateRank (context : CaptionScanContext) (state : CaptionScanState) : Nat :=
  captionScanRank context.items.length context.candidates.length state.lower state.remaining.length

private theorem normalScanValid (context : CaptionScanContext) (state : CaptionScanState)
    (position : Nat) (rest : List Nat) (source : state.remaining = position :: rest)
    (valid : CaptionScanValid context state) :
    CaptionScanValid context
      ⟨state.lower,rest,captionActiveStep position (context.forced position) (context.flagged position)
        (context.evaluate position) state.actives⟩ := by
  have ordered : CaptionCandidatesOrdered state.lower context.items.length (position::rest) :=
    by simpa [source] using valid.2.2.1
  refine ⟨valid.1,?_,?_,?_⟩
  · have size := valid.2.1
    simp only [source,List.length_cons] at size
    exact Nat.le_trans (Nat.le_succ _) size
  · exact candidatesWeaken (position+1) state.lower context.items.length rest ordered.2.2
      (by have := ordered.1; omega)
  · exact activeStepLower position state.lower (context.forced position) (context.flagged position)
      (context.evaluate position) state.actives (by have := ordered.1; omega) valid.2.2.2

private theorem rescueScanValid (context : CaptionScanContext) (state : CaptionScanState)
    (position : Nat) (rest : List Nat) (source : state.remaining = position :: rest)
    (valid : CaptionScanValid context state) :
    CaptionScanValid context
      ⟨position+1,rest,match captionChooseOverflow (context.overflow position) state.actives with
        | none => []
        | some prior => [captionRescueNode position (context.flagged position) prior]⟩ := by
  have ordered : CaptionCandidatesOrdered state.lower context.items.length (position::rest) :=
    by simpa [source] using valid.2.2.1
  refine ⟨by change position+1 ≤ context.items.length+1; have := ordered.2.1; omega,?_,ordered.2.2,?_⟩
  · have size := valid.2.1
    simp only [source,List.length_cons] at size
    exact Nat.le_trans (Nat.le_succ _) size
  · split
    · simp
    · intro node member
      simp only [List.mem_cons,List.not_mem_nil,or_false] at member
      subst node
      exact Nat.le_refl _

private theorem restartScanValid (context : CaptionScanContext) (state : CaptionScanState)
    (position : Nat) (rest : List Nat) (source : state.remaining = position :: rest)
    (valid : CaptionScanValid context state)
    (original : CaptionCandidatesOrdered 0 context.items.length context.candidates)
    (selected : CaptionPushOption)
    (chosen : captionChoosePush (captionPushOptions context.items context.candidates position
      context.flagged (fun prior p => context.evaluate p prior) context.finite state.actives) = some selected) :
    CaptionScanValid context ⟨selected.node.position,
      context.candidates.filter (fun p => decide (selected.node.position ≤ p)),[selected.node]⟩ := by
  have ordered : CaptionCandidatesOrdered state.lower context.items.length (position::rest) :=
    by simpa [source] using valid.2.2.1
  have progress := I1_caption_push_out_advances context.items context.candidates position state.lower
    context.flagged (fun prior p => context.evaluate p prior) context.finite state.actives selected valid.2.2.2 chosen
  refine ⟨by change selected.node.position ≤ context.items.length+1; have := ordered.2.1; omega,filterCount _ _,?_,?_⟩
  · simpa using candidatesFilter 0 context.items.length selected.node.position context.candidates original
  · intro node member
    simp only [List.mem_cons,List.not_mem_nil,or_false] at member
    subst node
    exact Nat.le_refl _


/-- Every branch of the real scan control flow preserves its finite-source
    invariant and strictly lowers one natural rank. In particular, a
    pushOut restart is not treated as consumption of the old tail. -/
theorem I1_caption_full_scan_step (context : CaptionScanContext)
    (state next : CaptionScanState)
    (original : CaptionCandidatesOrdered 0 context.items.length context.candidates)
    (valid : CaptionScanValid context state)
    (advanced : captionScanNext context state = some next) :
    CaptionScanValid context next ∧ captionStateRank context next < captionStateRank context state := by
  cases source : state.remaining with
  | nil => simp [captionScanNext,source] at advanced
  | cons position rest =>
    have ordered : CaptionCandidatesOrdered state.lower context.items.length (position::rest) :=
      by simpa [source] using valid.2.2.1
    have restSize : rest.length ≤ context.candidates.length := by
      have size := valid.2.1
      simp only [source,List.length_cons] at size
      omega
    simp only [captionScanNext,source] at advanced
    split at advanced
    · split at advanced
      · rename_i selected chosen
        cases advanced
        refine ⟨restartScanValid context state position rest source valid original selected chosen,?_⟩
        have progress := I1_caption_push_out_advances context.items context.candidates position state.lower
          context.flagged (fun prior p => context.evaluate p prior) context.finite state.actives selected valid.2.2.2 chosen
        exact I1_caption_restart_scan_rank context.items.length context.candidates.length
          state.lower selected.node.position state.remaining.length
          (context.candidates.filter (fun p => decide (selected.node.position ≤ p))).length
          progress.1 (by have := ordered.2.1; omega) (filterCount _ _)
      · cases advanced
        refine ⟨rescueScanValid context state position rest source valid,?_⟩
        exact I1_caption_restart_scan_rank context.items.length context.candidates.length
          state.lower (position+1) state.remaining.length rest.length
          (by have := ordered.1; omega) (by have := ordered.2.1; omega) restSize
    · cases advanced
      refine ⟨normalScanValid context state position rest source valid,?_⟩
      simpa only [captionStateRank,source,List.length_cons] using
        I1_caption_ordinary_scan_rank context.items.length context.candidates.length state.lower rest.length

/-- There is no infinite scan, including arbitrarily many possible
    pushOut restarts and overfull rescues. No retry limit or fuel bound is
    added to the implementation's transition rules. -/
theorem I1_caption_full_scan_terminates (context : CaptionScanContext)
    (states : Nat → CaptionScanState)
    (original : CaptionCandidatesOrdered 0 context.items.length context.candidates)
    (initial : CaptionScanValid context (states 0))
    (infinite : ∀ index, captionScanNext context (states index) = some (states (index+1))) : False := by
  have valid : ∀ index, CaptionScanValid context (states index) := by
    intro index
    induction index with
    | zero => exact initial
    | succ index ih =>
      exact (I1_caption_full_scan_step context (states index) (states (index+1)) original ih (infinite index)).1
  have decreases : ∀ index,
      captionStateRank context (states (index+1)) < captionStateRank context (states index) :=
    fun index => (I1_caption_full_scan_step context (states index) (states (index+1))
      original (valid index) (infinite index)).2
  have bounded : ∀ index, captionStateRank context (states index)+index ≤ captionStateRank context (states 0) := by
    intro index
    induction index with
    | zero => exact Nat.le_refl _
    | succ index ih =>
      simp only [Nat.succ_eq_add_one]
      have drop := decreases index
      omega
  have exhausted := bounded (captionStateRank context (states 0)+1)
  omega

theorem I1_caption_full_scan_start_valid (context : CaptionScanContext)
    (original : CaptionCandidatesOrdered 0 context.items.length context.candidates) :
    CaptionScanValid context ⟨0,context.candidates,[captionInitialActive]⟩ := by
  refine ⟨Nat.zero_le _,Nat.le_refl _,original,?_⟩
  intro node _
  exact Nat.zero_le _


/-- The ordered-domain assumption is derived from the item scanner,
    including explicit/pattern hyphen filtering and preceding-box glue. -/
theorem I1_caption_generated_scan_order (patterns prevBox : Bool) (start : Nat)
    (items : List CaptionItemKind) :
    CaptionCandidatesOrdered start (start+items.length)
      (captionBreakIndices patterns prevBox start items) := by
  induction items generalizing start prevBox with
  | nil => trivial
  | cons item tail ih =>
    have later := ih (decide (item = .box)) (start+1)
    have tailOrdered : CaptionCandidatesOrdered (start+1) (start+(item::tail).length)
        (captionBreakIndices patterns (decide (item = .box)) (start+1) tail) :=
      by simpa only [List.length_cons,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using later
    simp only [captionBreakIndices]
    split
    · exact ⟨Nat.le_refl _,by simp only [List.length_cons]; omega,tailOrdered⟩
    · exact candidatesWeaken (start+1) start _ _ tailOrdered (Nat.le_succ _)

/-- Whole-scan termination starts from the actual item-derived candidate
    list, rather than assuming that a caller supplies an ordered list. -/
theorem I1_caption_generated_scan_terminates (context : CaptionScanContext) (patterns : Bool)
    (source : context.candidates = captionBreakIndices patterns false 0 context.items)
    (states : Nat → CaptionScanState)
    (start : states 0 = ⟨0,context.candidates,[captionInitialActive]⟩)
    (infinite : ∀ index, captionScanNext context (states index) = some (states (index+1))) : False := by
  have original : CaptionCandidatesOrdered 0 context.items.length context.candidates := by
    rw [source]
    simpa only [Nat.zero_add] using I1_caption_generated_scan_order patterns false 0 context.items
  apply I1_caption_full_scan_terminates context states original
  · rw [start]
    exact I1_caption_full_scan_start_valid context original
  · exact infinite

private def captionRestartFixture : CaptionScanContext :=
  { items := [.box,.glue,.box,.penalty (-10000) false], candidates := [1,3],
    forced := fun position => decide (position = 3), flagged := fun _ => false,
    evaluate := fun position _ => ⟨2,0,false,decide (position = 1)⟩,
    finite := fun _ _ => true, overflow := fun _ _ => 0, allowOverfull := true }

example : captionBreakIndices true false 0 captionRestartFixture.items =
    captionRestartFixture.candidates := by decide

/-- A loose earlier break is retried from the complete source candidate
    list, then rescue consumes the final forced break. Dropping the old
    tail at pushOut would lose that forced break instead. -/
example :
    (((captionScanNext captionRestartFixture ⟨0,[1,3],[captionInitialActive]⟩).bind
      (captionScanNext captionRestartFixture)).bind
      (captionScanNext captionRestartFixture)).map
      (fun state => (state.lower,state.remaining,state.actives.map
        (fun node => (node.position,node.lineCount,node.fitness,node.history)))) =
    some (4,[],[(4,2,3,[(3,3),(1,2)])]) := by rfl



/-- Inside the after/skip run that follows a break, a later break lands
    on the same stopping point: the skipped run continues past it. -/
theorem I1_caption_discard_inside_same_start (items : List CaptionItemKind) (k : Nat)
    (inside : k < captionDiscardCount items) :
    k + 1 + captionDiscardCount (items.drop (k+1)) = captionDiscardCount items := by
  induction items generalizing k with
  | nil => exact absurd inside (Nat.not_lt_zero _)
  | cons head tail ih =>
    cases head with
    | box => exact absurd inside (Nat.not_lt_zero _)
    | glue =>
      simp only [captionDiscardCount] at inside ⊢
      cases k with
      | zero => simp only [List.drop_succ_cons,List.drop_zero]; try omega
      | succ k =>
        have := ih k (by omega)
        simp only [List.drop_succ_cons] at this ⊢
        omega
    | penalty value flag =>
      by_cases forced : value ≤ -10000
      · simp only [captionDiscardCount,forced,if_true] at inside
        exact absurd inside (Nat.not_lt_zero _)
      · simp only [captionDiscardCount,forced,if_false] at inside ⊢
        cases k with
        | zero => simp only [List.drop_succ_cons,List.drop_zero]; try omega
        | succ k =>
          have := ih k (by omega)
          simp only [List.drop_succ_cons] at this ⊢
          omega

/-- Chosen breaks in source order, encoded by the anchor e: zero at the
    paragraph start, otherwise one past the previous break. Each break is
    a real non-box item and the last one is the final source item. -/
def CaptionBreaksFrom (kinds : List CaptionItemKind) : Nat → List Nat → Prop
  | e, [] => e = kinds.length
  | e, b :: bs => e ≤ b ∧ b < kinds.length ∧ kinds.get? b ≠ some .box ∧
      CaptionBreaksFrom kinds (b+1) bs

private theorem afterEncoded_succ (items : List CaptionItemKind) (b : Nat) :
    captionAfterEncoded items (b+1) = b+1+captionDiscardCount (items.drop (b+1)) := by
  simp [captionAfterEncoded,captionNextSourceStart]

private theorem map_drop' {α β : Type} (f : α → β) (xs : List α) (n : Nat) :
    (xs.drop n).map f = (xs.map f).drop n := by
  induction xs generalizing n with
  | nil => simp
  | cons h t ih => cases n <;> simp [ih]

private theorem drop_drop' {α : Type} (xs : List α) (m n : Nat) :
    (xs.drop m).drop n = xs.drop (n+m) := by
  induction xs generalizing m with
  | nil => simp
  | cons h t ih =>
    cases m with
    | zero => rfl
    | succ m => simpa [Nat.add_succ] using ih m

private theorem drop_get_cons {α : Type} (xs : List α) (b : Nat) (inside : b < xs.length) :
    xs.drop b = xs.get ⟨b,inside⟩ :: xs.drop (b+1) := by
  induction xs generalizing b with
  | nil => exact absurd inside (Nat.not_lt_zero _)
  | cons h t ih =>
    cases b with
    | zero => rfl
    | succ b => simpa using ih b (by simp at inside; omega)

/-- Any source-ordered sequence of non-box breaks ending at the last item
    passes the whole-source assembly check, including breaks that fall in
    the previous break's discarded run and so make an empty display line. -/
theorem I1_caption_ordered_breaks_assemble {α : Type} (kind : α → CaptionItemKind)
    (original : List α) (breaks : List Nat) (e : Nat)
    (valid : CaptionBreaksFrom (original.map kind) e breaks) :
    ∃ lines, captionAssembleFrom kind original
      (original.drop (captionAfterEncoded (original.map kind) e))
      (captionAfterEncoded (original.map kind) e) breaks = some lines := by
  induction breaks generalizing e with
  | nil =>
    have last : e = original.length := by simpa [CaptionBreaksFrom] using valid
    have ge := captionAfterEncoded_ge (original.map kind) e
    have empty : original.drop (captionAfterEncoded (original.map kind) e) = [] :=
      List.drop_eq_nil_of_le (by omega)
    refine ⟨[],?_⟩
    simp only [captionAssembleFrom,empty,List.isEmpty,if_true]
  | cons b bs ih =>
    obtain ⟨anchored,inside,notBox,rest⟩ := valid
    have inside' : b < original.length := by simpa using inside
    have split := drop_get_cons original b inside'
    have kindNotBox : kind (original.get ⟨b,inside'⟩) ≠ .box := by
      intro isBox
      apply notBox
      simp [List.get?_map, List.get?_eq_get inside', isBox]
    have notBoxB : (kind (original.get ⟨b,inside'⟩) == .box) = false := by
      cases eq : kind (original.get ⟨b,inside'⟩) <;> simp_all <;> rfl
    have nextStart : b+1+captionDiscardCount ((original.drop (b+1)).map kind) =
        captionAfterEncoded (original.map kind) (b+1) := by
      rw [afterEncoded_succ, map_drop']
    obtain ⟨later,laterEq⟩ := ih (b+1) rest
    let start := captionAfterEncoded (original.map kind) e
    by_cases ordered : start ≤ b
    · have dropped : (original.drop start).drop (b-start) = original.drop b := by
        rw [drop_drop']; congr 1; omega
      have restDrop : (original.drop (b+1)).drop
          (captionDiscardCount ((original.drop (b+1)).map kind)) =
          original.drop (captionAfterEncoded (original.map kind) (b+1)) := by
        rw [drop_drop', ← nextStart]; congr 1; omega
      refine ⟨(original.drop start).take (b-start) :: later,?_⟩
      show captionAssembleFrom kind original (original.drop start) start (b :: bs) = _
      simp only [captionAssembleFrom,ordered,if_true,dropped,split,notBoxB]
      simp only [if_false]
      rw [restDrop,nextStart,laterEq]
    · -- b lies inside the discarded run that follows the previous break.
      have positive : e ≠ 0 := by
        intro zero
        apply ordered
        simp [start,captionAfterEncoded,zero]
      have startEq : start = e + captionDiscardCount ((original.map kind).drop e) := by
        simp [start,captionAfterEncoded,positive,captionNextSourceStart]
      have within : b - e < captionDiscardCount ((original.map kind).drop e) := by omega
      have same := I1_caption_discard_inside_same_start ((original.map kind).drop e) (b-e) within
      rw [drop_drop'] at same
      have sameStart : captionAfterEncoded (original.map kind) (b+1) = start := by
        rw [afterEncoded_succ, startEq]
        have : b - e + 1 + e = b + 1 := by omega
        rw [this] at same
        omega
      have nextEq : b+1+captionDiscardCount ((original.drop (b+1)).map kind) = start := by
        rw [nextStart,sameStart]
      refine ⟨[] :: later,?_⟩
      show captionAssembleFrom kind original (original.drop start) start (b :: bs) = _
      simp only [captionAssembleFrom,ordered,if_false,split,notBoxB]
      simp only [if_false,nextEq,if_true]
      rw [← sameStart,laterEq]

/-- One past the last break of a reverse history; zero at the paragraph
    start. This is the encoded node position in the scan. -/
def captionLastAnchor : List (Nat × Nat) → Nat
  | [] => 0
  | (b,_) :: _ => b+1

/-- The history of an active node in the scan: strictly ordered actual
    candidates, its line count, and a position that is exactly one past
    its own last break. -/
def CaptionNodeHistory (candidates : List Nat) (node : CaptionActiveNode) : Prop :=
  CaptionHistoryOrdered node.position node.history ∧
  node.lineCount = node.history.length ∧
  (∀ entry ∈ node.history, entry.1 ∈ candidates) ∧
  node.position = captionLastAnchor node.history

/-- Scan invariant on histories, beside the rank invariant CaptionScanValid:
    remaining candidates are actual candidates and no active node lies
    after a candidate still to be scanned. -/
def CaptionScanHistory (context : CaptionScanContext) (state : CaptionScanState) : Prop :=
  (∀ c ∈ state.remaining, c ∈ context.candidates) ∧
  ∀ node ∈ state.actives, CaptionNodeHistory context.candidates node ∧
    ∀ c ∈ state.remaining, node.position ≤ c

private theorem candidatesOrdered_lower (lower upper : Nat) (candidates : List Nat)
    (ordered : CaptionCandidatesOrdered lower upper candidates) :
    ∀ c ∈ candidates, lower ≤ c := by
  induction candidates generalizing lower with
  | nil => simp
  | cons head tail ih =>
    intro c member
    simp only [List.mem_cons] at member
    rcases member with rfl | later
    · exact ordered.1
    · have := ih (head+1) ordered.2.2 c later
      have := ordered.1
      omega

private theorem successorsAnchored (position : Nat) (flagged : Bool)
    (evaluate : CaptionActiveNode → CaptionActiveEval) (actives : List CaptionActiveNode) :
    ∀ node ∈ captionActiveSuccessors position flagged evaluate actives,
      node.position = captionLastAnchor node.history := by
  induction actives with
  | nil => simp [captionActiveSuccessors]
  | cons head tail ih =>
    simp only [captionActiveSuccessors]
    split
    · intro node member
      simp only [List.mem_cons] at member
      rcases member with rfl | later
      · rfl
      · exact ih node later
    · exact ih

private theorem activeStepHistory (position : Nat) (forced flagged : Bool)
    (evaluate : CaptionActiveNode → CaptionActiveEval) (actives : List CaptionActiveNode)
    (candidates : List Nat) (candidate : position ∈ candidates)
    (old : ∀ node ∈ actives, CaptionNodeHistory candidates node ∧ node.position ≤ position) :
    ∀ node ∈ captionActiveStep position forced flagged evaluate actives,
      CaptionNodeHistory candidates node ∧ node.position ≤ position+1 := by
  have valid := I1_caption_active_step_history position forced flagged evaluate actives candidates
    candidate (fun node member =>
      let h := old node member
      ⟨h.2,h.1.2.1,h.1.1,h.1.2.2.1⟩)
  have fresh := successorsAnchored position flagged evaluate actives
  have folded := captionFold_preserves
    (captionActiveSuccessors position flagged evaluate actives) [] fresh (by simp)
  intro node member
  have v := valid node member
  have anchored : node.position = captionLastAnchor node.history := by
    simp only [captionActiveStep,captionMemberAppend] at member
    rcases member with survived | created
    · split at survived
      · contradiction
      · exact (old node (List.mem_filter.mp survived).1).1.2.2.2
    · exact folded node created
  exact ⟨⟨v.2.2.1,v.2.1,v.2.2.2,anchored⟩,v.1⟩

private theorem mem_of_mem_reverse' {α : Type} {x : α} {xs : List α}
    (member : x ∈ xs.reverse) : x ∈ xs := by
  induction xs with
  | nil => simp at member
  | cons h t ih =>
    rw [List.reverse_cons] at member
    rcases captionMemberAppend x t.reverse [h] |>.mp member with left | right
    · exact List.Mem.tail _ (ih left)
    · simp only [List.mem_cons,List.not_mem_nil,or_false] at right
      subst right
      exact List.Mem.head _

private theorem pushOptionsHistory (items : List CaptionItemKind) (candidates : List Nat)
    (before : Nat) (flagged : Nat → Bool)
    (evaluate : CaptionActiveNode → Nat → CaptionActiveEval)
    (finite : CaptionActiveNode → Nat → Bool) (actives : List CaptionActiveNode)
    (old : ∀ node ∈ actives, CaptionNodeHistory candidates node) :
    ∀ option ∈ captionPushOptions items candidates before flagged evaluate finite actives,
      CaptionNodeHistory candidates option.node := by
  induction actives with
  | nil => simp [captionPushOptions]
  | cons prior rest ih =>
    have headOk := old prior (List.Mem.head _)
    have tailOk : ∀ node ∈ rest, CaptionNodeHistory candidates node :=
      fun node member => old node (List.Mem.tail _ member)
    simp only [captionPushOptions]
    split
    · exact ih tailOk
    · rename_i position selected
      have source := captionFindPushBreak_sound (captionAfterEncoded items prior.position)
        before (finite prior) candidates.reverse position selected
      have after := captionAfterEncoded_ge items prior.position
      intro option member
      simp only [List.mem_cons] at member
      rcases member with rfl | later
      · refine ⟨⟨Nat.lt_succ_self _,?_⟩,?_,?_,rfl⟩
        · exact captionHistoryOrdered_mono prior.position position prior.history headOk.1 (by omega)
        · simp only [List.length_cons]; exact congrArg Nat.succ headOk.2.1
        · intro entry entryMember
          simp only [List.mem_cons] at entryMember
          rcases entryMember with rfl | older
          · exact mem_of_mem_reverse' source.1
          · exact headOk.2.2.1 entry older
      · exact ih tailOk option later

/-- Every branch of the real scan (ordinary update, pushOut restart over
    all candidates after the chosen break, overfull rescue) keeps each
    active history a strictly ordered list of actual candidates, anchored
    at the node's position, with the node's exact line count. -/
theorem I1_caption_scan_history_step (context : CaptionScanContext)
    (state next : CaptionScanState)
    (valid : CaptionScanValid context state)
    (history : CaptionScanHistory context state)
    (advanced : captionScanNext context state = some next) :
    CaptionScanHistory context next := by
  cases source : state.remaining with
  | nil => simp [captionScanNext,source] at advanced
  | cons position rest =>
    have ordered : CaptionCandidatesOrdered state.lower context.items.length (position::rest) :=
      by simpa [source] using valid.2.2.1
    have restAbove : ∀ c ∈ rest, position+1 ≤ c :=
      candidatesOrdered_lower (position+1) _ rest ordered.2.2
    have candidate : position ∈ context.candidates :=
      history.1 position (by rw [source]; exact List.Mem.head _)
    have restCandidates : ∀ c ∈ rest, c ∈ context.candidates :=
      fun c member => history.1 c (by rw [source]; exact List.Mem.tail _ member)
    have old : ∀ node ∈ state.actives,
        CaptionNodeHistory context.candidates node ∧ node.position ≤ position := by
      intro node member
      have h := history.2 node member
      exact ⟨h.1,h.2 position (by rw [source]; exact List.Mem.head _)⟩
    simp only [captionScanNext,source] at advanced
    split at advanced
    · split at advanced
      · rename_i selected chosen
        cases advanced
        have member := captionChoosePush_member _ selected chosen
        have nodeOk := pushOptionsHistory context.items context.candidates position context.flagged
          (fun prior p => context.evaluate p prior) context.finite state.actives
          (fun node member => (old node member).1) selected member
        refine ⟨fun c member => (List.mem_filter.mp member).1,?_⟩
        intro node nodeMember
        simp only [List.mem_cons,List.not_mem_nil,or_false] at nodeMember
        subst node
        refine ⟨nodeOk,?_⟩
        intro c member
        exact of_decide_eq_true (List.mem_filter.mp member).2
      · cases advanced
        refine ⟨restCandidates,?_⟩
        split
        · simp
        · rename_i prior chosen
          intro node nodeMember
          simp only [List.mem_cons,List.not_mem_nil,or_false] at nodeMember
          subst node
          have valid := I1_caption_rescue_history position (context.flagged position)
            context.candidates candidate (context.overflow position) state.actives prior
            (fun node member =>
              let h := old node member
              ⟨h.2,h.1.2.1,h.1.1,h.1.2.2.1⟩) chosen
          exact ⟨⟨valid.2.2.1,valid.2.1,valid.2.2.2,rfl⟩,restAbove⟩
    · cases advanced
      refine ⟨restCandidates,?_⟩
      have step := activeStepHistory position (context.forced position) (context.flagged position)
        (context.evaluate position) state.actives context.candidates candidate old
      intro node member
      have h := step node member
      exact ⟨h.1,fun c cm => Nat.le_trans h.2 (restAbove c cm)⟩

theorem I1_caption_scan_history_start (context : CaptionScanContext) :
    CaptionScanHistory context ⟨0,context.candidates,[captionInitialActive]⟩ := by
  refine ⟨fun _ member => member,?_⟩
  intro node member
  simp only [List.mem_cons,List.not_mem_nil,or_false] at member
  subst node
  exact ⟨⟨True.intro,rfl,by simp [captionInitialActive],rfl⟩,fun _ _ => Nat.zero_le _⟩

/-- A complete run of the scan: steps until captionScanNext stops, which
    happens exactly when no candidate remains (`go` returns its actives). -/
inductive CaptionScanRuns (context : CaptionScanContext) :
    CaptionScanState → CaptionScanState → Prop where
  | done (state : CaptionScanState) (stops : captionScanNext context state = none) :
      CaptionScanRuns context state state
  | step (state next final : CaptionScanState)
      (advanced : captionScanNext context state = some next)
      (rest : CaptionScanRuns context next final) :
      CaptionScanRuns context state final

/-- From any valid state the scan reaches a final state; there is no
    fuel or retry limit, only the rank that every branch lowers. -/
theorem I1_caption_scan_reaches_final (context : CaptionScanContext)
    (original : CaptionCandidatesOrdered 0 context.items.length context.candidates)
    (state : CaptionScanState) (valid : CaptionScanValid context state) :
    ∃ final, CaptionScanRuns context state final := by
  generalize rankEq : captionStateRank context state = rank
  induction rank using Nat.strongInductionOn generalizing state with
  | _ rank ih =>
    cases advanced : captionScanNext context state with
    | none => exact ⟨state,CaptionScanRuns.done state advanced⟩
    | some next =>
      have step := I1_caption_full_scan_step context state next original valid advanced
      obtain ⟨final,runs⟩ := ih _ (rankEq ▸ step.2) next step.1 rfl
      exact ⟨final,CaptionScanRuns.step state next final advanced runs⟩

theorem I1_caption_scan_runs_history (context : CaptionScanContext)
    (state final : CaptionScanState) (runs : CaptionScanRuns context state final)
    (original : CaptionCandidatesOrdered 0 context.items.length context.candidates)
    (valid : CaptionScanValid context state) (history : CaptionScanHistory context state) :
    CaptionScanHistory context final ∧ final.remaining = [] := by
  induction runs with
  | done state stops =>
    refine ⟨history,?_⟩
    cases remaining : state.remaining with
    | nil => rfl
    | cons position rest =>
      simp only [captionScanNext,remaining] at stops
      split at stops
      · split at stops <;> contradiction
      · contradiction
  | step state next _ advanced _ ih =>
    exact ih (I1_caption_full_scan_step context state next original valid advanced).1
      (I1_caption_scan_history_step context state next valid history advanced)

private theorem breakIndices_not_box (patterns prevBox : Bool) (start pos : Nat)
    (items : List CaptionItemKind) (member : pos ∈ captionBreakIndices patterns prevBox start items) :
    items.get? (pos-start) ≠ some .box := by
  induction items generalizing start prevBox with
  | nil => simp [captionBreakIndices] at member
  | cons item tail ih =>
    have range := I1_caption_break_index_range patterns prevBox start pos (item :: tail) member
    simp only [captionBreakIndices] at member
    split at member
    · rename_i accepted
      rcases List.mem_cons.mp member with eq | rest
      · subst pos
        simp only [Nat.sub_self,List.get?]
        intro isBox
        cases isBox
        simp [captionBreakCandidate] at accepted
      · have later := ih _ _ rest
        have inner := I1_caption_break_index_range _ _ _ _ _ rest
        have shift : pos - start = (pos - (start+1)) + 1 := by omega
        rw [shift]
        simpa only [List.get?] using later
    · have later := ih _ _ member
      have inner := I1_caption_break_index_range _ _ _ _ _ member
      have shift : pos - start = (pos - (start+1)) + 1 := by omega
      rw [shift]
      simpa only [List.get?] using later

private theorem historyBreaks (kinds : List CaptionItemKind) (candidates : List Nat)
    (good : ∀ c ∈ candidates, c < kinds.length ∧ kinds.get? c ≠ some .box)
    (ceiling : Nat) (history : List (Nat × Nat))
    (ordered : CaptionHistoryOrdered ceiling history)
    (source : ∀ entry ∈ history, entry.1 ∈ candidates) (rest : List Nat)
    (tail : CaptionBreaksFrom kinds (captionLastAnchor history) rest) :
    CaptionBreaksFrom kinds 0 (history.reverse.map Prod.fst ++ rest) := by
  induction history generalizing ceiling rest with
  | nil => simpa [captionLastAnchor] using tail
  | cons head older ih =>
    obtain ⟨b,f⟩ := head
    have bGood := good b (source (b,f) (List.Mem.head _))
    have olderSource : ∀ entry ∈ older, entry.1 ∈ candidates :=
      fun entry member => source entry (List.Mem.tail _ member)
    have shifted : CaptionBreaksFrom kinds (captionLastAnchor older) (b :: rest) := by
      refine ⟨?_,bGood.1,bGood.2,by simpa [captionLastAnchor] using tail⟩
      cases older with
      | nil => exact Nat.zero_le _
      | cons prior _ => exact ordered.2.1
    have := ih b ordered.2 olderSource (b :: rest) shifted
    simpa [List.reverse_cons,List.map_append,List.append_assoc] using this

/-- Caption candidate generation and the chosen history. Run the actual
    scan (ordinary update, pushOut restart, overfull rescue) to its end on
    the item-derived candidates. Whatever end node the final selection
    takes among those at the last source item, its history passes the
    whole-source assembly check: every source box is emitted exactly once
    in order, and the number of display lines is the node's line count. -/
theorem I1_caption_chosen_history_assembles {α : Type} (kind : α → CaptionItemKind)
    (source : List α) (context : CaptionScanContext) (patterns : Bool)
    (items : context.items = source.map kind)
    (generated : context.candidates = captionBreakIndices patterns false 0 context.items)
    (final : CaptionScanState)
    (runs : CaptionScanRuns context ⟨0,context.candidates,[captionInitialActive]⟩ final)
    (node : CaptionActiveNode) (member : node ∈ final.actives)
    (atEnd : node.position = context.items.length) :
    ∃ lines, captionAssembleWhole kind source (node.history.reverse.map Prod.fst) = some lines ∧
      lines.length = node.lineCount ∧
      (lines.map (captionBoxes kind)).join = captionBoxes kind source := by
  have original : CaptionCandidatesOrdered 0 context.items.length context.candidates := by
    rw [generated]
    simpa only [Nat.zero_add] using I1_caption_generated_scan_order patterns false 0 context.items
  have reached := I1_caption_scan_runs_history context _ final runs original
    (I1_caption_full_scan_start_valid context original) (I1_caption_scan_history_start context)
  have nodeOk := (reached.1.2 node member).1
  have good : ∀ c ∈ context.candidates, c < (source.map kind).length ∧
      (source.map kind).get? c ≠ some .box := by
    intro c cm
    rw [generated] at cm
    have range := I1_caption_break_index_range patterns false 0 c context.items cm
    have notBox := breakIndices_not_box patterns false 0 c context.items cm
    rw [items] at range notBox
    exact ⟨by simpa using range.2,by simpa using notBox⟩
  have breaks : CaptionBreaksFrom (source.map kind) 0 (node.history.reverse.map Prod.fst) := by
    have := historyBreaks (source.map kind) context.candidates good node.position node.history
      nodeOk.1 nodeOk.2.2.1 []
      (by show captionLastAnchor node.history = (source.map kind).length
          rw [← nodeOk.2.2.2, atEnd, items])
    simpa using this
  obtain ⟨lines,assembled⟩ := I1_caption_ordered_breaks_assemble kind source _ 0 breaks
  have whole : captionAssembleWhole kind source (node.history.reverse.map Prod.fst) = some lines := by
    simpa [captionAssembleWhole,captionAfterEncoded] using assembled
  have shape := I1_caption_assemble_with_empty_lines kind _ source source 0 lines whole
  refine ⟨lines,whole,?_,I1_caption_whole_payload_exact kind source _ lines whole⟩
  rw [shape.2,nodeOk.2.1]
  simp

/-- The whole pass: the scan from the item-derived candidates always
    reaches a final state, so the chosen-history theorem is not vacuous. -/
theorem I1_caption_generated_scan_completes (context : CaptionScanContext) (patterns : Bool)
    (generated : context.candidates = captionBreakIndices patterns false 0 context.items) :
    ∃ final, CaptionScanRuns context ⟨0,context.candidates,[captionInitialActive]⟩ final := by
  have original : CaptionCandidatesOrdered 0 context.items.length context.candidates := by
    rw [generated]
    simpa only [Nat.zero_add] using I1_caption_generated_scan_order patterns false 0 context.items
  exact I1_caption_scan_reaches_final context original _ (I1_caption_full_scan_start_valid context original)

/-- The restart fixture above ends with the history [(3,3),(1,2)]; its
    breaks, read forwards, assemble the source into two one-box lines. -/
example : captionAssembleWhole id [.box,.glue,.box,.penalty (-10000) false]
    ([(3,3),(1,2)].reverse.map Prod.fst) = some [[.box],[.box]] := by decide



/-! ## A direct transcription of the Alloy model, part 1

This section transcribes `docs/golem-layout/models/pagination.als` up to
the commands of docs/adr/0204 (`someFits` .. `tallFigure`) without the
Alloy scope. An item's `pos` is its index in `items`, so the facts that
positions are `0 .. #Item - 1` and distinct hold by construction. Every
other `fact input` conjunct is checked by `alloyInputFact`, including the
capacity range 3..6. `fact allPlacements` makes the Placement atoms
exactly the triples (brk in 0..#Text, kept ⊆ Figure, placed ⊆ Blank), so
`some p: Placement` and `no p: Placement` range over `alloyPlacements`.
Integers are unbounded naturals: the facts make `cap`, `used`, sizes and
need lines non-negative, and nothing here wraps as 5-bit Alloy integers
would. Where Alloy applies an integer comparison to a set of positions
(`p.kept.pos > i.pos`), it compares the sum, and so does `alloyKeptPosSum`. -/

/-- `0 .. n-1` in order, built by appending so that `n+1` unfolds to `n`. -/
def alloyRange : Nat → List Nat
  | 0 => []
  | n+1 => alloyRange n ++ [n]

inductive AlloyItem where
  | line (para : Nat)
  | heading
  | recto
  | figure (size : Nat)
  | blank
  | space
  | need (lines : Nat)
  deriving DecidableEq, Repr

structure AlloyInput where
  cap : Nat
  used : Nat
  items : List AlloyItem
  deriving DecidableEq, Repr

structure AlloyPlacement where
  brk : Nat
  kept : List Nat
  placed : List Nat
  deriving DecidableEq, Repr

namespace AlloyItem
def isText : AlloyItem → Bool
  | line _ | heading | recto | space => true
  | _ => false
def isHeading : AlloyItem → Bool
  | heading | recto => true
  | _ => false
def isRecto : AlloyItem → Bool
  | recto => true
  | _ => false
def isLine : AlloyItem → Bool
  | line _ => true
  | _ => false
def paraOf : AlloyItem → Option Nat
  | line q => some q
  | _ => none
def isFigure : AlloyItem → Bool
  | figure _ => true
  | _ => false
def isBlank : AlloyItem → Bool
  | blank => true
  | _ => false
def isSpace : AlloyItem → Bool
  | space => true
  | _ => false
def isNeed : AlloyItem → Bool
  | need _ => true
  | _ => false
def size : AlloyItem → Nat
  | figure s => s
  | _ => 0
def needLines : AlloyItem → Nat
  | need n => n
  | _ => 0
end AlloyItem

namespace AlloyInput
variable (inp : AlloyInput)

def itemAt (i : Nat) : Option AlloyItem := inp.items.get? i
def positions : List Nat := alloyRange inp.items.length
def has (P : AlloyItem → Bool) (i : Nat) : Bool := (inp.itemAt i).any P
def where_ (P : AlloyItem → Bool) : List Nat := inp.positions.filter (inp.has P)
def textCount : Nat := (inp.where_ AlloyItem.isText).length
def figures : List Nat := inp.where_ AlloyItem.isFigure
def blanks : List Nat := inp.where_ AlloyItem.isBlank
def sizeAt (i : Nat) : Nat := ((inp.itemAt i).map AlloyItem.size).getD 0
def isLineOf (q i : Nat) : Bool := (inp.itemAt i).any (fun item => item.paraOf == some q)
def paras : List Nat :=
  (inp.items.filterMap AlloyItem.paraOf).eraseDups
def paraLines (q : Nat) : List Nat := inp.positions.filter (inp.isLineOf q)
def paraOfAt (i : Nat) : Option Nat := (inp.itemAt i).bind AlloyItem.paraOf

/-- fun tpos: the number of text items before position t. -/
def tpos (t : Nat) : Nat := ((inp.where_ AlloyItem.isText).filter (· < t)).length

/-- fun first/second/last/beforeLast, as the line positions they select. -/
def first (q : Nat) : Option Nat := (inp.paraLines q).head?
def second (q : Nat) : Option Nat := (inp.paraLines q).get? 1
def last (q : Nat) : Option Nat := (inp.paraLines q).reverse.head?
def beforeLast (q : Nat) : Option Nat := (inp.paraLines q).reverse.get? 1
end AlloyInput

def alloySubsets : List Nat → List (List Nat)
  | [] => [[]]
  | x :: xs => let rest := alloySubsets xs; rest ++ rest.map (x :: ·)

/-- fact allPlacements: every placement exists, once. -/
def alloyPlacements (inp : AlloyInput) : List AlloyPlacement :=
  (alloyRange (inp.textCount+1)).bind fun b =>
    (alloySubsets inp.figures).bind fun kept =>
      (alloySubsets inp.blanks).map fun placed => ⟨b,kept,placed⟩

/-- fact input, without the scope of `for 5`. -/
def alloyInputFact (inp : AlloyInput) : Bool :=
  decide (3 ≤ inp.cap) && decide (inp.cap ≤ 6) && decide (inp.used ≤ inp.cap) &&
  decide (inp.figures.length ≤ 2) && decide (inp.blanks.length ≤ 1) &&
  decide ((inp.where_ AlloyItem.isSpace).length ≤ 1) &&
  decide ((inp.where_ AlloyItem.isNeed).length ≤ 2) &&
  inp.items.all (fun item => !item.isNeed ||
    (decide (1 ≤ item.needLines) && decide (item.needLines ≤ inp.cap+1))) &&
  inp.items.all (fun item => !item.isFigure ||
    (decide (1 ≤ item.size) && decide (item.size ≤ inp.cap+1))) &&
  -- the lines of a paragraph are together, nothing between them
  inp.positions.all fun l => inp.positions.all fun m =>
    match inp.paraOfAt l, inp.paraOfAt m with
    | some q, some r =>
      !(q == r) || inp.positions.all fun i =>
        !(decide (min l m < i) && decide (i < max l m)) || inp.paraOfAt i == some q
    | _, _ => true

section
variable (inp : AlloyInput) (p : AlloyPlacement)

def alloyText (i : Nat) : Bool := inp.has AlloyItem.isText i
def alloyHere (t : Nat) : Bool := decide (inp.tpos t < p.brk)
def alloyHereOpt : Option Nat → Bool
  | some t => alloyHere inp p t
  | none => decide (0 < p.brk)  -- tpos[none] = #{u | u.pos < 0} = 0

def alloyKeptPosSum : Nat := p.kept.foldl (· + ·) 0

def alloyLoad : Nat :=
  inp.used + (inp.positions.filter fun t => alloyText inp t && alloyHere inp p t).length +
    (p.kept.map inp.sizeAt).foldl (· + ·) 0 + p.placed.length

def alloyFits : Bool := decide (alloyLoad inp p ≤ inp.cap)

def alloyStartsColumn (i : Nat) : Bool :=
  decide (inp.used = 0) &&
  inp.positions.all (fun t => !(alloyText inp t && decide (t < i) && alloyHere inp p t)) &&
  (p.kept.isEmpty || decide (alloyKeptPosSum p > i))

def alloyStartsColumnOpt : Option Nat → Bool
  | some i => alloyStartsColumn inp p i
  | none => alloyStartsColumn inp p 0

def alloyGreedy : Bool :=
  decide (p.brk = inp.textCount) || decide (alloyLoad inp p + 1 > inp.cap)

def alloyTextBeforeHere (f : Nat) : Bool :=
  inp.positions.all fun t => !(alloyText inp t && decide (t < f)) || alloyHere inp p t

def alloyOrder : Bool := p.kept.all (alloyTextBeforeHere inp p)

def alloyFigure : Bool :=
  inp.figures.all fun f =>
    p.kept.contains f ==
      (alloyTextBeforeHere inp p f &&
        decide (inp.used + (inp.positions.filter fun t => alloyText inp t && decide (t < f)).length +
          inp.sizeAt f ≤ inp.cap))

def alloyOrphan : Bool :=
  inp.paras.all fun q =>
    !(decide (2 ≤ (inp.paraLines q).length) && alloyHereOpt inp p (inp.first q) &&
      !alloyHereOpt inp p (inp.second q)) || alloyStartsColumnOpt inp p (inp.first q)

def alloyWidow : Bool :=
  inp.paras.all fun q =>
    !(decide (2 ≤ (inp.paraLines q).length) && alloyHereOpt inp p (inp.beforeLast q) &&
      !alloyHereOpt inp p (inp.last q)) || alloyStartsColumnOpt inp p (inp.first q)

def alloyKeepHeading : Bool :=
  inp.positions.all fun h =>
    !(inp.has AlloyItem.isHeading h && alloyHere inp p h && !alloyStartsColumn inp p h) ||
    inp.positions.all fun t =>
      !(alloyText inp t && decide (t > h) &&
        inp.positions.all (fun i => !(decide (h < i) && decide (i < t)) || inp.has AlloyItem.isHeading i)) ||
      ((!inp.has AlloyItem.isHeading t || alloyHere inp p t) &&
       (match inp.paraOfAt t with
        | none => true
        | some q => alloyHereOpt inp p (inp.first q) &&
            ((inp.second q).isNone || alloyHereOpt inp p (inp.second q))))

def alloyNoSendFromEmpty : Bool :=
  !decide (inp.used = 0) ||
  inp.positions.all fun i =>
    let plain := fun j => !(inp.has AlloyItem.isBlank j) && !(inp.has AlloyItem.isNeed j)
    !(plain i && inp.positions.all (fun j => !(plain j && decide (j < i)))) ||
      (if alloyText inp i then decide (p.brk ≥ 1) else p.kept.contains i)

def alloyAll7 : Bool :=
  alloyFits inp p && alloyGreedy inp p && alloyOrder inp p && alloyFigure inp p &&
  alloyOrphan inp p && alloyWidow inp p && alloyKeepHeading inp p && alloyNoSendFromEmpty inp p
end

def alloyFiguresFit (inp : AlloyInput) : Bool :=
  inp.figures.all fun f => decide (inp.sizeAt f ≤ inp.cap)

def alloyInDomain (inp : AlloyInput) : Bool :=
  alloyFiguresFit inp && decide (inp.figures.length ≤ 1) && inp.blanks.isEmpty &&
  (inp.where_ AlloyItem.isSpace).isEmpty && (inp.where_ AlloyItem.isNeed).isEmpty

def alloySome (inp : AlloyInput) (P : AlloyPlacement → Bool) : Bool :=
  (alloyPlacements inp).any P

/-- The shape of the 0204 pair commands: each rule holds in some fitting
    placement, and no fitting placement meets both. -/
def alloyConflict (inp : AlloyInput) (A B : AlloyInput → AlloyPlacement → Bool) : Bool :=
  alloyInDomain inp &&
  alloySome inp (fun p => alloyFits inp p && A inp p) &&
  alloySome inp (fun p => alloyFits inp p && B inp p) &&
  !alloySome inp (fun p => alloyFits inp p && A inp p && B inp p)

/-! The `found` commands of the first group, on the transcribed
    predicates. Each witness meets `fact input` with a capacity in 3..6
    and at most five items, so it is also inside the Alloy scope. -/

/-- run someFits: with no rule but fitting, a placement exists. -/
theorem alloy_someFits :
    ∃ inp, alloyInputFact inp = true ∧ alloySome inp (alloyFits inp) = true :=
  ⟨⟨3,0,[]⟩,by decide,by decide⟩

/-- run noneMeetsAll: capacity 3 with two lines used, then two headings. -/
theorem alloy_noneMeetsAll :
    ∃ inp, alloyInputFact inp = true ∧ alloyInDomain inp = true ∧
      alloySome inp (alloyAll7 inp) = false :=
  ⟨⟨3,2,[.heading,.heading]⟩,by decide,by decide,by decide⟩

theorem alloy_greedyOrphan :
    ∃ inp, alloyInputFact inp = true ∧ alloyConflict inp alloyGreedy alloyOrphan = true :=
  ⟨⟨3,2,[.line 0,.line 0]⟩,by decide,by decide⟩

theorem alloy_greedyWidow :
    ∃ inp, alloyInputFact inp = true ∧ alloyConflict inp alloyGreedy alloyWidow = true :=
  ⟨⟨3,2,[.line 0,.line 0]⟩,by decide,by decide⟩

theorem alloy_greedyKeepHeading :
    ∃ inp, alloyInputFact inp = true ∧ alloyConflict inp alloyGreedy alloyKeepHeading = true :=
  ⟨⟨3,2,[.heading,.heading]⟩,by decide,by decide⟩

/-- run tallFigure: one figure one line taller than the empty column. -/
theorem alloy_tallFigure :
    ∃ inp, alloyInputFact inp = true ∧
      (decide (inp.figures.length ≤ 1) && inp.blanks.isEmpty &&
        (inp.where_ AlloyItem.isSpace).isEmpty && (inp.where_ AlloyItem.isNeed).isEmpty &&
        !alloyFiguresFit inp &&
        !alloySome inp (fun p => alloyFits inp p && alloyFigure inp p &&
          alloyNoSendFromEmpty inp p)) = true :=
  ⟨⟨3,0,[.figure 4]⟩,by decide,by decide⟩

/-! ### List facts for the transcription (core Lean 4.7 has few of them) -/

private theorem amMemAppend {α : Type} (x : α) (xs ys : List α) :
    x ∈ xs ++ ys ↔ x ∈ xs ∨ x ∈ ys := by
  induction xs with
  | nil => simp
  | cons h t ih => simp only [List.cons_append,List.mem_cons,ih,or_assoc]

theorem alloyRange_mem (x n : Nat) : x ∈ alloyRange n ↔ x < n := by
  induction n with
  | zero => simp [alloyRange]
  | succ n ih =>
    simp only [alloyRange,amMemAppend,ih,List.mem_cons,List.not_mem_nil,or_false]
    omega

private theorem amMemBind {α β : Type} (x : β) (l : List α) (f : α → List β) :
    x ∈ l.bind f ↔ ∃ a, a ∈ l ∧ x ∈ f a := by
  induction l with
  | nil => simp [List.bind]
  | cons h t ih =>
    show x ∈ f h ++ t.bind f ↔ _
    rw [amMemAppend,ih]
    constructor
    · rintro (here | ⟨a,m,inner⟩)
      · exact ⟨h,List.Mem.head _,here⟩
      · exact ⟨a,List.Mem.tail _ m,inner⟩
    · rintro ⟨a,m,inner⟩
      cases m with
      | head => exact Or.inl inner
      | tail _ m => exact Or.inr ⟨a,m,inner⟩

private theorem amFilterAppend {α : Type} (P : α → Bool) (xs ys : List α) :
    (xs ++ ys).filter P = xs.filter P ++ ys.filter P := by
  induction xs with
  | nil => rfl
  | cons h t ih =>
    simp only [List.cons_append,List.filter_cons,ih]
    split <;> rfl

private theorem amFilterNil {α : Type} (P : α → Bool) (l : List α)
    (none : ∀ x ∈ l, P x = false) : l.filter P = [] := by
  induction l with
  | nil => rfl
  | cons h t ih =>
    rw [List.filter_cons,none h (List.Mem.head _)]
    exact ih (fun x m => none x (List.Mem.tail _ m))

private theorem amFilterMono {α : Type} (P Q : α → Bool) (l : List α)
    (imp : ∀ x ∈ l, P x = true → Q x = true) :
    (l.filter P).length ≤ (l.filter Q).length := by
  induction l with
  | nil => exact Nat.le_refl _
  | cons h t ih =>
    have rest := ih (fun x m => imp x (List.Mem.tail _ m))
    simp only [List.filter_cons]
    by_cases ph : P h = true
    · rw [if_pos ph,if_pos (imp h (List.Mem.head _) ph)]
      simp only [List.length_cons]; omega
    · rw [if_neg ph]
      split <;> (try simp only [List.length_cons]) <;> omega

private theorem amPosLength {α : Type} (x : α) (l : List α) (m : x ∈ l) : 0 < l.length := by
  cases l with
  | nil => cases m
  | cons _ _ => exact Nat.succ_pos _

private theorem amSubsetsNil (l : List Nat) : [] ∈ alloySubsets l := by
  induction l with
  | nil => exact List.Mem.head _
  | cons h t ih => simp only [alloySubsets]; exact (amMemAppend _ _ _).mpr (Or.inl ih)

private theorem amSubsetsFilter (P : Nat → Bool) (l : List Nat) : l.filter P ∈ alloySubsets l := by
  induction l with
  | nil => exact List.Mem.head _
  | cons h t ih =>
    simp only [alloySubsets,List.filter_cons]
    rw [amMemAppend]
    split
    · exact Or.inr (List.mem_map.mpr ⟨_,ih,rfl⟩)
    · exact Or.inl ih

private theorem amFilterAtMostOne {α : Type} (P : α → Bool) (l : List α) (short : l.length ≤ 1) :
    l.filter P = [] ∨ ∃ f, l.filter P = [f] ∧ f ∈ l ∧ P f = true := by
  match l, short with
  | [], _ => exact Or.inl rfl
  | [a], _ =>
    by_cases pa : P a = true
    · exact Or.inr ⟨a,by simp [List.filter,pa],List.Mem.head _,pa⟩
    · exact Or.inl (by simp [List.filter,pa])
  | _ :: _ :: _, short => simp only [List.length_cons] at short; omega

private theorem amElemFilter (P : Nat → Bool) (l : List Nat) (f : Nat) (m : f ∈ l) :
    (l.filter P).contains f = P f := by
  show List.elem f (l.filter P) = P f
  cases pf : P f
  · cases e : List.elem f (l.filter P)
    · rfl
    · have := (List.mem_filter.mp (List.mem_of_elem_eq_true e)).2
      rw [pf] at this; cases this
  · exact List.elem_eq_true_of_mem (List.mem_filter.mpr ⟨m,pf⟩)

private theorem amGetMem {α : Type} (l : List α) (i : Nat) (x : α) (g : l.get? i = some x) : x ∈ l := by
  induction l generalizing i with
  | nil => cases g
  | cons h t ih =>
    cases i with
    | zero => cases g; exact List.Mem.head _
    | succ i => exact List.Mem.tail _ (ih i g)

private theorem amMemReverse {α : Type} (x : α) (l : List α) (m : x ∈ l.reverse) : x ∈ l := by
  induction l with
  | nil => simp at m
  | cons h t ih =>
    rw [List.reverse_cons,amMemAppend] at m
    rcases m with left | right
    · exact List.Mem.tail _ (ih left)
    · simp only [List.mem_cons,List.not_mem_nil,or_false] at right
      subst right; exact List.Mem.head _

/-- The first selected position of a filtered range is its least one. -/
private theorem amRangeHeadZero (P : Nat → Bool) (n : Nat)
    (m : 0 ∈ (alloyRange n).filter P) : ((alloyRange n).filter P).head? = some 0 := by
  induction n with
  | zero => simp [alloyRange] at m
  | succ n ih =>
    simp only [alloyRange,amFilterAppend] at m ⊢
    rcases (amMemAppend _ _ _).mp m with left | right
    · have h := ih left
      cases e : (alloyRange n).filter P with
      | nil => rw [e] at left; cases left
      | cons a rest => rw [e] at h; simpa using h
    · have zero : n = 0 := by
        have := (List.mem_filter.mp right).1
        simp only [List.mem_cons,List.not_mem_nil,or_false] at this
        omega
      subst zero
      simp only [alloyRange,List.nil_append] at right ⊢
      cases e : [0].filter P with
      | nil => rw [e] at right; cases right
      | cons a rest =>
        have := (List.mem_filter.mp (show a ∈ [0].filter P by rw [e]; exact List.Mem.head _)).1
        simp only [List.mem_cons,List.not_mem_nil,or_false] at this
        subst this; rfl

private theorem amRangeZeroCount (n : Nat) :
    ((alloyRange n).filter (fun x => x == 0)).length ≤ 1 := by
  induction n with
  | zero => simp [alloyRange]
  | succ n ih =>
    simp only [alloyRange,amFilterAppend,List.length_append]
    cases n with
    | zero => simp [alloyRange]
    | succ n =>
      have : ([n+1].filter (fun x => x == 0)) = [] := rfl
      rw [this]; simpa using ih

/-! ### Facts about transcribed inputs -/

namespace AlloyInput
variable (inp : AlloyInput)

theorem has_lt (P : AlloyItem → Bool) (i : Nat) (h : inp.has P i = true) : i < inp.items.length := by
  apply Nat.lt_of_not_le
  intro le
  simp [has,itemAt,List.get?_len_le le,Option.any] at h

theorem mem_where (P : AlloyItem → Bool) (i : Nat) : i ∈ inp.where_ P ↔ inp.has P i = true := by
  simp only [where_,positions,List.mem_filter,alloyRange_mem]
  exact ⟨fun h => h.2,fun h => ⟨inp.has_lt P i h,h⟩⟩

theorem has_none (P : AlloyItem → Bool) (empty : (inp.where_ P).isEmpty = true) (i : Nat) :
    inp.has P i = false := by
  cases e : inp.has P i
  · rfl
  · have m := (inp.mem_where P i).mpr e
    cases w : inp.where_ P with
    | nil => rw [w] at m; cases m
    | cons _ _ => rw [w] at empty; cases empty

theorem text_figure_disjoint (i : Nat) (t : inp.has AlloyItem.isText i = true)
    (f : inp.has AlloyItem.isFigure i = true) : False := by
  simp only [has] at t f
  cases e : inp.itemAt i with
  | none => rw [e] at t; cases t
  | some item =>
    rw [e] at t f
    cases item <;> simp [AlloyItem.isText,AlloyItem.isFigure,Option.any] at t f

/-- With a text at position zero, every later position has a text before it. -/
theorem tpos_pos (zero : inp.has AlloyItem.isText 0 = true) (t : Nat) (later : 0 < t) :
    0 < inp.tpos t := by
  apply amPosLength 0
  exact List.mem_filter.mpr ⟨(inp.mem_where _ 0).mpr zero,by simpa using later⟩
end AlloyInput

/-! ### The placement that meets every rule but the greedy fill -/

/-- Empty column with a text first: place that text alone. Otherwise
    place no text. Keep the figure exactly when the figure rule asks. -/
def alloyAllButGreedyBreak (inp : AlloyInput) : Nat :=
  if inp.used = 0 ∧ inp.has AlloyItem.isText 0 = true then 1 else 0

def alloyFigureRuleKept (inp : AlloyInput) (brk : Nat) : List Nat :=
  inp.figures.filter fun f =>
    alloyTextBeforeHere inp ⟨brk,[],[]⟩ f &&
      decide (inp.used + (inp.positions.filter fun t => alloyText inp t && decide (t < f)).length +
        inp.sizeAt f ≤ inp.cap)

def alloyAllButGreedyPlacement (inp : AlloyInput) : AlloyPlacement :=
  let brk := alloyAllButGreedyBreak inp
  ⟨brk,alloyFigureRuleKept inp brk,[]⟩

def alloyAllButGreedy (inp : AlloyInput) (p : AlloyPlacement) : Bool :=
  alloyFits inp p && alloyOrder inp p && alloyFigure inp p && alloyOrphan inp p &&
  alloyWidow inp p && alloyKeepHeading inp p && alloyNoSendFromEmpty inp p

private theorem textBeforeHere_brk (inp : AlloyInput) (p : AlloyPlacement) (f : Nat) :
    alloyTextBeforeHere inp p f = alloyTextBeforeHere inp ⟨p.brk,[],[]⟩ f := rfl

private theorem here_brk (inp : AlloyInput) (p : AlloyPlacement) (t : Nat) :
    alloyHere inp p t = decide (inp.tpos t < p.brk) := rfl

theorem alloy_all_but_greedy_meets (inp : AlloyInput)
    (domain : alloyInDomain inp = true) (capPos : 1 ≤ inp.cap) (usedFits : inp.used ≤ inp.cap) :
    alloyAllButGreedy inp (alloyAllButGreedyPlacement inp) = true := by
  simp only [alloyInDomain,Bool.and_eq_true,decide_eq_true_eq] at domain
  obtain ⟨⟨⟨⟨figFit,oneFig⟩,noBlank⟩,_noSpace⟩,noNeed⟩ := domain
  have blankFalse := inp.has_none _ noBlank
  have needFalse := inp.has_none _ noNeed
  generalize pEq : alloyAllButGreedyPlacement inp = p
  have brkEq : p.brk = alloyAllButGreedyBreak inp := by rw [← pEq]; rfl
  have keptEq : p.kept = alloyFigureRuleKept inp p.brk := by rw [← pEq]; rfl
  have placedEq : p.placed = [] := by rw [← pEq]; rfl
  -- Where the break puts text: nowhere, or only at position zero.
  have hereZero : ∀ t, alloyHere inp p t = true → t = 0 ∧ p.brk = 1 ∧ inp.used = 0 ∧
      inp.has AlloyItem.isText 0 = true := by
    intro t h
    rw [here_brk,decide_eq_true_eq,brkEq] at h
    unfold alloyAllButGreedyBreak at h
    split at h
    · rename_i c
      refine ⟨?_,by rw [brkEq]; unfold alloyAllButGreedyBreak; simp [c],c.1,c.2⟩
      by_cases zero : t = 0
      · exact zero
      · have := inp.tpos_pos c.2 t (by omega); omega
    · omega
  have keptShape : p.kept = [] ∨ ∃ f, p.kept = [f] ∧ f ∈ inp.figures ∧
      (alloyTextBeforeHere inp ⟨p.brk,[],[]⟩ f &&
        decide (inp.used + (inp.positions.filter fun t => alloyText inp t && decide (t < f)).length +
          inp.sizeAt f ≤ inp.cap)) = true := by
    rw [keptEq]; exact amFilterAtMostOne _ _ oneFig
  have figText : ∀ f, f ∈ inp.figures → inp.has AlloyItem.isText f = false := by
    intro f m
    cases e : inp.has AlloyItem.isText f
    · rfl
    · exact (inp.text_figure_disjoint f e ((inp.mem_where _ f).mp m)).elim
  -- Every column start used by the rules is position zero of an empty column.
  have startsZero : ∀ t, alloyHere inp p t = true → alloyStartsColumn inp p 0 = true := by
    intro t h
    obtain ⟨_,_,used,zeroText⟩ := hereZero t h
    simp only [alloyStartsColumn,Bool.and_eq_true,Bool.or_eq_true,decide_eq_true_eq,List.all_eq_true]
    refine ⟨⟨used,?_⟩,?_⟩
    · intro t _
      cases alloyText inp t <;> cases alloyHere inp p t <;> simp
    · rcases keptShape with none | ⟨f,one,m,_⟩
      · exact Or.inl (by rw [none]; rfl)
      · refine Or.inr ?_
        have nonzero : f ≠ 0 := by
          intro z; subst z; rw [figText 0 m] at zeroText; cases zeroText
        show p.kept.foldl (· + ·) 0 > 0
        rw [one]
        simp; omega
  simp only [alloyAllButGreedy,Bool.and_eq_true]
  refine ⟨⟨⟨⟨⟨⟨?fits,?order⟩,?figure⟩,?orphan⟩,?widow⟩,?keep⟩,?noSend⟩
  case fits =>
    simp only [alloyFits,alloyLoad,decide_eq_true_eq,placedEq,List.length_nil,Nat.add_zero]
    have count : (inp.positions.filter fun t => alloyText inp t && alloyHere inp p t).length ≤
        (inp.positions.filter fun t => t == 0).length :=
      amFilterMono _ _ _ (fun t _ h => by
        simp only [Bool.and_eq_true] at h
        simp [(hereZero t h.2).1])
    have one : (inp.positions.filter fun t => t == 0).length ≤ 1 := amRangeZeroCount _
    rcases keptShape with none | ⟨f,single,m,cond⟩
    · rw [none]
      simp only [List.map_nil,List.foldl_nil,Nat.add_zero]
      by_cases some : ∃ t, alloyHere inp p t = true
      · obtain ⟨t,h⟩ := some
        have := (hereZero t h).2.2.1
        omega
      · have zero : (inp.positions.filter fun t => alloyText inp t && alloyHere inp p t) = [] :=
          amFilterNil _ _ (fun t _ => by
            cases e : alloyHere inp p t
            · simp
            · exact (some ⟨t,e⟩).elim)
        rw [zero]; simpa using usedFits
    · rw [single]
      simp only [Bool.and_eq_true,decide_eq_true_eq] at cond
      simp only [List.map_cons,List.map_nil,List.foldl_cons,List.foldl_nil,Nat.zero_add]
      by_cases some : ∃ t, alloyHere inp p t = true
      · obtain ⟨t,h⟩ := some
        obtain ⟨_,_,_,zeroText⟩ := hereZero t h
        have nonzero : f ≠ 0 := by
          intro z; subst z; rw [figText 0 m] at zeroText; cases zeroText
        have before : 0 < (inp.positions.filter fun t => alloyText inp t && decide (t < f)).length := by
          apply amPosLength 0
          refine List.mem_filter.mpr ⟨?_,?_⟩
          · exact (alloyRange_mem 0 _).mpr (inp.has_lt _ 0 zeroText)
          · simp only [alloyText,zeroText,Bool.true_and,decide_eq_true_eq]; omega
        omega
      · have zero : (inp.positions.filter fun t => alloyText inp t && alloyHere inp p t) = [] :=
          amFilterNil _ _ (fun t _ => by
            cases e : alloyHere inp p t
            · simp
            · exact (some ⟨t,e⟩).elim)
        rw [zero]; simp only [List.length_nil,Nat.add_zero]; omega
  case order =>
    simp only [alloyOrder,List.all_eq_true]
    intro f m
    rw [keptEq] at m
    have := (List.mem_filter.mp m).2
    simp only [Bool.and_eq_true] at this
    rw [textBeforeHere_brk]; exact this.1
  case figure =>
    simp only [alloyFigure,List.all_eq_true]
    intro f m
    rw [keptEq]; unfold alloyFigureRuleKept
    rw [amElemFilter _ _ f m,textBeforeHere_brk inp p f]
    simp
  case orphan =>
    simp only [alloyOrphan,List.all_eq_true]
    intro q _
    simp only [Bool.or_eq_true,Bool.not_eq_true',Bool.and_eq_false_iff,Bool.not_eq_false']
    cases fq : inp.first q with
    | none =>
      left; left; left
      have empty : inp.paraLines q = [] := by
        cases e : inp.paraLines q with
        | nil => rfl
        | cons _ _ => simp [AlloyInput.first,e] at fq
      simp [empty]
    | some t =>
      cases h : alloyHere inp p t
      · left; left; right; simp [alloyHereOpt,h]
      · right; simp only [alloyStartsColumnOpt]
        have z := (hereZero t h).1
        subst z
        exact startsZero 0 h
  case widow =>
    simp only [alloyWidow,List.all_eq_true]
    intro q _
    simp only [Bool.or_eq_true,Bool.not_eq_true',Bool.and_eq_false_iff,Bool.not_eq_false']
    by_cases short : (inp.paraLines q).length < 2
    · left; left; left; simp only [decide_eq_false_iff_not]; omega
    · cases bq : inp.beforeLast q with
      | none =>
        have := List.get?_eq_none.mp (show (inp.paraLines q).reverse.get? 1 = none from bq)
        rw [List.length_reverse] at this; omega
      | some t =>
        cases h : alloyHere inp p t
        · left; left; right; simp [alloyHereOpt,h]
        · right
          have zero := (hereZero t h).1
          subst zero
          have m : 0 ∈ inp.paraLines q :=
            amMemReverse _ _ (amGetMem _ 1 0 bq)
          have head := amRangeHeadZero (inp.isLineOf q) inp.items.length m
          have first : inp.first q = some 0 := head
          simp only [alloyStartsColumnOpt,first]
          exact startsZero 0 h
  case keep =>
    simp only [alloyKeepHeading,List.all_eq_true]
    intro h _
    simp only [Bool.or_eq_true,Bool.not_eq_true',Bool.and_eq_false_iff,Bool.not_eq_false']
    left
    cases e : alloyHere inp p h
    · left; right; rfl
    · right
      have zero := (hereZero h e).1
      subst zero
      exact startsZero 0 e
  case noSend =>
    simp only [alloyNoSendFromEmpty,Bool.or_eq_true,Bool.not_eq_true',decide_eq_false_iff_not,
      List.all_eq_true]
    by_cases used : inp.used = 0
    · right
      intro i im
      have iLt := (alloyRange_mem i _).mp im
      simp only [Bool.or_eq_true,Bool.not_eq_true',Bool.and_eq_false_iff,blankFalse,needFalse,
        Bool.not_false,List.all_eq_true]
      by_cases zero : i = 0
      · subst zero
        right
        by_cases text : alloyText inp 0 = true
        · simp only [text,if_true,decide_eq_true_eq]
          rw [brkEq]; unfold alloyAllButGreedyBreak; simp [used,show inp.has AlloyItem.isText 0 = true from text]
        · simp only [text,if_false]
          have notText : inp.has AlloyItem.isText 0 = false := by
            cases e : inp.has AlloyItem.isText 0
            · rfl
            · exact (text e).elim
          -- Without blanks or needs, a non-text item is the figure.
          have isFig : inp.has AlloyItem.isFigure 0 = true := by
            have b0 := blankFalse 0
            have n0 := needFalse 0
            have t0 := notText
            simp only [AlloyInput.has] at b0 n0 t0 ⊢
            cases e : inp.itemAt 0 with
            | none => simp [AlloyInput.itemAt,List.get?_eq_none] at e; omega
            | some item =>
              rw [e] at b0 n0 t0
              cases item <;> simp [AlloyItem.isText,AlloyItem.isFigure,AlloyItem.isBlank,
                AlloyItem.isNeed,Option.any] at b0 n0 t0 ⊢
          have m := (inp.mem_where _ 0).mpr isFig
          rw [keptEq]; unfold alloyFigureRuleKept
          rw [amElemFilter _ inp.figures 0 m]
          simp only [Bool.and_eq_true,decide_eq_true_eq]
          refine ⟨?_,?_⟩
          · simp only [alloyTextBeforeHere,List.all_eq_true]
            intro t _
            cases alloyText inp t <;> simp
          · have fit := List.all_eq_true.mp figFit 0 m
            simp only [decide_eq_true_eq] at fit
            have none : (inp.positions.filter fun t => alloyText inp t && decide (t < 0)) = [] :=
              amFilterNil _ _ (fun t _ => by cases alloyText inp t <;> simp)
            rw [none,used]; simpa using fit
      · left
        right
        cases e : List.all inp.positions (fun j => !(true && true && decide (j < i)))
        · rfl
        · have := List.all_eq_true.mp e 0 ((alloyRange_mem 0 _).mpr (by omega))
          simp at this
          omega
    · left; exact used

theorem alloy_all_but_greedy_placement_exists (inp : AlloyInput) :
    alloyAllButGreedyPlacement inp ∈ alloyPlacements inp := by
  unfold alloyPlacements alloyAllButGreedyPlacement
  rw [amMemBind]
  refine ⟨alloyAllButGreedyBreak inp,?_,?_⟩
  · rw [alloyRange_mem]
    unfold alloyAllButGreedyBreak
    split
    · rename_i c
      have := amPosLength 0 _ ((inp.mem_where _ 0).mpr c.2)
      simp only [AlloyInput.textCount]; omega
    · omega
  · rw [amMemBind]
    exact ⟨_,amSubsetsFilter _ _,List.mem_map.mpr ⟨[],amSubsetsNil _,rfl⟩⟩

/-- Without the Alloy scope (any number of items, any capacity of at least
    one line, any figure size up to the capacity), some placement meets
    every rule of docs/adr/0204 but the greedy fill. -/
theorem alloy_noneMeetsAllButGreedy (inp : AlloyInput)
    (domain : alloyInDomain inp = true) (capPos : 1 ≤ inp.cap) (usedFits : inp.used ≤ inp.cap) :
    alloySome inp (alloyAllButGreedy inp) = true :=
  List.any_eq_true.mpr ⟨_,alloy_all_but_greedy_placement_exists inp,
    alloy_all_but_greedy_meets inp domain capPos usedFits⟩

/-- `fact input` gives the two numeric hypotheses (it also bounds the
    capacity by six, which the theorems above do not use). -/
theorem alloy_input_fact_bounds (inp : AlloyInput) (fact : alloyInputFact inp = true) :
    1 ≤ inp.cap ∧ inp.used ≤ inp.cap := by
  unfold alloyInputFact at fact
  simp only [Bool.and_eq_true] at fact
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨three,_⟩,used⟩,_⟩,_⟩,_⟩,_⟩,_⟩,_⟩,_⟩ := fact
  exact ⟨by have := of_decide_eq_true three; omega,of_decide_eq_true used⟩

/-- The capacity of one line is needed: an empty column of no lines with
    a line first sends nothing (noSendFromEmpty) only by overfilling. -/
example : alloySome ⟨0,0,[.line 0]⟩ (alloyAllButGreedy ⟨0,0,[.line 0]⟩) = false := by decide

private theorem alloyConflictAbsent (inp : AlloyInput) (A B : AlloyInput → AlloyPlacement → Bool)
    (domain : alloyInDomain inp = true) (capPos : 1 ≤ inp.cap) (usedFits : inp.used ≤ inp.cap)
    (both : alloyAllButGreedy inp (alloyAllButGreedyPlacement inp) = true →
      A inp (alloyAllButGreedyPlacement inp) = true ∧ B inp (alloyAllButGreedyPlacement inp) = true) :
    alloyConflict inp A B = false := by
  have meets := alloy_all_but_greedy_meets inp domain capPos usedFits
  have ab := both meets
  have fits : alloyFits inp (alloyAllButGreedyPlacement inp) = true := by
    simp only [alloyAllButGreedy,Bool.and_eq_true] at meets
    exact meets.1.1.1.1.1.1
  have some : alloySome inp (fun p => alloyFits inp p && A inp p && B inp p) = true :=
    List.any_eq_true.mpr ⟨_,alloy_all_but_greedy_placement_exists inp,by simp [fits,ab.1,ab.2]⟩
  simp [alloyConflict,some]

/-- The nine pair commands of the first group whose rules are both among
    the rules of `alloy_noneMeetsAllButGreedy` have no instance. -/
theorem alloy_orphanEmpty (inp : AlloyInput) (domain : alloyInDomain inp = true)
    (capPos : 1 ≤ inp.cap) (usedFits : inp.used ≤ inp.cap) :
    alloyConflict inp alloyOrphan alloyNoSendFromEmpty = false :=
  alloyConflictAbsent inp _ _ domain capPos usedFits (fun h => by
    simp only [alloyAllButGreedy,Bool.and_eq_true] at h; exact ⟨h.1.1.1.2,h.2⟩)


      (∀ p, .text p ∈ items → textHereAtBreak items b p = true →
        needAtPlacedText used capacity 2 items pos size space needs b kept p) ∧
      (used = 0 → ∀ p, firstContent items = some (.text p) → 0 < b) ∧
      (used = 0 → ∀ p, firstContent items = some (.figure p) →

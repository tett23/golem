theorem I3_keepDefaultDiffers : ∀ inp k, alloyInputFact inp = true → alloyKeepsFact inp k = true →
    (alloyInDomain inp && k.kept.isEmpty && k.allLines.isEmpty &&
      alloySome inp (fun p => alloyBase inp p &&

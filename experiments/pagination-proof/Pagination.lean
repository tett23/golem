    congr 1
    apply Bool.eq_iff_iff.mpr
    constructor
    · intro h
      obtain ⟨i, member, before⟩ := List.any_eq_true.mp h
      apply List.any_eq_true.mpr
      refine ⟨i, member, ?_⟩
      cases i <;> simp_all [keptBeforeBlank]
    · intro h

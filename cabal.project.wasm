-- The wasm build of Golem (docs/adr/0199): golem-wasm and the golem
-- packages it depends on, with the wasm GHC of scripts/fetch-ghc-wasm.sh
-- (ghc-wasm-meta, the 9.10 flavour):
--
--   . third_party/ghc-wasm/env
--   wasm32-wasi-cabal --project-file=cabal.project.wasm build exe:golem-wasm
--
-- Not here: golem-plugin, golem-cli, golem-lsp, golem-fixtures,
-- golem-test-support and the test-only packages. The versions of Hackage
-- are those of cabal.project.freeze (cabal.project.wasm.freeze, which
-- scripts/ci/wasm-freeze.sh checks); the boot packages are those of the
-- wasm GHC.
packages:
  modules/golem-assemble
  modules/golem-bibliography
  modules/golem-doc
  modules/golem-driver
  modules/golem-emet
  modules/golem-epub
  modules/golem-eval
  modules/golem-font
  modules/golem-html
  modules/golem-layout
  modules/golem-layout-spec
  modules/golem-length
  modules/golem-lint
  modules/golem-numerals
  modules/golem-parser
  modules/golem-pdf
  modules/golem-preflight
  modules/golem-project
  modules/golem-regex
  modules/golem-svg
  modules/golem-syntax
  modules/golem-text
  modules/golem-typeset
  modules/golem-wasm
  -- docs/adr/0202 section 2: the archives of Hackage with the patches of
  -- scripts/wasm/patches/, unpacked by scripts/fetch-wasm-packages.sh
  third_party/wasm-packages/skylighting-core-0.15.0.1
  third_party/wasm-packages/skylighting-0.15.0.1

tests: False

-- the plugins (golem-plugin, wasmtime) and golem new are left out
-- (docs/adr/0199 section 3)
package golem-driver
  flags: -plugins

-- the same commit as cabal.project (golem-parser ADR 0002)
source-repository-package
  type: git
  location: https://github.com/tett23/peg-hs
  tag: 4b4adc7046a14d18c8eec711f18dbcaa9b059cca
  subdir: packages/peg-runtime

-- docs/adr/0202 section 2: cborg of the upstream commit, which builds on
-- 32-bit targets; 0.2.10.0 of Hackage does not
source-repository-package
  type: git
  location: https://github.com/well-typed/cborg
  tag: 6ef2791ca41b397a3e36c868ad3e66a0d09f19b2
  subdir: cborg

-- PDF compression uses the bundled zlib at a fixed version (golem-pdf ADR 0001)
package zlib
  flags: +bundled-c-zlib

constraints: zlib-clib ==1.3.2

-- GHC is the version ghcup marks as recommended, which peg-runtime also
-- requires (ADR docs/adr/0001).
with-compiler: ghc-9.10.3

packages:
  modules/*/*.cabal

tests: True

-- peg-hs is not on Hackage yet; pin the commit (golem-parser ADR 0002).
source-repository-package
  type: git
  location: https://github.com/tett23/peg-hs
  tag: c20439cf3651b65cdeebd1734a4a42afbbee33bc
  subdir: packages/peg-runtime
          packages/peg-grammar
          packages/peg-codegen
          packages/peg-cli
          packages/peg-lsp

-- PDF compression uses the bundled zlib at a fixed version (golem-pdf ADR 0001).
package zlib
  flags: +bundled-c-zlib

constraints: zlib-clib ==1.3.2

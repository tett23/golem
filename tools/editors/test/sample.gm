%%                               ^ constant.numeric.golem
#### Four
%%<---- keyword.control.heading.golem
%%   ^^^^ markup.heading.golem
##### Five
%%<----- keyword.control.heading.golem
%%    ^^^^ markup.heading.golem
###### Six
%%<------ keyword.control.heading.golem
%%     ^^^ markup.heading.golem
####### Seven is not a heading
%%<------- source.golem
%%      ^^^^^ source.golem

Plain text with \[ an escape, [ruby kanji: reading] and [note alt="x": a | b].
%%<----- source.golem
%%              ^^ constant.character.escape.golem
%%                             ^^^^ entity.name.function.golem
%%                                  ^^^^^ string.unquoted.golem
%%                                         ^^^^^^^ source.golem
%%                                                            ^^^ variable.parameter.golem
%%                                                                ^^^ string.quoted.double.golem
%%                                                                       ^ keyword.operator.slot.golem
%% a comment %% and %%= a proof comment %% then [= f(1, x.y) + -2 ** 3 ... 4] and [= true].
%%<-- comment.line.percentage.golem
%%                  ^^^ comment.line.proof.golem
%%                                              ^^ keyword.control.expression.golem
%%                                                 ^ entity.name.function.golem
%%                                                   ^ constant.numeric.golem
%%                                                      ^ variable.other.golem
%%                                                           ^ keyword.operator.golem
%%                                                             ^ keyword.operator.golem
%%                                                                ^^ keyword.operator.golem
%%                                                                     ^^^ keyword.operator.golem
%%                                                                                   ^^^^ keyword.control.golem
漢字の本文 [em 強調] と [= "文字列"]。
%%     ^^ entity.name.function.golem
%%                 ^^^^^ string.quoted.double.golem

- an item
%%<- keyword.control.list.golem
%%   ^^^^ source.golem
+ an ordered item
%%<- keyword.control.list.golem
= a term
%%<- keyword.control.term.golem
  the body

| a | [em b] |
%%<- keyword.operator.table.golem
%%     ^^ entity.name.function.golem
|:--|--:|
%%<~--- keyword.operator.table.golem
| ##1## | x |
%%^^ keyword.operator.number.golem
%%  ^ constant.numeric.golem

```toml numbers=true
%%<--- keyword.control.fence.golem

%% SYNTAX TEST "source.golem" "the shared sample of the editor grammars (docs/adr/0170)"
@manifest paragraph-separator=blank-line
%%<- entity.name.tag.golem
%%<~-------- entity.name.tag.golem
%%        ^^^^^^^^^^^^^^^^^^^ variable.parameter.golem
%%                           ^ source.golem
%%                            ^^^^^^^^^^ string.unquoted.golem
@set edition = 2
%%<- entity.name.tag.golem
%%<~--- entity.name.tag.golem
%%             ^ constant.numeric.golem
# Title of edition [= edition] ##3##

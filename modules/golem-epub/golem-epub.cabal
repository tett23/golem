cabal-version:      3.0
name:               golem-epub
version:            0.1.0
synopsis:           EPUB packaging for Golem
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Golem.Epub
  build-depends:
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , filepath      >=1.4  && <1.6
    , golem-doc
    , golem-html
    , golem-syntax
    , text          >=2.0  && <2.2
    , time          >=1.12 && <1.15
    , zip-archive   >=0.4  && <0.5
  default-language: GHC2021

test-suite golem-epub-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    PackageSpec
  build-depends:
    , base
    , bytestring
    , containers
    , filepath
    , golem-doc
    , golem-epub
    , golem-html
    , golem-syntax
    , tasty          >=1.4 && <1.6
    , tasty-hunit    >=0.10 && <0.11
    , temporary
    , text
    , time
    , zip-archive
  default-language: GHC2021

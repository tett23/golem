cabal-version:      3.0
name:               golem-numerals
version:            0.1.0
synopsis:           Number notations of Golem: kanji, circled numbers and the number formats
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

-- depends on no golem package (docs/adr/0173)
library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Golem.Numerals
  build-depends:
    , base  >=4.20 && <4.21
    , text  >=2.0  && <2.2
  default-language: GHC2021

test-suite golem-numerals-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , base
    , golem-numerals
    , tasty          >=1.4 && <1.6
    , tasty-hunit    >=0.10 && <0.11
  default-language: GHC2021

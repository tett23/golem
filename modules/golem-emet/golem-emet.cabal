cabal-version:      3.0
name:               golem-emet
version:            0.1.0
synopsis:           Golem functions: the language Emet (docs/adr/0160)
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Golem.Emet
    Golem.Emet.Builtins
    Golem.Emet.Check
    Golem.Emet.Core
    Golem.Emet.Eval
    Golem.Emet.Exhaust
    Golem.Emet.Fmt
    Golem.Emet.Generated
    Golem.Emet.Gm
    Golem.Emet.Highlight
    Golem.Emet.IR
    Golem.Emet.Ide
    Golem.Emet.Lint
    Golem.Emet.Literal
    Golem.Emet.Outline
    Golem.Emet.Parse
    Golem.Emet.Path
    Golem.Emet.Prim
    Golem.Emet.Rename
    Golem.Emet.Solve
    Golem.Emet.Syntax
    Golem.Emet.Types
  build-depends:
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , containers    >=0.6  && <0.8
    , filepath      >=1.4  && <1.6
    , mtl           >=2.3  && <2.4
    , golem-doc
    , golem-eval
    , golem-syntax
    , peg-runtime   >=0.1  && <0.2
    , text          >=2.0  && <2.2
  default-language: GHC2021

test-suite golem-emet-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    ExportSpec FmtSpec IdeSpec LanguageSpec LintSpec RequirementSpec Support
  build-depends:
    , base
    , bytestring
    , containers
    , golem-eval
    , golem-emet
    , golem-syntax
    , golem-test-support
    , hedgehog       >=1.4 && <1.6
    , tasty          >=1.4 && <1.6
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , text
  default-language: GHC2021
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"

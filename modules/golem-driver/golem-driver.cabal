cabal-version:      3.0
name:               golem-driver
version:            0.1.0
synopsis:           The Golem build pipeline
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple
-- read by the tests that compare them with the modules that
-- scripts/gen-embedded.sh generates (docs/adr/0203): the version of Golem
-- (docs/adr/0004), a symbolic link to VERSION at the root of the
-- repository, and the explanations of the diagnostic codes (golem-cli ADR
-- 0005), a symbolic link to docs/diagnostics.md
extra-source-files:
  VERSION
  diagnostics.md

-- plugins (docs/adr/0199, root ADR 0434): golem new, Golem.Driver.New of
-- src-plugins/. The plugins themselves are those of golem-evaluate, which
-- has a flag plugins of its own; the wasm build turns both off
-- (cabal.project.wasm). golem-cli builds with it.
flag plugins
  description: golem new (golem-plugin)
  default:     True
  manual:      True

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns -Werror
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Golem.Driver
                    Golem.Driver.Html
                    Golem.Driver.PageMap
                    Golem.Driver.Svg
                    Golem.Driver.Version
                    Golem.Driver.Version.Embedded
  other-modules:    Golem.Driver.PageMap.Alignment
  build-depends:
    , aeson         >=2.2 && <2.3
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , containers    >=0.6  && <0.8
    , directory     >=1.3  && <1.4
    , filepath      >=1.4  && <1.6
    , golem-assemble
    , golem-bibliography
    , golem-doc
    , golem-epub
    , golem-evaluate
    , golem-html
    , golem-length
    , golem-pdf
    , golem-parser
    , golem-preflight
    , golem-project
    , golem-svg
    , golem-syntax
    , golem-text
    , golem-typeset
    , text          >=2.0  && <2.2
    , vector        >=0.13 && <0.14
  default-language: GHC2021
  if !arch(wasm32)
    c-sources:     cbits/output_lock.c
    build-depends: unix >=2.8 && <3
  -- golem new, only with the plugins (docs/adr/0199, root ADR 0434)
  if flag(plugins)
    hs-source-dirs:  src-plugins
    exposed-modules: Golem.Driver.New
    build-depends:   golem-plugin

-- What the four suites that golem-driver-test was split into share: the
-- options and the dependencies; each lists its own modules, and the
-- modules that help the tests (Support and the Specs that others import)
-- are built in each suite that uses them (root ADR 0416).
-- -threaded: tasty runs the tests at the same time on every processor;
-- none of them changes the state of the process, and those that do are
-- in golem-driver-global-test (docs/adr/0146). -N: one capability per
-- processor from the start (scripts/ci/rts-capabilities.sh)
-- wasm32 has no threaded runtime: -threaded does not link there, and
-- -N needs it (docs/adr/0293)
common driver-suite
  hs-source-dirs:   test
  if !arch(wasm32)
    ghc-options:    -threaded "-with-rtsopts=-N"
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , golem-assemble
    , golem-bibliography
    , golem-doc
    , golem-doc-gen
    , golem-driver
    , golem-emet
    , golem-epub
    , golem-eval
    , golem-layout
    , golem-layout-spec
    , golem-length
    , golem-parser
    , golem-pdf
    , golem-preflight
    , golem-project
    , golem-syntax
    , golem-test-support
    , golem-typeset
    , golem-unicode
    , JuicyPixels    ==3.3.9
    , hedgehog       >=1.4 && <1.6
    , process
    , zlib
    , tasty          >=1.4 && <1.6
    , tasty-golden   >=2.3 && <2.4
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , temporary      >=1.3 && <1.4
    , text
    , zip-archive
  default-language: GHC2021
  -- golem-plugin and golem new only with the plugins, as the library
  -- (docs/adr ADR 0300): without them (cabal.project.wasm, wasm32) the
  -- tests that use them are not built
  if flag(plugins)
    cpp-options:   -DGOLEM_PLUGINS
    build-depends: golem-plugin

-- The tests of the PDF: its structure, its tags, its fonts and the figures
-- that other tools wrote (root ADR 0416).
test-suite golem-driver-pdf-test
  import:           warnings
  import:           driver-suite
  type:             exitcode-stdio-1.0
  main-is:          PdfMain.hs
  other-modules:
    CodeFontSpec
    DecorationsSpec
    DoubleDashSpec
    ExpansionSpec
    FigureExternalSpec
    FontInstanceSpec
    LinkSpec
    OpenTypeFeaturesSpec
    PdfScreenSpec
    PdfSpec
    PlatesSpec
    PopplerSpec
    PunctuationWidthSpec
    ScriptsSpec
    ShapingMemoSpec
    SpecimenGeometrySpec
    Support
    TaggedPdfSpec
    TateChuYokoSpec
    VisualSubsetSpec
  -- golem-html's cmykToRgb and the HTML of the figures, which the PDF for
  -- the screen is compared with (root ADR 0445)
  build-depends: golem-html

-- The tests of the pages: paragraphs, headings, notes, figures and their
-- placement, and page breaks (root ADR 0416).
test-suite golem-driver-page-test
  import:           warnings
  import:           driver-suite
  type:             exitcode-stdio-1.0
  main-is:          PageMain.hs
  -- the modules of golem-evaluate that the tests import (root ADR 0434)
  build-depends:    golem-evaluate
  other-modules:
    AdjustOrderSpec
    AlignSpaceSpec
    BoxesSpec
    CaptionSidenoteIndentSpec
    CaptionSidenoteParagraphsSpec
    ChapterNotesSpec
    EndnotesSpec
    CompressedNoteMarksSpec
    FigureSpec
    FileSpacesSpec
    HeadingLevelsSpec
    KeepBookPartsSpec
    KeepOptionsSpec
    LineAdjustmentSpec
    LinkSpec
    NestedFiguresSpec
    NoteBodyStylesSpec
    NoteRefsSpec
    NotesSpec
    NumberTitleSeparatorSpec
    OverflowSpec
    PageElementsSpec
    PageLabelsSpec
    PageMapSpec
    PageNoteNumbersSpec
    PageStartsSpec
    ParagraphPitchSpec
    ParagraphRuleSpec
    ParagraphSpec
    ParagraphStyleControlsSpec
    ParagraphWrapPitchSpec
    ReuseSpec
    SeparatorSpec
    SinglePageSpec
    SoftHyphenSpec
    StylesSpec
    Support
    VerseLineNumbersSpec

-- The tests of the outputs: HTML, EPUB and plain text, the goldens of the
-- four targets, bibliographies, indexes and cross references (root ADR
-- 0416).
test-suite golem-driver-output-test
  import:           warnings
  import:           driver-suite
  type:             exitcode-stdio-1.0
  main-is:          OutputMain.hs
  -- the modules of golem-evaluate that the tests import (root ADR 0434)
  build-depends:    golem-evaluate
  other-modules:
    BookLanguageSpec
    BuildSpec
    ColophonSpec
    ComplexFixtureSpec
    EmetSamplesSpec
    ExtendedJapaneseOutputsSpec
    FontLicensesSpec
    ForceTableSpec
    GenericFontsSpec
    HtmlSyntaxBuildSpec
    InMemorySpec
    IndexColumnsSpec
    IndexRangeSpec
    InsideLinksSpec
    ManualEmetSpec
    OutputGoldenSpec
    ReferencesSpec
    Support
    TableCaptionsSpec
    TableFilesSpec
    TocStylesSpec

-- The tests of diagnostics, functions, plugins, projects and the commands
-- near the CLI (root ADR 0416).
test-suite golem-driver-cli-test
  import:           warnings
  import:           driver-suite
  type:             exitcode-stdio-1.0
  main-is:          CliMain.hs
  -- the modules of golem-evaluate that the tests import (root ADR 0434)
  build-depends:    golem-evaluate
  other-modules:
    CallsSpec
    CliSpec
    DiagnosticSitesSpec
    DiagnosticsSpec
    ExceptionsSpec
    FunctionLibrarySpec
    FunctionsSpec
    NumberUnitBuildSpec
    PathDrawingSpec
    SecuritySpec
    Support
    UnwritableNumbersSpec
    VarsSpec
  if flag(plugins)
    other-modules: NewPlanSpec

-- The tests of golem-driver that change the state of the process (the
-- environment variable XDG_CACHE_HOME, the locale encoding), in a suite
-- without -threaded, so that tasty runs them one after another
-- (docs/adr/0146).
test-suite golem-driver-global-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          GlobalMain.hs
  other-modules:
    InMemoryWritesSpec
    LocaleSpec
    Support
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , golem-assemble
    , golem-bibliography
    , golem-doc
    , golem-driver
    , golem-epub
    , golem-eval
    , golem-layout
    , golem-layout-spec
    , golem-length
    , golem-parser
    , golem-pdf
    , golem-preflight
    , golem-project
    , golem-syntax
    , golem-test-support
    , golem-typeset
    , golem-unicode
    , process
    , zlib
    , tasty          >=1.4 && <1.6
    , tasty-golden   >=2.3 && <2.4
    , tasty-hunit    >=0.10 && <0.11
    , temporary      >=1.3 && <1.4
    , text
    , zip-archive
  default-language: GHC2021
  -- golem-plugin and golem new only with the plugins, as the library
  -- (docs/adr ADR 0300): without them (cabal.project.wasm, wasm32) the
  -- tests that use them are not built
  if flag(plugins)
    cpp-options:   -DGOLEM_PLUGINS
    other-modules: PluginsSpec
    build-depends: golem-plugin, golem-evaluate

-- Parallel composition on several OS threads (ParallelSpec), in a suite of
-- its own.
test-suite golem-driver-parallel-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          ParallelMain.hs
  other-modules:
    ParallelSpec
    Support
  -- -N: one capability per processor from the start, so that the count
  -- never changes while the suite runs (scripts/ci/rts-capabilities.sh)
  -- wasm32 has no threaded runtime: -threaded does not link there, and
  -- -N needs it (docs/adr/0293)
  if !arch(wasm32)
    ghc-options:    -threaded "-with-rtsopts=-N"
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , golem-assemble
    , golem-bibliography
    , golem-doc
    , golem-driver
    , golem-layout
    , golem-layout-spec
    , golem-pdf
    , golem-project
    , golem-syntax
    , golem-test-support
    , golem-typeset
    , golem-unicode
    , hedgehog       >=1.4 && <1.6
    , process
    , zlib
    , tasty          >=1.4 && <1.6
    , tasty-golden   >=2.3 && <2.4
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , temporary      >=1.3 && <1.4
    , text
  default-language: GHC2021

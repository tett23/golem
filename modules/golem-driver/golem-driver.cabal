cabal-version:      3.0
name:               golem-driver
version:            0.1.0.0
synopsis:           The Golem build pipeline
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Golem.Driver
                    Golem.Driver.Fonts
                    Golem.Driver.Lint
                    Golem.Driver.Pdf
                    Golem.Driver.Plugins
  build-depends:
    , aeson         >=2.1  && <2.3
    , async         >=2.2  && <2.3
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , containers    >=0.6  && <0.8
    , directory     >=1.3  && <1.4
    , filepath      >=1.4  && <1.6
    , golem-doc
    , golem-epub
    , golem-eval
    , golem-font
    , golem-html
    , golem-layout
    , golem-layout-spec
    , golem-lint
    , golem-pdf
    , golem-plugin
    , golem-parser
    , golem-project
    , golem-syntax
    , golem-text
    , text          >=2.0  && <2.2
    , time          >=1.12 && <1.15
    , vector        >=0.13 && <0.14
  default-language: GHC2021

test-suite golem-driver-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , golem-driver
    , golem-pdf
    , golem-plugin
    , golem-syntax
    , process
    , zlib
    , tasty          >=1.4 && <1.6
    , tasty-golden   >=2.3 && <2.4
    , tasty-hunit    >=0.10 && <0.11
    , temporary      >=1.3 && <1.4
    , text
  default-language: GHC2021

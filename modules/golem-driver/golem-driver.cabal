cabal-version:      3.0
name:               golem-driver
version:            0.1.0
synopsis:           The Golem build pipeline
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple
-- read by the tests that compare them with the modules that
-- scripts/gen-embedded.sh generates (docs/adr/0203): the version of Golem
-- (docs/adr/0004), a symbolic link to VERSION at the root of the
-- repository, and the explanations of the diagnostic codes (golem-cli ADR
-- 0005), a symbolic link to docs/diagnostics.md
extra-source-files:
  VERSION
  diagnostics.md

-- plugins (docs/adr/0199): the plugins of golem-plugin (wasmtime) and golem
-- new. Without it, Golem.Driver.Plugins of src-no-plugins/ reports G06106
-- for a project that uses a plugin; the wasm build turns it off
-- (cabal.project.wasm). golem-cli and golem-lsp build with it.
flag plugins
  description: The plugins (golem-plugin, wasmtime) and golem new
  default:     True
  manual:      True

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns -Werror
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Golem.Driver
                    Golem.Driver.Explain
                    Golem.Driver.Explain.Catalog
                    Golem.Driver.Explain.Embedded
                    Golem.Driver.Functions
                    Golem.Driver.Html
                    Golem.Driver.Lint
                    Golem.Driver.Plugins
                    Golem.Driver.Svg
                    Golem.Driver.Version
                    Golem.Driver.Version.Embedded
  other-modules:    Golem.Driver.ProjectVars
  build-depends:
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , containers    >=0.6  && <0.8
    , directory     >=1.3  && <1.4
    , filepath      >=1.4  && <1.6
    , golem-assemble
    , golem-bibliography
    , golem-doc
    , golem-emet
    , golem-epub
    , golem-eval
    , golem-html
    , golem-length
    , golem-lint
    , golem-pdf
    , golem-parser
    , golem-preflight
    , golem-project
    , golem-svg
    , golem-syntax
    , golem-text
    , golem-typeset
    , text          >=2.0  && <2.2
    , time          >=1.12 && <1.15
  default-language: GHC2021
  -- the two Golem.Driver.Plugins export the same names and types (docs/adr/0199)
  if flag(plugins)
    hs-source-dirs:  src-plugins
    exposed-modules: Golem.Driver.New
    build-depends:   golem-plugin
  else
    hs-source-dirs:  src-no-plugins

test-suite golem-driver-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    AlignSpaceSpec
    BookLanguageSpec
    BuildSpec
    CallsSpec
    ChapterNotesSpec
    ColophonSpec
    CliSpec
    NewPlanSpec
    ComplexFixtureSpec
    DiagnosticSitesSpec
    ReuseSpec
    CodeFontSpec
    DiagnosticsSpec
    DoubleDashSpec
    EmetSamplesSpec
    ExpansionSpec
    FigureExternalSpec
    FigureSpec
    FileSpacesSpec
    ForceTableSpec
    FunctionLibrarySpec
    FunctionsSpec
    HeadingLevelsSpec
    InMemorySpec
    ManualEmetSpec
    InsideLinksSpec
    LinkSpec
    NotesSpec
    OutputGoldenSpec
    DecorationsSpec
    ExceptionsSpec
    OpenTypeFeaturesSpec
    ScriptsSpec
    OverflowSpec
    SoftHyphenSpec
    PageElementsSpec
    PageStartsSpec
    ParagraphRuleSpec
    ParagraphSpec
    PdfSpec
    PlatesSpec
    PopplerSpec
    ReferencesSpec
    SecuritySpec
    BoxesSpec
    KeepOptionsSpec
    LineAdjustmentSpec
    AdjustOrderSpec
    NumberUnitBuildSpec
    PageLabelsSpec
    IndexRangeSpec
    ShapingMemoSpec
    SpecimenGeometrySpec
    TateChuYokoSpec
    StylesSpec
    TableCaptionsSpec
    TableFilesSpec
    TaggedPdfSpec
    TocStylesSpec
    UnwritableNumbersSpec
    VarsSpec
    Support
  -- -threaded: tasty runs the tests at the same time on every processor;
  -- none of them changes the state of the process, and those that do are
  -- in golem-driver-global-test (docs/adr/0146). -N: one capability per
  -- processor from the start (scripts/ci/rts-capabilities.sh)
  -- wasm32 has no threaded runtime: -threaded does not link there, and
  -- -N needs it (docs/adr/0293)
  if !arch(wasm32)
    ghc-options:    -threaded "-with-rtsopts=-N"
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , golem-assemble
    , golem-bibliography
    , golem-doc
    , golem-doc-gen
    , golem-driver
    , golem-emet
    , golem-epub
    , golem-eval
    , golem-layout
    , golem-layout-spec
    , golem-length
    , golem-parser
    , golem-pdf
    , golem-plugin
    , golem-preflight
    , golem-project
    , golem-syntax
    , golem-test-support
    , golem-typeset
    , hedgehog       >=1.4 && <1.6
    , process
    , zlib
    , tasty          >=1.4 && <1.6
    , tasty-golden   >=2.3 && <2.4
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , temporary      >=1.3 && <1.4
    , text
    , zip-archive
  default-language: GHC2021

-- The tests of golem-driver that change the state of the process (the
-- environment variable XDG_CACHE_HOME, the locale encoding), in a suite
-- without -threaded, so that tasty runs them one after another
-- (docs/adr/0146).
test-suite golem-driver-global-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          GlobalMain.hs
  other-modules:
    InMemoryWritesSpec
    LocaleSpec
    PluginsSpec
    Support
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , golem-assemble
    , golem-bibliography
    , golem-doc
    , golem-driver
    , golem-epub
    , golem-eval
    , golem-layout
    , golem-layout-spec
    , golem-length
    , golem-parser
    , golem-pdf
    , golem-plugin
    , golem-preflight
    , golem-project
    , golem-syntax
    , golem-test-support
    , golem-typeset
    , process
    , zlib
    , tasty          >=1.4 && <1.6
    , tasty-golden   >=2.3 && <2.4
    , tasty-hunit    >=0.10 && <0.11
    , temporary      >=1.3 && <1.4
    , text
    , zip-archive
  default-language: GHC2021

-- Parallel composition on several OS threads (ParallelSpec), in a suite of
-- its own.
test-suite golem-driver-parallel-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          ParallelMain.hs
  other-modules:
    ParallelSpec
    Support
  -- -N: one capability per processor from the start, so that the count
  -- never changes while the suite runs (scripts/ci/rts-capabilities.sh)
  -- wasm32 has no threaded runtime: -threaded does not link there, and
  -- -N needs it (docs/adr/0293)
  if !arch(wasm32)
    ghc-options:    -threaded "-with-rtsopts=-N"
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , golem-assemble
    , golem-bibliography
    , golem-doc
    , golem-driver
    , golem-layout
    , golem-layout-spec
    , golem-pdf
    , golem-project
    , golem-syntax
    , golem-test-support
    , golem-typeset
    , hedgehog       >=1.4 && <1.6
    , process
    , zlib
    , tasty          >=1.4 && <1.6
    , tasty-golden   >=2.3 && <2.4
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , temporary      >=1.3 && <1.4
    , text
  default-language: GHC2021

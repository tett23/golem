-- the functions of the fixture of determinism (docs/adr/0150)

pub inline taxIncluded :: Nat -> Inlines;
taxIncluded n = Inline.text (String.fromNat (div (n * 11) 10));

pub inline emphTwice :: Inlines -> Inlines;
emphTwice s = Inline.charStyle "strong" s ++ Inline.charStyle "strong" s;

pub block wordTable :: String -> Blocks => file;
wordTable name = Block.table [Inline.text "語", Inline.text "読み"] (List.map row (rows (File.read name)));

row :: List String -> List Inlines;
row cells = List.map Inline.text cells;

rows :: String -> List (List String);
rows s = List.map (String.split "\t") (String.lines s);

-- a tail recursion
pub inline countUp :: Int -> Inlines;
countUp n = Inline.text (String.fromInt (loop n 0));

loop :: Int -> Int -> Int;
loop 0 acc = acc;
loop n acc = loop (n - 1) (acc + 1);

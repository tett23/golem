cabal-version:      3.0
name:               golem-doc
version:            0.1.0
synopsis:           The semantic IR of Golem and the plugin ABI
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple
extra-source-files: schema/golem-doc.cddl

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns -Werror
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Golem.Doc.Cbor
    Golem.Doc.Citation
    Golem.Doc.FigureWidth
    Golem.Doc.IR
    Golem.Doc.Url
    Golem.Doc.Validate
  build-depends:
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , cborg         >=0.2  && <0.3
    , golem-length
    , golem-parser
    , golem-syntax
    , text          >=2.0  && <2.2
  default-language: GHC2021

test-suite golem-doc-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    CborExprSpec CiteSpec IndexSpec LangSpec LinkSpec NoteSpec ResolvedSpec TableSpec
  build-depends:
    , base
    , bytestring
    , cborg
    , containers
    , directory
    , filepath
    , golem-doc
    , golem-parser
    , golem-syntax
    , golem-test-support
    , tasty          >=1.4 && <1.6
    , tasty-hunit    >=0.10 && <0.11
    , process
    , scientific
    , temporary
    , text
  default-language: GHC2021

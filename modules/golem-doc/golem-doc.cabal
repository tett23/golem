cabal-version:      3.0
name:               golem-doc
version:            0.1.0
synopsis:           The semantic IR of Golem
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple
extra-source-files: schema/golem-doc.cddl

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Golem.Doc.Assemble
    Golem.Doc.Bibliography
    Golem.Doc.Cbor
    Golem.Doc.Collation
    Golem.Doc.IR
    Golem.Doc.ListMarkers
    Golem.Doc.Numbering
    Golem.Doc.Numerals
    Golem.Doc.Validate
  build-depends:
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , cborg         >=0.2  && <0.3
    , containers    >=0.6  && <0.8
    , golem-parser
    , golem-syntax
    , mtl           >=2.3  && <2.4
    , text          >=2.0  && <2.2
  default-language: GHC2021

test-suite golem-doc-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    Gen AssembleSpec BibliographySpec CborExprSpec ExternalTool ListMarkersSpec NumberingSpec
  build-depends:
    , base
    , bytestring
    , cborg
    , containers
    , directory
    , filepath
    , golem-doc
    , golem-parser
    , golem-syntax
    , hedgehog       >=1.4 && <1.6
    , tasty          >=1.4 && <1.6
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , process
    , temporary
    , text
  default-language: GHC2021

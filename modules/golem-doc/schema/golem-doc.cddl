; The semantic IR of Golem (golem-doc ADR 0001). This file is canonical:
; the Haskell types in Golem.Doc.IR mirror it. Sum types are arrays whose
; first element is a fixed tag; tags are never reused.

document = [abi-version: 8, file: uint64, blocks: [* block]]

span = [file: uint64, start: uint64, end: uint64]

; the integers of the IR are 64-bit signed integers; bignums are never
; written (golem-doc ADR 0006)
int64 = -9223372036854775808..9223372036854775807
uint64 = 0..9223372036854775807

block = [span, label: tstr / null, body: block-body]

block-body =
    [1, level: 1..3, heading-attrs, inlines]        ; heading
  / [2, [* list-item]]                             ; bullet list
  / [3, [* list-item]]                             ; ordered list
  / [4, [* def-group]]                             ; definition list
  / [5, [* alignment], [* inlines], [* [* inlines]]] ; table
  / [6, code]                                      ; code block (golem-driver ADR 0023)
  / [7, figure]                                    ; figure
  / [8, channel]                                   ; channel output
  / [10, para-style: tstr / null, inlines]         ; paragraph; null is body
  / [11, break-kind]                               ; forced break (docs/adr ADR 0017)
  / [12, page-control]                             ; manual page break control (docs/adr ADR 0030)
  / [13, lines: 1..9223372036854775807]            ; blank lines before what follows (docs/adr ADR 0046)
; 0 (paragraph without a style) and 9 (verse) are retired (docs/adr ADR 0005)

heading-attrs = [toc-title: inlines / null, number: uint64 / null, nonumber: bool, notoc: bool]
list-item = [number: uint64 / null, [* block]]
def-group = [terms: [+ inlines], defs: [+ [* block]]]
break-kind = 0..3                                  ; page, recto, verso, column
page-control = [0]                                 ; no page break
             / [1, 1..9223372036854775807]         ; need lines
             / [2, -9223372036854775808..-1 / 1..9223372036854775807] ; adjust the lines of the column
alignment = 0..3                                   ; default, left, center, right
figure = [src: tstr, web: tstr / null, alt: tstr, wrap: (0 / 1) / null, width: tstr / null, caption: [* block], page: uint64 / null, rotate: bool] ; page: golem-pdf ADR 0008; rotate: golem-driver ADR 0034
code = [lang: tstr / null, numbers: bool / null, file: tstr / null, caption: inlines / null, diff: bool, lines: [* code-line]]
code-line = [text: tstr, number: uint64 / null, diff-mark: (0..2) / null, highlight: bool, callouts: [* 1..50]] ; added, removed, context
channel = [0, depth: uint64] / [1] / [2]           ; toc, index, bibliography
        / [3, name: tstr, style: tstr / null]      ; a channel of a plugin (golem-doc ADR 0007)

inlines = [* inline]
inlines-no-ruby = [* inline-no-ruby]

inline = ruby / inline-no-ruby
ruby = [4, span, [+ ruby-segment]]
ruby-segment = [base: inlines-no-ruby, reading: tstr / null]

inline-no-ruby =
    [0, span, tstr]                                ; text
  / [5, span, shape: tstr / null, inlines]         ; kenten
  / [6, span, swatch: tstr, inlines]               ; color
  / [7, span, style: tstr, inlines]                ; character style
  / [8, span, tstr]                                ; tate-chu-yoko
  / [9, span, int64, number-style / null]          ; number
  / [10, span, ref-kind, label: tstr]              ; reference
  / [11, span, expr]                               ; deferred expression (S1)
  / [12, span, uint64, inlines]                    ; note
  / [13, span, uint64, inlines]                    ; sidenote
  / [14, span, terms: [1*2 tstr], readings: [1*2 tstr]] ; index mark
  / [15, span, key: tstr]                          ; citation
  / [16, span, tstr]                               ; proofreading comment
  / [17, span]                                     ; line break
  / [18, span, zw: [uint64, 1..9223372036854775807] / null, sp: uint64 / null] ; aki: zw or sp, exactly one (docs/adr ADR 0019)
  / [19, span, channel: tstr, key: tstr / null, reading: tstr / null, inlines] ; channel item (golem-doc ADR 0007)
; 1 (strong), 2 (bold) and 3 (italic) are retired: they are character styles (docs/adr ADR 0005)

number-style = 0..2                                ; kanji, kanji-digits, tcy
ref-kind = 0..2                                    ; number, title, page

; a rational in lowest terms, the denominator 1 or more (RFC 8949, the
; registered tag 30); a rational of an integral value has the denominator 1
; (docs/adr ADR 0101)
rational = #6.30([numerator: int64, denominator: 1..9223372036854775807])

; the number literals by their types: an integer, a natural number (12) and
; a rational (13) (docs/adr ADR 0101). The host writes no [1, span, float]:
; a plugin that writes one gets its exact rational, and NaN and the
; infinities are G06100. 14 is the closed range a...b (docs/adr ADR 0113)
expr =
    [0, span, int64]
  / [1, span, float]
  / [2, span, tstr]
  / [3, span, bool]
  / [4, span]
  / [5, span, [* expr]]
  / [6, span, [* [tstr, expr]]]
  / [7, span, [+ tstr]]
  / [8, span, tstr, [* expr]]
  / [9, span, expr]
  / [10, span, 0..11, expr, expr]
  / [11, span]
  / [12, span, uint64]
  / [13, span, rational]
  / [14, span, expr, expr]

; plugin requests and responses (golem-plugin ADR 0001)
command-request = [0, name: tstr, args: [* argument], slots: [* inlines], span]
filter-request = [1, name: tstr, document]
argument = [0, value] / [1, key: tstr, value]
value = int64 / rational / tstr / bool / null / range / [* value]
; the closed range: first and last included, first not after last (docs/adr ADR 0113)
range = {"first": int64, "last": int64}
response = [output: inlines / document, diagnostics: [* plugin-diagnostic]]
plugin-diagnostic = [code: tstr, severity: 0 / 1, span, message: tstr]
; golem_describe: the names of the commands and filters a plugin provides,
; and the channels it declares (golem-doc ADR 0007)
description = [commands: [* tstr], filters: [* tstr], channels: [* channel-decl]]
channel-decl = [name: tstr, order: 0 / 1, locators: bool] ; order: document, reading

cabal-version:      3.0
name:               golem-bibliography
version:            0.1.0
synopsis:           Bibliographies of Golem: CSL-JSON and the format of an entry
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns -Werror
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Golem.Bibliography
    Golem.Bibliography.Csl
  build-depends:
    , aeson         >=2.1  && <2.3
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , golem-syntax
    , scientific    >=0.3  && <0.4
    , text          >=2.0  && <2.2
    , vector        >=0.13 && <0.14
  default-language: GHC2021

test-suite golem-bibliography-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    BibliographySpec CslSpec
  build-depends:
    , base
    , bytestring
    , golem-bibliography
    , scientific
    , tasty          >=1.4 && <1.6
    , tasty-hunit    >=0.10 && <0.11
    , text
  default-language: GHC2021

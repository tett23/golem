cabal-version:      3.0
name:               golem-cli
version:            0.1.0
synopsis:           The golem command
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

executable golem
  hs-source-dirs:   app
  main-is:          Main.hs
  -- -N: every processor, so that paragraphs are composed on several OS
  -- threads at once (golem-driver ADR 0002)
  ghc-options: -threaded "-with-rtsopts=-N" -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings
  build-depends:
    , base                  >=4.20 && <4.21
    , bytestring            >=0.11 && <0.13
    , containers            >=0.6  && <0.8
    , directory             >=1.3  && <1.4
    , filepath              >=1.4  && <1.6
    , golem-doc
    , golem-driver
    , golem-eval
    , golem-fmt
    , golem-lsp
    , golem-project
    , golem-parser
    , golem-plugin
    , golem-syntax
    , optparse-applicative  >=0.18 && <0.20
    , text                  >=2.0  && <2.2
    , uuid                  >=1.3  && <1.4
  default-language: GHC2021

test-suite golem-cli-test
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    CommandsSpec
                    LocaleSpec
                    RtsSpec
  -- -N: one capability per processor from the start, so that the count
  -- never changes while the suite runs (scripts/ci/rts-capabilities.sh)
  ghc-options: -threaded "-with-rtsopts=-N" -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings
  build-tool-depends: golem-cli:golem
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , golem-driver
    , golem-syntax
    , process
    , tasty          >=1.4 && <1.6
    , tasty-golden   >=2.3 && <2.4
    , tasty-hunit    >=0.10 && <0.11
    , temporary      >=1.3 && <1.4
    , text
  default-language: GHC2021

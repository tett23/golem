cabal-version:      3.0
name:               golem-pdf
version:            0.1.0
synopsis:           deterministic PDF writer for Golem
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Golem.Pdf
                    Golem.Pdf.Image
                    Golem.Pdf.Marks
                    Golem.Pdf.Number
                    Golem.Pdf.Object
                    Golem.Pdf.Sha256
                    Golem.Pdf.Srgb
                    Golem.Pdf.Writer
                    Golem.Pdf.X4
  build-depends:
    , array             >=0.5  && <0.6
    , base              >=4.20 && <4.21
    , bytestring        >=0.11 && <0.13
    , containers        >=0.6  && <0.8
    , golem-layout-spec
    , golem-syntax
    , text              >=2.0  && <2.2
    , uuid              >=1.3  && <1.4
    , zlib              >=0.7  && <0.8
  default-language: GHC2021

test-suite golem-pdf-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    ImageSpec
  -- GHC.Stats measures what reading a hostile image allocates (docs/adr ADR 0035)
  ghc-options:      -rtsopts -with-rtsopts=-T
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , golem-layout-spec
    , golem-pdf
    , golem-test-support
    , hedgehog       >=1.4 && <1.6
    , process
    , tasty          >=1.4 && <1.6
    , tasty-golden   >=2.3 && <2.4
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , temporary
    , text
    , zlib
  default-language: GHC2021

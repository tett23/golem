cabal-version:      3.0
name:               golem-test-support
version:            0.1.0
synopsis:           Helpers shared by the test suites of Golem
description:
  Helpers that the test suites of the Golem packages share
  (docs/adr/0028). Only test suites depend on it: the golem executable
  does not, and it is not part of the release archives
  (scripts/ci/test-only-deps.sh checks this). It depends on no package
  of this repository, neither directly nor through another package
  (docs/adr/0087; test-only-deps.sh checks this too).
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Testing
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns -Werror
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Golem.TestSupport.Bytes
    Golem.TestSupport.CffRos
    Golem.TestSupport.CssCascade
    Golem.TestSupport.Enum
    Golem.TestSupport.Env
    Golem.TestSupport.ExternalTool
    Golem.TestSupport.ExternalTool.Internal
    Golem.TestSupport.Gen
    Golem.TestSupport.Heading
    Golem.TestSupport.Manifest
    Golem.TestSupport.PackageDirectory
    Golem.TestSupport.Parallel
    Golem.TestSupport.Skipped
    Golem.TestSupport.TimeLimit
    Golem.TestSupport.Watchdog
  -- the thread of the watchdog, outside the Haskell runtime (docs/adr ADR 0117)
  include-dirs:     cbits
  c-sources:        cbits/golem_watchdog.c
  build-depends:
    , base        >=4.20 && <4.21
    , bytestring  >=0.11 && <0.13
    , directory   >=1.3  && <1.4
    , hedgehog    >=1.4  && <1.6
    , tasty       >=1.4  && <1.6
    , text        >=2.0  && <2.2
  default-language: GHC2021

test-suite golem-test-support-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    CssCascadeSpec
    EnumParCases
    EnumSpec
  build-depends:
    , base
    , bytestring
    , directory
    , golem-test-support
    , hedgehog
    , process             >=1.6 && <1.7
    , tasty
    , tasty-hunit         >=0.10 && <0.11
    , text
  default-language: GHC2021

-- checkAllPar on one and on four processors (docs/adr/0208): -threaded,
-- and -rtsopts so that the suite runs itself with +RTS -N1 and -N4. It
-- starts on every processor, as scripts/ci/rts-capabilities.sh requires;
-- the runs with -N1 and -N4 do not start tasty, which would raise the
-- number of capabilities.
test-suite golem-test-support-par-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          ParMain.hs
  other-modules:    EnumParCases
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -qg -A64m"
  build-depends:
    , base
    , golem-test-support
    , process             >=1.6 && <1.7
    , tasty
    , tasty-hunit         >=0.10 && <0.11
  default-language: GHC2021

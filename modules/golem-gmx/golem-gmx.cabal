cabal-version:      3.0
name:               golem-gmx
version:            0.1.0
synopsis:           Golem functions: the .gmx language (docs/adr/0148)
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Golem.Gmx
    Golem.Gmx.Builtins
    Golem.Gmx.Check
    Golem.Gmx.Core
    Golem.Gmx.Eval
    Golem.Gmx.Exhaust
    Golem.Gmx.Fmt
    Golem.Gmx.Generated
    Golem.Gmx.Literal
    Golem.Gmx.Parse
    Golem.Gmx.Prim
    Golem.Gmx.Syntax
    Golem.Gmx.Types
  build-depends:
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , containers    >=0.6  && <0.8
    , filepath      >=1.4  && <1.6
    , mtl           >=2.3  && <2.4
    , golem-doc
    , golem-eval
    , golem-syntax
    , peg-runtime   >=0.1  && <0.2
    , text          >=2.0  && <2.2
  default-language: GHC2021

test-suite golem-gmx-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    FmtSpec LanguageSpec RequirementSpec Support
  build-depends:
    , base
    , containers
    , golem-eval
    , golem-gmx
    , golem-syntax
    , hedgehog       >=1.4 && <1.6
    , tasty          >=1.4 && <1.6
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , text
  default-language: GHC2021
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"

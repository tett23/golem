# The grammar of .gmx, the language of functions (docs/adr/0148).
#
# No offside rule: a top-level declaration ends with ;, and the blocks of
# case and where are written in { } with ; between their items. Line
# breaks and indentation are white space.
#
# The typed entry builds the AST (Golem.Gmx.Syntax); the lossless syntax
# tree feeds golem fmt, which needs the comments. Every token returns its
# own range, and the white space after it is read by the caller, so that
# the range of a node ends at its last token.

%module Golem.Gmx.Generated
%syntax
%language OverloadedStrings

%token Ws
%trivia Ws
%token Nl
%trivia Nl
%token Comment
%trivia Comment
%token StrTok
%token OpenBlock
%token CloseBlock
%token GuardBar
%token Semi
%token FatArrow
%token ReqTok

%inline Sp

# The labels are thrown only where a closing bracket or a quote is
# expected and the input ends, or (for ( and [) a ; or } comes; and at a
# word that is reserved but not usable (if, let, ...), which no rule
# reads. No alternative can go on at the same place after them.
%safe unclosed_paren
%safe unclosed_bracket
%safe unclosed_brace
%safe unclosed_string
%safe reserved

%{
import Data.Text (Text)
import Data.Text qualified as T
import Golem.Eval.Value (Value)
import Golem.Gmx.Literal (negateValue, numberValue, stringValue)
import Golem.Gmx.Syntax
import Peg.Runtime (Pos (..), Span (..))

loc :: Span -> Loc
loc (Span s e) = Loc (posOffset s) (posOffset e)

reservedWords :: [Text]
reservedWords =
  [ "pub", "inline", "block", "data", "type", "import", "as", "where", "case", "of", "lazy", "otherwise",
    "if", "then", "else", "for", "while", "let", "in"
  ]

-- | The left-associative application of a function to its arguments.
apps :: Expr -> [Expr] -> Expr
apps = foldl EApp

-- | Left-associative binary operators.
leftAssoc :: Expr -> [(BinOp, Expr)] -> Expr
leftAssoc = foldl (\l (o, r) -> EBin (exprLoc l <-> exprLoc r) o l r)

bin :: Expr -> BinOp -> Expr -> Expr
bin l o r = EBin (exprLoc l <-> exprLoc r) o l r

-- | A type constructor applied to arguments.
tapp :: Loc -> QName -> [TypeE] -> TypeE
tapp l c args = TCon (foldl (\a t -> a <-> typeLoc t) l args) c args

-- | The range of a list of items after a first range.
endOf :: Loc -> [Loc] -> Loc
endOf l ls = foldl (<->) l ls
}%

Module :: Module
Module <- Sp ds:Decl* !. { Module ds }

Decl :: Decl
Decl <- Import
      / Data
      / TypeAlias
      / s:Signature e:SemiS { DSig s { sigLoc = sigLoc s <-> e } }
      / q:Equation e:SemiS { DEq q { eqLoc = eqLoc q <-> e } }
      / BadReservedDecl

Import :: Decl
Import <- s:KS<'import'> p:StrLitLoc KS<'as'> a:ConNameLoc e:SemiS { DImport (s <-> e) (fst p) (snd p) (fst a) }

Data :: Decl
Data <- p:PubOpt s:KS<'data'> n:ConNameLoc vs:VarName* EqS c:ConDecl cs:(AltBarU ConDecl)* e:SemiS { DData (maybe s id p <-> e) (maybe False (const True) p) (fst n) vs (c : cs) }

PubOpt :: Maybe Loc
PubOpt <- l:KS<'pub'> { Just l } / '' { Nothing }

TypeAlias :: Decl
TypeAlias <- s:KS<'type'> n:ConNameLoc vs:VarName* EqS t:Type e:SemiS { DType (s <-> e) (fst n) vs t }

ConDecl :: ConDecl
ConDecl <- n:ConNameLoc OpenRecS f:FieldDecl fs:(CommaU FieldDecl)* e:CloseRecS { ConRec (snd n <-> e) (fst n) (f : fs) }
         / n:ConNameLoc ts:AType* { ConPos (endOf (snd n) (map typeLoc ts)) (fst n) ts }

FieldDecl :: (Name, TypeE)
FieldDecl <- n:VarName DColonS t:Type { (n, t) }

Signature :: Signature
Signature <- p:KS<'pub'> k:CommandKind n:VarNameLoc DColonS t:Type rs:Requirements { Signature (endOf (p <-> typeLoc t) (map snd rs)) True (fst n) (snd n) t rs (Just k) }
           / p:PubOpt n:VarNameLoc DColonS t:Type rs:Requirements { Signature (endOf (maybe (snd n) id p <-> typeLoc t) (map snd rs)) (maybe False (const True) p) (fst n) (snd n) t rs Nothing }

# pub inline and pub block: a command of .gm (docs/adr/0150); one of the two.
CommandKind :: CmdKind
CommandKind <- KS<'inline'> { CmdInline }
             / KS<'block'> { CmdBlock }

# What the function requires of the processor (docs/adr/0149): => file.
Requirements :: [(Name, Loc)]
Requirements <- FatArrowS r:ReqName rs:(CommaU ReqName)* { r : rs }
              / '' { [] }

ReqName :: (Name, Loc)
ReqName <- r:ReqTok Sp { r }

ReqTok :: (Name, Loc)
ReqTok <- w:$([a-z] [a-z0-9\-]*) { (w, loc _span) }

LocalSignature :: Signature
LocalSignature <- n:VarNameLoc DColonS t:Type { Signature (snd n <-> typeLoc t) False (fst n) (snd n) t [] Nothing }

# One equation; the ; after it is read by the caller.
Equation :: Equation
Equation <- n:VarNameLoc ps:APat* r:Rhs ws:Where* { Equation (endOf (snd n) (rhsLoc r : map whereLoc ws)) (fst n) (snd n) ps r ws }

Rhs :: Rhs
Rhs <- EqS e:Expr { Plain e }
     / gs:GuardEq+ { Guarded gs }

GuardEq :: (Guard, [Where])
GuardEq <- s:GuardBarS c:GuardCond EqS e:Expr ws:Where* { (Guard (s <-> exprLoc e) c e, ws) }

GuardCond :: GuardCond
GuardCond <- l:KS<'otherwise'> { GOtherwise l }
           / e:Expr { GExpr e }

Where :: Where
Where <- s:KS<'where'> OpenBlockS bs:Items<Binding> e:CloseBlockS { Where (s <-> e) bs }

Binding :: Binding
Binding <- s:KS<'lazy'> n:VarNameLoc EqS e:Expr ws:Where* { BLazy (endOf s (exprLoc e : map whereLoc ws)) (fst n) (snd n) e ws }
         / s:LocalSignature { BSig s }
         / q:Equation { BEq q }

# Items of a block in { }, separated by ;, the last ; optional.
Items<p :: a> :: [a]
Items<p> <- x:p xs:(SemiU p)* SemiU? { x : xs }
          / '' { [] }

# --- types

Type :: TypeE
Type <- a:BType ArrowS b:Type { TFun a b }
      / BType

BType :: TypeE
BType <- c:TyConLoc as:AType+ { tapp (snd c) (fst c) as }
       / AType

AType :: TypeE
AType <- c:TyConLoc { TCon (snd c) (fst c) [] }
       / v:VarNameLoc { TVar (snd v) (fst v) }
       / OpenParenS t:Type CloseParenS { t }

TyConLoc :: (QName, Loc)
TyConLoc <- QualConLoc
          / c:ConNameLoc { (QName Nothing (fst c), snd c) }

# --- patterns

Pat :: Pat
Pat <- c:ConRefLoc as:APat+ { PCon (endOf (snd c) (map patLoc as)) (fst c) as }
     / APat

APat :: Pat
APat <- l:WildS { PWild l }
      / n:VarNameLoc { PVar (snd n) (fst n) }
      / n:NumLitLoc { PNum (snd n) (fst n) }
      / m:MinusS n:NumLitLoc { PNum (m <-> snd n) (negateValue (fst n)) }
      / s:StrLitLoc { PStr (snd s) (fst s) }
      / s:OpenBracketS ps:CommaList<Pat> e:CloseBracketS { PList (s <-> e) ps }
      / c:ConRefLoc OpenRecS fs:CommaList<FieldPat> e:CloseRecS { PRec (snd c <-> e) (fst c) fs }
      / c:ConRefLoc { PCon (snd c) (fst c) [] }
      / OpenParenS p:Pat CloseParenS { p }

FieldPat :: (Name, Pat)
FieldPat <- n:VarName EqS p:Pat { (n, p) }

# Zero or more items separated by commas.
CommaList<p :: a> :: [a]
CommaList<p> <- x:p xs:(CommaU p)* { x : xs }
              / '' { [] }

# --- expressions

Expr :: Expr
Expr <- Case
      / Ternary

Case :: Expr
Case <- s:KS<'case'> e:Expr KS<'of'> OpenBlockS as:Items<Alt> c:CloseBlockS { ECase (s <-> c) e as }

Alt :: Alt
Alt <- p:Pat r:AltRhs ws:Where* { Alt (endOf (patLoc p) (rhsLoc r : map whereLoc ws)) p r ws }

AltRhs :: Rhs
AltRhs <- ArrowS e:Expr { Plain e }
        / gs:GuardAlt+ { Guarded gs }

GuardAlt :: (Guard, [Where])
GuardAlt <- s:GuardBarS c:GuardCond ArrowS e:Expr ws:Where* { (Guard (s <-> exprLoc e) c e, ws) }

Ternary :: Expr
Ternary <- c:Or QuestionS a:Expr ColonS b:Expr { ETernary (exprLoc c <-> exprLoc b) c a b }
         / Or

Or :: Expr
Or <- l:And OrOpS r:Or { bin l OpOr r }
    / And

And :: Expr
And <- l:Cmp AndOpS r:And { bin l OpAnd r }
     / Cmp

Cmp :: Expr
Cmp <- l:Append o:CmpOp r:Append { bin l o r }
     / Append

Append :: Expr
Append <- l:AddE AppendOpS r:Append { bin l OpAppend r }
        / AddE

AddE :: Expr
AddE <- l:MulE rs:AddTail* { leftAssoc l rs }

AddTail :: (BinOp, Expr)
AddTail <- o:AddOp e:MulE { (o, e) }

AddOp :: BinOp
AddOp <- '+' !'+' Sp { OpAdd }
       / '-' !'>' Sp { OpSub }

MulE :: Expr
MulE <- l:Unary rs:MulTail* { leftAssoc l rs }

MulTail :: (BinOp, Expr)
MulTail <- o:MulOp e:Unary { (o, e) }

MulOp :: BinOp
MulOp <- '*' !'*' Sp { OpMul }
       / '/' !'=' Sp { OpDiv }
       / '%' Sp { OpMod }

Unary :: Expr
Unary <- m:MinusS e:Unary { ENeg (m <-> exprLoc e) e }
       / PowE

PowE :: Expr
PowE <- b:App PowOpS e:Unary { bin b OpPow e }
      / App

CmpOp :: BinOp
CmpOp <- '==' Sp { OpEq }
       / '/=' Sp { OpNe }
       / '<=' Sp { OpLe }
       / '>=' Sp { OpGe }
       / '<' Sp { OpLt }
       / '>' Sp { OpGt }

App :: Expr
App <- f:Atom as:Atom* { apps f as }

Atom :: Expr
Atom <- s:OpenParenS e:Expr c:CloseParenS { EParen (s <-> c) e }
      / s:OpenBracketS es:CommaList<Expr> c:CloseBracketS { EList (s <-> c) es }
      / n:NumLitLoc { ENum (snd n) (fst n) }
      / s:StrLitLoc { EStr (snd s) (fst s) }
      / v:QualVarLoc { EVar (snd v) (fst v) }
      / v:VarNameLoc { EVar (snd v) (QName Nothing (fst v)) }
      / c:ConRefLoc OpenRecS fs:CommaList<FieldExpr> e:CloseRecS { ERecord (snd c <-> e) (fst c) fs }
      / c:ConRefLoc { ECon (snd c) (fst c) }
      / BadReservedExpr

FieldExpr :: (Name, Loc, Expr)
FieldExpr <- n:VarNameLoc EqS e:Expr { (fst n, snd n, e) }

# A word that is reserved and cannot be used (G10102). The label is thrown
# before the word, so that the error points at it.
BadReservedDecl :: Decl
BadReservedDecl <- &BadWord Never ^reserved { error "BadReservedDecl" }

BadReservedExpr :: Expr
BadReservedExpr <- &BadWord Never ^reserved { error "BadReservedExpr" }

BadWord :: ()
BadWord <- w:$([a-z] IdChar*) &{ w `elem` ["if", "then", "else", "for", "while", "let", "in"] } { () }

# Never succeeds.
Never :: ()
Never <- !. . { () }

# --- names

IdChar :: ()
IdChar <- [A-Za-z0-9_] { () }

VarName :: Name
VarName <- n:VarNameLoc { fst n }

VarNameLoc :: (Name, Loc)
VarNameLoc <- n:VarTok Sp { n }

VarTok :: (Name, Loc)
VarTok <- w:$([a-z_] IdChar*) &{ w /= "_" && w `notElem` reservedWords } { (w, loc _span) }

ConNameLoc :: (Name, Loc)
ConNameLoc <- c:ConTok Sp { c }

ConTok :: (Name, Loc)
ConTok <- w:$([A-Z] IdChar*) { (w, loc _span) }

# A constructor, maybe of an import: Just, T.Circle.
ConRefLoc :: (QName, Loc)
ConRefLoc <- QualConLoc
           / c:ConNameLoc { (QName Nothing (fst c), snd c) }

QualConLoc :: (QName, Loc)
QualConLoc <- q:QualCon Sp { q }

QualCon :: (QName, Loc)
QualCon <- m:$([A-Z] IdChar*) '.' c:$([A-Z] IdChar*) { (QName (Just m) c, loc _span) }

QualVarLoc :: (QName, Loc)
QualVarLoc <- q:QualVar Sp { q }

QualVar :: (QName, Loc)
QualVar <- m:$([A-Z] IdChar*) '.' v:$([a-z_] IdChar*) &{ v /= "_" && v `notElem` reservedWords } { (QName (Just m) v, loc _span) }

# --- literals

NumLitLoc :: (Value, Loc)
NumLitLoc <- n:NumTok Sp { n }

NumTok :: (Value, Loc)
NumTok <- t:$([0-9]+ ('.' [0-9]+)? ('e' [+\-]? [0-9]+)?) !IdChar { (numberValue t, loc _span) }

StrLitLoc :: (Text, Loc)
StrLitLoc <- s:StrTok Sp { s }

StrTok :: (Text, Loc)
StrTok <- '"' cs:$StrChar* StrClose { (stringValue cs, loc _span) }

StrChar :: ()
StrChar <- '\\' ["\\nt] { () }
         / '\\u{' [0-9A-Fa-f]+ '}' { () }
         / !["\\\n] . { () }

StrClose :: ()
StrClose <- '"' { () }
          / &('\n' / !.) Never ^unclosed_string { () }

# --- symbols, each followed by white space

KS<w> :: Loc
KS<w> <- l:K<w> Sp { l }

K<w> :: Loc
K<w> <- w !IdChar { loc _span }

S<s> :: Loc
S<s> <- s { loc _span }

SemiS :: Loc
SemiS <- l:Semi Sp { l }

Semi :: Loc
Semi <- ';' { loc _span }

OpenBlockS :: Loc
OpenBlockS <- l:OpenBlock Sp { l }

OpenBlock :: Loc
OpenBlock <- '{' { loc _span }

CloseBlockS :: Loc
CloseBlockS <- l:CloseBlock Sp { l }

CloseBlock :: Loc
CloseBlock <- '}' { loc _span }
            / !. Never ^unclosed_brace { Loc 0 0 }

OpenRecS :: Loc
OpenRecS <- l:S<'{'> Sp { l }

CloseRecS :: Loc
CloseRecS <- l:S<'}'> Sp { l }
           / !. Never ^unclosed_brace { Loc 0 0 }

GuardBarS :: Loc
GuardBarS <- l:GuardBar Sp { l }

GuardBar :: Loc
GuardBar <- '|' !'|' { loc _span }

AltBarS :: Loc
AltBarS <- l:S<'|'> !'|' Sp { l }

OpenParenS :: Loc
OpenParenS <- l:S<'('> Sp { l }

CloseParenS :: Loc
CloseParenS <- l:S<')'> Sp { l }
             / &(';' / '}' / !.) Never ^unclosed_paren { Loc 0 0 }

OpenBracketS :: Loc
OpenBracketS <- l:S<'['> Sp { l }

CloseBracketS :: Loc
CloseBracketS <- l:S<']'> Sp { l }
               / &(';' / '}' / !.) Never ^unclosed_bracket { Loc 0 0 }

CommaU :: ()
CommaU <- CommaS { () }

SemiU :: ()
SemiU <- SemiS { () }

AltBarU :: ()
AltBarU <- AltBarS { () }

CommaS :: Loc
CommaS <- l:S<','> Sp { l }

FatArrowS :: Loc
FatArrowS <- l:FatArrow Sp { l }

FatArrow :: Loc
FatArrow <- '=>' { loc _span }

EqS :: Loc
EqS <- l:S<'='> !('=' / '>') Sp { l }

DColonS :: Loc
DColonS <- l:S<'::'> Sp { l }

ColonS :: Loc
ColonS <- l:S<':'> !':' Sp { l }

QuestionS :: Loc
QuestionS <- l:S<'?'> Sp { l }

ArrowS :: Loc
ArrowS <- l:S<'->'> Sp { l }

MinusS :: Loc
MinusS <- l:S<'-'> !('-' / '>') Sp { l }

WildS :: Loc
WildS <- l:S<'_'> !IdChar Sp { l }

OrOpS :: Loc
OrOpS <- l:S<'||'> Sp { l }

AndOpS :: Loc
AndOpS <- l:S<'&&'> Sp { l }

AppendOpS :: Loc
AppendOpS <- l:S<'++'> Sp { l }

PowOpS :: Loc
PowOpS <- l:S<'**'> Sp { l }

# --- white space

Sp :: ()
Sp <- (Ws / Nl / Comment)* { () }

Ws :: ()
Ws <- [ \t]+ { () }

Nl :: ()
Nl <- '\n' { () }

Comment :: ()
Comment <- '--' (!'\n' .)* { () }

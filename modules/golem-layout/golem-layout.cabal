cabal-version:      3.0
name:               golem-layout
version:            0.1.0
synopsis:           layout engine for Golem
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple
extra-source-files:
  data/hyphenation/*.txt
  test/data/knuth-plass/*

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Golem.Layout.KnuthPlass
                    Golem.Layout.Aki
                    Golem.Layout.CharClass
                    Golem.Layout.Code
                    Golem.Layout.Hyphenation
                    Golem.Layout.Hyphenation.EnUs
                    Golem.Layout.Japanese
                    Golem.Layout.Look
                    Golem.Layout.Orientation
                    Golem.Layout.Paginate
                    Golem.Layout.Ruby
                    Golem.Layout.Sidenotes
                    Golem.Layout.Table
                    Golem.Layout.Wrap
  other-modules:    Golem.Layout.Orientation.Table
  build-depends:
    , base               >=4.20 && <4.21
    , containers         >=0.6  && <0.8
    , golem-doc
    , golem-layout-spec
    , golem-project
    , golem-syntax
    , template-haskell
    , text               >=2.0  && <2.2
  default-language: GHC2021

test-suite golem-layout-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    KnuthPlassReference
                    LineBreakingSpec
                    PaginateSpec
                    PunctuationSpec
  build-depends:
    , base
    , containers
    , golem-doc
    , golem-layout
    , golem-project
    , golem-syntax
    , hedgehog       >=1.4 && <1.6
    , tasty          >=1.4 && <1.6
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , text
  default-language: GHC2021

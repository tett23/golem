cabal-version:      3.0
name:               golem-layout
version:            0.1.0
synopsis:           layout engine for Golem
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple
extra-source-files:
  data/hyphenation/*.txt
  test/data/knuth-plass/*.log
  test/data/knuth-plass/*.md
  test/data/knuth-plass/*.tex
  test/data/knuth-plass/*.words
  test/golden/*.tsv

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns -Werror
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Golem.Layout.KnuthPlass
                    Golem.Layout.Align
                    Golem.Layout.Aki
                    Golem.Layout.CharClass
                    Golem.Layout.Code
                    Golem.Layout.Hyphenation
                    Golem.Layout.Hyphenation.EnUs
                    Golem.Layout.Hyphenation.Languages
                    Golem.Layout.Japanese
                    Golem.Layout.Look
                    Golem.Layout.Orientation
                    Golem.Layout.PageLabel
                    Golem.Layout.Paginate
                    Golem.Layout.Paginate.State
                    Golem.Layout.Ruby
                    Golem.Layout.RuleArea
                    Golem.Layout.Sidenotes
                    Golem.Layout.Table
                    Golem.Layout.Wrap
  other-modules:    Golem.Layout.Orientation.Table
                    Golem.Layout.Paginate.Decide
                    Golem.Layout.Paginate.Types
  build-depends:
    , base               >=4.20 && <4.21
    , containers         >=0.6  && <0.8
    , golem-doc
    , golem-length
    , golem-numerals
    , golem-project
    , golem-syntax
    , template-haskell
    , text               >=2.0  && <2.2
  default-language: GHC2021

test-suite golem-layout-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  -- the invariants on every small input are checked on every processor
  -- (docs/adr/0208): -threaded, and the parallel GC off with a larger
  -- allocation area, without which the processors share less of the work
  ghc-options:      -threaded "-with-rtsopts=-N -qg -A64m"
  other-modules:    AkiTableSpec
                    AlignSpec
                    CharClassSpec
                    CodeJapaneseSpec
                    CodeSpaceSpec
                    CodeStopSpec
                    CombiningSpec
                    DoubleDashSpec
                    ExceptionsSpec
                    ExpansionStepSpec
                    FeaturesSpec
                    ScriptSpec
                    Fixtures
                    InseparableSpec
                    KnuthPlassBrute
                    KnuthPlassReference
                    LineBreakEnum
                    LineBreakInvariants
                    LineBreakInvariantsSpec
                    LineBreakingSpec
                    NoBreakEnum
                    SoftHyphenSpec
                    OverflowSpec
                    PaginateEnum
                    PaginateInvariants
                    PaginateInvariantsSpec
                    PaginateSpec
                    PunctuationSpec
                    RuleAreaSpec
                    LangSpec
                    LinkSpec
                    StructureSpec
                    TableCaptionSpec
                    UrlBreakSpec
  build-depends:
    , base
    , bytestring
    , containers
    , golem-doc
    , golem-layout
    , golem-length
    , golem-project
    , golem-syntax
    , golem-test-support
    , hedgehog       >=1.4 && <1.6
    , tasty          >=1.4 && <1.6
    , tasty-golden   >=2.3 && <2.4
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , text
  default-language: GHC2021

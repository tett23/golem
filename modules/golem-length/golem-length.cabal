cabal-version:      3.0
name:               golem-length
version:            0.1.0
synopsis:           Lengths in sp and the conversions of their units for Golem
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

-- depends on no golem package (docs/adr ADR 0114)
library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Golem.Length
    Golem.Length.Decimal
  build-depends:
    , base  >=4.20 && <4.21
    , text  >=2.0  && <2.2
  default-language: GHC2021

test-suite golem-length-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    LengthSpec
  build-depends:
    , base
    , golem-length
    , hedgehog       >=1.4 && <1.6
    , tasty          >=1.4 && <1.6
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , text
  default-language: GHC2021

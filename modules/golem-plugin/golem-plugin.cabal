cabal-version:      3.0
name:               golem-plugin
version:            0.1.0
synopsis:           wasm plugin host for Golem (wasmtime)
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple
extra-source-files:
  cbits/*.h
  test/plugins/*.wat

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Golem.Plugin
                    Golem.Plugin.Lock
  build-depends:
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , cborg         >=0.2  && <0.3
    , containers    >=0.6  && <0.8
    , crypton-x509-store  >=1.8 && <1.9
    , crypton-x509-system >=1.8 && <1.9
    , golem-doc
    , directory       >=1.3  && <1.4
    , filepath        >=1.4  && <1.6
    , golem-eval
    , golem-project
    , golem-syntax
    , http-client     >=0.7  && <0.8
    , http-client-tls >=0.3  && <0.4
    , http-types      >=0.12 && <0.13
    , text          >=2.0  && <2.2
    , toml-parser
  default-language: GHC2021
  -- the wasmtime 49.0.2 C API, linked statically. scripts/fetch-wasmtime.sh
  -- puts it in third_party/wasmtime and writes its absolute paths into
  -- cabal.project.local (extra-include-dirs, extra-lib-dirs).
  include-dirs:     cbits
  c-sources:        cbits/golem_plugin.c
  cc-options:       -O2
  extra-libraries:  wasmtime
  if os(darwin)
    frameworks:     CoreFoundation
  else
    extra-libraries: pthread dl m

test-suite golem-plugin-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  ghc-options:      -threaded
  build-depends:
    , async
    , base
    , bytestring
    , cborg
    , crypton-connection
    , data-default
    , http-client
    , http-client-tls
    , http-types
    , network
    , process
    , wai
    , warp
    , warp-tls
    , containers
    , directory
    , golem-doc
    , golem-eval
    , golem-parser
    , golem-plugin
    , golem-syntax
    , tasty          >=1.4 && <1.6
    , tasty-hunit    >=0.10 && <0.11
    , temporary
    , text
  default-language: GHC2021

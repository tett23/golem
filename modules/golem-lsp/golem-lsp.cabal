cabal-version:      3.0
name:               golem-lsp
version:            0.1.0
synopsis:           language server for Golem
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Golem.Lsp.Workspace
                    Golem.Lsp.Features
                    Golem.Lsp.Server
  build-depends:
    , aeson         >=2.0  && <2.3
    , base          >=4.20 && <4.21
    , co-log-core   >=0.3  && <0.4
    , containers    >=0.6  && <0.8
    , directory     >=1.3  && <1.4
    , filepath      >=1.4  && <1.6
    , golem-doc
    , golem-driver
    , golem-eval
    , golem-fmt
    , golem-lint
    , golem-parser
    , golem-project
    , golem-syntax
    , bytestring    >=0.11 && <0.13
    , lsp           >=2.7  && <2.9
    , lsp-types     >=2.3  && <2.5
    , prettyprinter >=1.7  && <1.8
    , stm
    , text          >=2.0  && <2.2
  default-language: GHC2021

test-suite golem-lsp-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    EditingSpec
  -- -N: one capability per processor from the start, so that the count
  -- never changes while the suite runs (scripts/ci/rts-capabilities.sh)
  ghc-options:      -threaded "-with-rtsopts=-N"
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , golem-driver
    , golem-lsp
    , golem-syntax
    , hedgehog       >=1.4 && <1.6
    , lsp
    , lsp-test       >=0.17 && <0.19
    , lsp-types
    , process
    , tasty          >=1.4 && <1.6
    , tasty-golden   >=2.3 && <2.4
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , temporary
    , text
  default-language: GHC2021

cabal-version:      3.0
name:               golem-wasm
version:            0.1.0
synopsis:           The PDF of Golem as a wasm reactor module that reads no file
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns -Werror
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

-- the frames of the input and the result (docs/adr/0199): pure, built and
-- tested natively too
library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Golem.Wasm.Frame
  build-depends:
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
  default-language: GHC2021

-- the reactor module (docs/adr/0199), built for wasm32 only, by
-- cabal.project.wasm: the exports of the C ABI and hs_init, no main, one
-- thread
executable golem-wasm
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:
    -no-hs-main -optl-mexec-model=reactor
    "-optl-Wl,--export=hs_init,--export=golem_alloc,--export=golem_free,--export=golem_build_pdf,--export=golem_result_len,--export=golem_version"
  build-depends:
    , base
    , bytestring
    , containers    >=0.6  && <0.8
    , golem-driver
    , golem-syntax
    , golem-wasm
    , text          >=2.0  && <2.2
  default-language: GHC2021
  if !arch(wasm32)
    buildable: False

test-suite golem-wasm-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , base
    , bytestring
    , golem-wasm
    , golem-test-support
    , hedgehog       >=1.4 && <1.6
    , tasty          >=1.4 && <1.6
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
  default-language: GHC2021

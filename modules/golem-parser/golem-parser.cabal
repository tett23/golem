cabal-version:      3.0
name:               golem-parser
version:            0.1.0
synopsis:           Golem parser: lossless CST, grammar and AST
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Golem.Parser
    Golem.Parser.AST
    Golem.Parser.CST
    Golem.Parser.Convert
    Golem.Parser.Lower
    Golem.Parser.Generated
    Golem.Parser.Read
    Golem.Parser.SourceSettings
  build-depends:
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , containers    >=0.6  && <0.8
    , golem-syntax
    , peg-runtime   >=0.1  && <0.2
    , text          >=2.0  && <2.2
  default-language: GHC2021
  -- The generated module is not ours to warn about.
  ghc-options: -Wno-unused-matches -Wno-unused-local-binds -Wno-name-shadowing -Wno-unused-imports

test-suite golem-parser-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    CSTSpec ParserSpec LowerSpec LabelSafetySpec SourceSettingsSpec SplatEscapeSpec StrippedGrammar
  build-depends:
    , base
    , bytestring
    , directory
    , filepath
    , golem-parser
    , golem-syntax
    , hedgehog       >=1.4 && <1.6
    , tasty          >=1.4 && <1.6
    , tasty-hedgehog >=1.4 && <1.5
    , tasty-hunit    >=0.10 && <0.11
    , peg-runtime
    , text
  default-language: GHC2021
  -- StrippedGrammar is generated, like Golem.Parser.Generated
  ghc-options: -Wno-unused-matches -Wno-unused-local-binds -Wno-name-shadowing -Wno-unused-imports
  -- tasty runs the parts of the label safety test in parallel (docs/adr/0009)
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N"

cabal-version:      3.0
name:               golem-regex
version:            0.1.0
synopsis:           The regular expressions of Golem's regex styles
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Werror=incomplete-patterns
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  Golem.Regex
  build-depends:
    , array         >=0.5  && <0.6
    , base          >=4.20 && <4.21
    , containers    >=0.6  && <0.8
    , text          >=2.0  && <2.2
  default-language: GHC2021

test-suite golem-regex-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    Suites
  build-depends:
    , base
    , golem-regex
    , tasty          >=1.4 && <1.6
    , tasty-hunit    >=0.10 && <0.11
    , text
  default-language: GHC2021

cabal-version:      3.0
name:               golem-project
version:            0.1.0
synopsis:           Golem projects: manifest, style.toml and the import graph
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Golem.Project
    Golem.Project.Imports
    Golem.Project.Manifest
    Golem.Project.Paths
    Golem.Project.Style
    Golem.Project.TomlMessage
  build-depends:
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , containers    >=0.6  && <0.8
    , directory     >=1.3  && <1.4
    , filepath      >=1.4  && <1.6
    , golem-doc
    , golem-parser
    , golem-regex
    , golem-syntax
    , text          >=2.0  && <2.2
    , time          >=1.12 && <1.15
    , toml-parser   >=2.0  && <2.1
  default-language: GHC2021

test-suite golem-project-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    TomlMessageSpec
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , golem-doc
    , golem-parser
    , golem-project
    , golem-syntax
    , tasty          >=1.4 && <1.6
    , tasty-hunit    >=0.10 && <0.11
    , temporary      >=1.3 && <1.4
    , text
    , toml-parser
  default-language: GHC2021

cabal-version:      3.0
name:               golem-fixtures
version:            0.1.0
synopsis:           Converters of the public-domain texts of the test fixtures
description:
  Converts the texts that scripts/fixtures/fetch-public-domain.sh downloads
  into Golem source (docs/adr/0023). Not part of the release archives.
license:            MIT
author:             tett23
maintainer:         tett23@gmail.com
category:           Text
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints
  default-extensions: DerivingStrategies LambdaCase OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Golem.Fixtures
    Golem.Fixtures.Aozora
    Golem.Fixtures.Gutenberg
    Golem.Fixtures.Python
  build-depends:
    , base          >=4.20 && <4.21
    , bytestring    >=0.11 && <0.13
    , containers    >=0.6  && <0.8
    , text          >=2.0  && <2.2
  default-language: GHC2021

executable golem-fixtures
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base
    , bytestring
    , golem-fixtures
  default-language: GHC2021

test-suite golem-fixtures-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , base
    , bytestring
    , golem-fixtures
    , tasty          >=1.4 && <1.6
    , tasty-hunit    >=0.10 && <0.11
    , text
  default-language: GHC2021

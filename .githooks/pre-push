#!/bin/sh
# A change of the specification or of CONTRIBUTING on a branch must update a
# manual too (docs/adr/0024-manual-audiences-and-policy.md). For each branch that is
# pushed, it checks the commits from the merge base with origin/main to the
# pushed tip with scripts/manual/check-updated.sh. Pushes to main and the
# deletion of a branch are not checked. It does not fetch origin/main: if it
# stops a push for changes that main already has, run git fetch and push
# again.
set -eu
CHECK=$(cd "$(dirname "$0")/.." && pwd)/scripts/manual/check-updated.sh
ZERO=0000000000000000000000000000000000000000
CODE=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" != "$ZERO" ] || continue
  [ "$remote_ref" != refs/heads/main ] || continue
  if ! git rev-parse -q --verify refs/remotes/origin/main >/dev/null; then
    echo "pre-push: no origin/main; the manual is not checked (git fetch origin main)" >&2
    continue
  fi
  sh "$CHECK" refs/remotes/origin/main "$local_sha" || CODE=1
done
exit "$CODE"

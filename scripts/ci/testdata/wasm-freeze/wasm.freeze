-- the boot packages (base, text, time) are not here; cborg, skylighting
-- and skylighting-core differ and are not compared
active-repositories: hackage.haskell.org:merge
index-state: hackage.haskell.org 2026-10-11T15:10:52Z
constraints: any.aeson ==2.2.5.1,
             aeson +ordered-keymap,
             any.cborg ==0.2.11.0,
             any.skylighting ==0.14,
             any.skylighting-core ==0.14.9,
             any.zlib ==0.7.1.1,
             zlib +bundled-c-zlib +non-blocking-ffi +pkg-config,
             any.zlib-clib ==1.3.2
